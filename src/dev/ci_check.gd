## Animals far from the child are stepped every second or fourth frame, with
## the time they missed, so they walk just as far. Every animal stepped every
## frame cost half a frame on the phone and made riding through the valley jerky.
func _check_far_animals_are_stepped_less_often_and_walk_as_far() -> void:
	print("far animals are stepped less often and walk as far")
	var field := HeightField.new(20260903)
	var near := Animals.new(field, 20260903)
	var far := Animals.new(field, 20260903)
	get_root().add_child(near)
	get_root().add_child(far)
	var spot := field.find_spawn_point()
	var a := near.put_one_at(AnimalKinds.SHEEP, spot)
	var b := far.put_one_at(AnimalKinds.SHEEP, spot)
	for animal: Dictionary in [a, b]:
		animal["target"] = spot + Vector3(6.0, 0.0, 0.0)
		animal["target"].y = field.height_at(spot.x + 6.0, spot.z)
		animal["rest"] = 1000.0
	near.follow(spot)
	far.follow(spot + Vector3(0.0, 0.0, 200.0))
	_expect(near._step_every(a) == 1, "an animal beside the child is stepped every frame")
	_expect(far._step_every(b) == 4, "one two hundred metres off every fourth (%d)" % far._step_every(b))
	for _frame in 120:
		near._tick(1.0 / 60.0)
		far._tick(1.0 / 60.0)
	var walked_near := (a["node"] as Node3D).position.distance_to(spot)
	var walked_far := (b["node"] as Node3D).position.distance_to(spot)
	_expect(walked_near > 1.0, "the near one walks (%.2f m)" % walked_near)
	_expect(
		absf(walked_near - walked_far) < 0.35,
		"and the far one as far in the same time (%.2f m against %.2f m)" % [walked_far, walked_near]
	)
	near.queue_free()
	far.queue_free()

## The carousel was redrawn with prancing horses, a pig, a rooster, swans, a
## scalloped canopy, a painted drum and handrailed ramps. All of that is paint
## over the same few solid things, and this holds the paint to them: nothing of
## an animal below its saddle is drawn outside its barrel, the drum's paint is
## inside its collider, the handrails are solid, the lap belt lies low and thin,
## and a child standing on the deck does not meet the valance.
func _check_the_carousel_is_drawn_inside_what_is_collided() -> void:
	print("the carousel's animals, drum and rails are drawn inside what is collided")
	var carousel := Carousel.new(Vector3.ZERO)
	get_root().add_child(carousel)
	var kinds := {}
	for kind in Carousel.KINDS:
		kinds[kind] = int(kinds.get(kind, 0)) + 1
	_expect(
		kinds.get(&"horse", 0) >= 4 and kinds.has(&"pig") and kinds.has(&"rooster") and kinds.has(&"swan"),
		"there are horses, a pig, a rooster and a swan chariot to choose from"
	)
	var webbing_top := -INF
	for horse in Carousel.HORSES:
		var barrel: CollisionShape3D = carousel._barrels[horse]
		var box := barrel.shape as BoxShape3D
		var drawn := carousel.get_node("Turntable/Animal%d" % horse) as MeshInstance3D
		var arrays := drawn.mesh.surface_get_arrays(0)
		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var colours: PackedColorArray = arrays[Mesh.ARRAY_COLOR]
		var out_by := 0.0
		for index in vertices.size():
			var local := barrel.transform.affine_inverse() * vertices[index]
			# The head and the swan's neck rise above the saddle, where nothing a
			# child does reaches; the rest is held to the barrel's own box.
			if local.y > box.size.y * 0.5:
				if _colour_near(colours[index], Carousel.WEBBING):
					webbing_top = maxf(webbing_top, vertices[index].y - Carousel.SADDLE_TOP)
				continue
			if _colour_near(colours[index], Carousel.WEBBING):
				webbing_top = maxf(webbing_top, vertices[index].y - Carousel.SADDLE_TOP)
			out_by = maxf(out_by, absf(local.x) - box.size.x * 0.5)
			out_by = maxf(out_by, absf(local.z) - box.size.z * 0.5)
			out_by = maxf(out_by, -local.y - box.size.y * 0.5)
		_expect(
			out_by < 0.11,
			"%s %d is drawn within its barrel below the saddle (out by %.2f m)" % [Carousel.KINDS[horse], horse, out_by]
		)
	_expect(webbing_top > 0.0 and webbing_top < 0.16, "the lap belt lies on the lap, %.2f m over the saddle, not a bar across the child" % webbing_top)

	# The drum's paint, bands and frames never stand further out than its collider.
	var turning := carousel.get_node("Turntable/Turning") as MeshInstance3D
	var turning_arrays := turning.mesh.surface_get_arrays(0)
	var turning_vertices: PackedVector3Array = turning_arrays[Mesh.ARRAY_VERTEX]
	var base := Carousel.FLOOR_HEIGHT + Carousel.DECK_THICKNESS * 0.5
	var drum_reach := 0.0
	var lowest_valance := INF
	for point in turning_vertices:
		var flat := Vector2(point.x, point.z).length()
		if flat < 1.5 and point.y > base + 0.001 and point.y < base + Carousel.DRUM_HEIGHT - 0.001:
			drum_reach = maxf(drum_reach, flat)
		if flat > Carousel.RADIUS and point.y > base + 1.0:
			lowest_valance = minf(lowest_valance, point.y)
	var drum_solid := 0.0
	for shape in carousel.get_node("Floor").get_children():
		var cylinder := (shape as CollisionShape3D).shape as CylinderShape3D
		if cylinder != null and cylinder.radius > 0.9 and cylinder.radius < 1.5:
			drum_solid = cylinder.radius
	_expect(drum_reach <= drum_solid + 0.001, "the drum's paint reaches %.3f m and its collider %.3f m" % [drum_reach, drum_solid])
	_expect(
		lowest_valance > base + Player.HEIGHT + 0.5,
		"the valance hangs %.2f m over the deck, clear of a child's head" % (lowest_valance - base)
	)

	# The handrails are solid: a wall along each side of each of the four ramps,
	# as tall as the rails, and not across the way up.
	var walls := 0
	for shape in carousel.get_node("Floor").get_children():
		var wall := (shape as CollisionShape3D).shape as BoxShape3D
		if wall != null and wall.size.y > Carousel.RAIL_HEIGHT and wall.size.z < 0.2 and wall.size.x > 1.0:
			walls += 1
			var ramp_at := Vector2((shape as CollisionShape3D).position.x, (shape as CollisionShape3D).position.z)
			_expect(ramp_at.length() > Carousel.RADIUS, "a handrail stands out on its ramp, not on the deck")
	_expect(walls == 8, "two solid handrails to each of the four ramps (%d)" % walls)
	carousel.queue_free()

## The top of the pony's seat as it is drawn: the highest point of its body mesh
## on the middle line under the child, which is the saddle's.
func _top_of_the_ponys_seat() -> float:
	var top := -1e9
	for point: Vector3 in (MountKinds.horse_part("body") as ArrayMesh).surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
		if absf(point.x) < 0.04 and point.z > 0.0 and point.z < 0.08:
			top = maxf(top, point.y)
	return top

## How far out the pony's barrel goes, one side.
func _the_barrels_half_width() -> float:
	var natural := SurfaceTool.new()
	natural.begin(Mesh.PRIMITIVE_TRIANGLES)
	HorseNatural.body(natural, MountKinds.colour(MountKinds.HORSE))
	return natural.commit().get_aabb().size.x * 0.5

## The horse is a child's pony and not a hunter: its saddle is about where a
## child's own shoulder is, its withers a little over a metre, and a child
## sits on it the way a rider does — thighs over the skirts, lower legs
## hanging down the barrel with the feet in the irons, the back upright and the
## hands low in front holding reins that sag between the bit and them — with
## no part of them inside the horse, at a walk and at a canter. It strides
## faster than the horse it replaced, and costs no more to draw.
func _check_the_pony_is_a_childs_size_and_its_rider_sits_like_a_rider() -> void:
	print("the pony is a child's size and its rider sits like a rider")
	var hide := MountKinds.colour(MountKinds.HORSE)
	var seat_top := _top_of_the_ponys_seat()
	_expect(absf(seat_top - MountKinds.HORSE_SADDLE_Y) < 0.01, "the seat is drawn at %.3f m, the height a rider is lifted to (%.3f)" % [seat_top, MountKinds.HORSE_SADDLE_Y])
	# The withers are the highest point of the bare barrel: the saddle's own
	# pommel and cantle stand above them.
	var natural := SurfaceTool.new()
	natural.begin(Mesh.PRIMITIVE_TRIANGLES)
	HorseNatural.body(natural, hide)
	var barrel := natural.commit() as ArrayMesh
	var withers := barrel.get_aabb().end.y
	_expect(withers > 1.1 and withers < 1.3, "the withers are %.2f m up, a pony's" % withers)

	# The saddle against the child standing beside it: at about their
	# shoulder, not over their head.
	for which in Character.KEYS.size():
		if not Character.is_rigged(which):
			continue
		var standing := Node3D.new()
		get_root().add_child(standing)
		var stood := Character.build(which, 1, 1, Visitors.SHIRTS[2])
		standing.add_child(stood)
		var shoulder := _in_rig(stood.find_child("UpperArmL", true, false), stood).y
		_expect(
			MountKinds.HORSE_SADDLE_Y > 0.9 * shoulder and MountKinds.HORSE_SADDLE_Y < 1.7 * shoulder,
			"%s: the seat is %.2f m up against a shoulder at %.2f" % [Character.KEYS[which], MountKinds.HORSE_SADDLE_Y, shoulder]
		)
		standing.queue_free()

	# The rider, walking and at a full canter.
	var neck := MountKinds.horse_part("head") as ArrayMesh
	var lifted := Vector3(0.0, MountKinds.HORSE_SADDLE_Y, 0.0)
	for gait: float in [0.0, MountKinds.speed(MountKinds.HORSE)]:
		for which in Character.KEYS.size():
			if not Character.is_rigged(which):
				continue
			var made := _seated(which, MountKinds.HORSE, gait)
			var rig: Node3D = made[0]
			var who := "%s at %.1f m/s" % [Character.KEYS[which], gait]
			var inside := 0
			var worst_foot := 0.0
			var worst_hand := 0.0
			for side in 2:
				var tag := "L" if side == 0 else "R"
				var mirror := -1.0 if side == 0 else 1.0
				var hip := _in_rig(rig.find_child("Thigh" + tag, true, false), rig)
				var knee := _in_rig(rig.find_child("Shin" + tag, true, false), rig)
				var ankle := _in_rig(rig.find_child("Foot" + tag, true, false), rig)
				var hand := _in_rig(rig.find_child("Hand" + tag, true, false), rig)
				worst_foot = maxf(worst_foot, (ankle + lifted - MountKinds.horse_stirrup(mirror)).length())
				worst_hand = maxf(worst_hand, (hand + lifted - MountKinds.horse_rein_hand(mirror)).length())
				# Along each bone of the leg, from the hip to the knee and from
				# the knee to the ankle.
				for step in 6:
					var along := float(step) / 5.0
					for point: Vector3 in [hip.lerp(knee, along) + lifted, knee.lerp(ankle, along) + lifted]:
						if _point_in_mesh(barrel, Vector3.ZERO, point) or _point_in_mesh(neck, MountKinds.HORSE_HEAD_PIVOT, point):
							inside += 1
			_expect(worst_foot < 0.08, "%s: the feet are %.3f m from the stirrups" % [who, worst_foot])
			_expect(worst_hand < 0.11, "%s: the hands are %.3f m from the reins' ends" % [who, worst_hand])
			_expect(inside == 0, "%s: %d points along the legs are inside the horse" % [who, inside])
			# Upright at a walk, a little forward at a canter, and never lying
			# down on the neck (the clay toy, whose arms are too short for the
			# reins, is allowed to lean to reach them).
			var torso := rig.find_child("Torso", true, false) as Node3D
			var lean := -torso.rotation.x
			if which != 0:
				_expect(lean < (0.35 if gait == 0.0 else 0.5), "%s: the back is tipped %.2f rad" % [who, lean])
			if gait > 0.0 and which != 0:
				_expect(lean > 0.15, "%s: leaning forward a little at a canter (%.2f rad)" % [who, lean])
			(made[2] as Node3D).queue_free()

	# The reins sag: the lowest point of each is below the straight line from
	# the bit to the hand, and none of it is inside the neck.
	for side: float in [-1.0, 1.0]:
		var way := MountKinds.horse_rein_way(side)
		var lowest := 0.0
		for corner in way.size():
			var straight := way[0].lerp(way[way.size() - 1], (way[corner].z - way[0].z) / (way[way.size() - 1].z - way[0].z))
			lowest = maxf(lowest, straight.y - way[corner].y)
		_expect(lowest > 0.04 and way.size() >= 5, "the rein hangs %.2f m below a straight line in %d segments" % [lowest, way.size() - 1])

	# A bridle: a browband and a noseband in leather on the head.
	var leather := 0
	for colour: Color in neck.surface_get_arrays(0)[Mesh.ARRAY_COLOR]:
		if absf(colour.r - 0.30) < 0.01 and absf(colour.g - 0.18) < 0.01 and absf(colour.b - 0.10) < 0.01:
			leather += 1
	_expect(leather > 40, "the head wears a bridle (%d leather vertices)" % leather)

	# At full speed its feet go round faster than the big horse's did (a stride
	# of 2.6 m, 1.7 times that at a gallop), at every pace.
	for pace: float in [1.5, 4.7, MountKinds.speed(MountKinds.HORSE)]:
		var old_stride := lerpf(2.6, 2.6 * 1.7, Mounts.gallop_of(pace))
		_expect(pace / Mounts.stride_metres(pace) > pace / old_stride, "at %.1f m/s it takes %.2f strides a second, not %.2f" % [pace, pace / Mounts.stride_metres(pace), pace / old_stride])
	var top_pace := MountKinds.speed(MountKinds.HORSE)
	_expect(top_pace / Mounts.stride_metres(top_pace) > 1.25 * top_pace / (2.6 * 1.7), "and a full canter is clearly quicker (%.2f against %.2f a second)" % [top_pace / Mounts.stride_metres(top_pace), top_pace / (2.6 * 1.7)])

	# It is no dearer to draw than it was: eight nodes and 1,808 triangles.
	var steed := MountKinds.build_node(MountKinds.HORSE)
	var nodes := 0
	var triangles := 0
	var stack: Array[Node] = [steed]
	while not stack.is_empty():
		var part: Node = stack.pop_back()
		stack.append_array(part.get_children())
		if part is MeshInstance3D:
			nodes += 1
			triangles += _triangle_count((part as MeshInstance3D).mesh)
	_expect(nodes <= 8, "the pony is %d mesh nodes" % nodes)
	_expect(triangles <= 1808, "and %d triangles" % triangles)
	steed.free()

	# A swimming pony floats where it stops wading, with its back clear.
	_expect(is_equal_approx(MountKinds.HORSE_SWIMS_AT, MountKinds.HORSE_DRAUGHT), "it begins to swim at the depth it floats at, so it is not put up or down there")
	_expect(MountKinds.HORSE_SADDLE_Y - MountKinds.HORSE_DRAUGHT > 0.3, "and its rider sits %.2f m above the water" % (MountKinds.HORSE_SADDLE_Y - MountKinds.HORSE_DRAUGHT))

	# The horses in the valley are this pony, with legs to swing.
	var field := HeightField.new(20260903)
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	mounts.place(MountKinds.horse_id(3), field.camp_centre() + Vector3(4.0, 0.0, 0.0))
	var free_body := mounts.node_of(MountKinds.horse_id(3)).get_node("Body") as MeshInstance3D
	_expect(free_body.mesh == MountKinds.horse_part("body", MountKinds.colour(MountKinds.horse_id(3))), "a horse in the valley wears the pony's body")
	_expect(free_body.get_node_or_null("Leg3") != null and free_body.get_node_or_null("Head") != null, "and has its head and legs")
	mounts.queue_free()

## The wander keeps sheep and cows off the pitch, but a child standing on it, a
## whistle or a motorcycle named the spot for them instead, and nothing there
## asked whether the animal belonged. A sheep just outside the apron, with the
## child a few steps inside it, must not be sent in; a dog may be.
func _check_nothing_sends_livestock_onto_the_pitch() -> void:
	print("nothing sends livestock onto the pitch")
	var field := HeightField.new(20260903)
	var animals := Animals.new(field, 20260903)
	get_root().add_child(animals)
	var edge := Pitch.CENTRE + Vector3(Pitch.HALF_LENGTH + Pitch.APRON, 0.0, 0.0)
	var child := edge - Vector3(2.0, 0.0, 0.0)
	var outside := edge + Vector3(3.0, 0.0, 0.0)
	_expect(not animals.kept_for_people(outside.x, outside.z), "the sheep's spot is not kept ground")
	var meant := {}
	for kind: StringName in [AnimalKinds.SHEEP, AnimalKinds.COW, AnimalKinds.DOG]:
		var animal := animals.put_one_at(kind, outside)
		animal["target"] = outside
		animals.call_animals()
		animals.watch(child, Inventory.new())
		var target: Vector3 = animal["target"]
		meant[kind] = animals.kept_for_people(target.x, target.z)
	_expect(not meant[AnimalKinds.SHEEP], "a whistled sheep is not sent onto the pitch")
	_expect(not meant[AnimalKinds.COW], "nor a cow")
	_expect(meant[AnimalKinds.DOG], "but a dog comes to the child where they stand")
	animals.queue_free()

## A house raised on the spot where an animal stands has the animal inside its
## walls, and every feeler it sends out finds them: it stood there for ever.
func _check_an_animal_inside_a_new_building_can_walk_out() -> void:
	print("an animal inside a new building can walk out")
	var field := HeightField.new(20260903)
	var animals := Animals.new(field, 20260903)
	get_root().add_child(animals)
	var spot := field.find_spawn_point()
	spot.y = field.height_at(spot.x, spot.z)
	var block := StaticBody3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(6.0, 1.2, 6.0)
	var collider := CollisionShape3D.new()
	collider.shape = shape
	block.add_child(collider)
	block.collision_layer = TerrainSpec.LAYER_PROPS
	block.position = spot + Vector3(0.0, 0.6, 0.0)
	get_root().add_child(block)
	await physics_frame
	await physics_frame
	var dog := animals.put_one_at(AnimalKinds.DOG, spot)
