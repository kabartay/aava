## The shop audit: a sign a child can see, grass kept off the steps, a shelf and
## panel that fit a 720 px screen in every language, a buy button greyed at the
## limit, and a refused sale that costs nothing.
func _check_the_shop_audit_fixes() -> void:
	print("the shop audit: sign, steps, panel fit, limit greyed, refusals cost nothing")
	# The sign must hang above the porch roof's edge at the wall (centre height
	# 3.0 m, 0.08 m half-thickness, 1.4 m half-depth tilted 8 degrees), and
	# under the eave.
	var roof_edge := 3.0 + 0.08 + 1.4 * tan(deg_to_rad(8.0))
	_expect(
		Places.SHOP_SIGN_Y - Places.SHOP_SIGN_HEIGHT * 0.5 > roof_edge,
		"the shop's sign hangs clear above the porch roof (%.2f m, roof edge %.2f m)" % [
			Places.SHOP_SIGN_Y - Places.SHOP_SIGN_HEIGHT * 0.5, roof_edge
		]
	)
	_expect(
		Places.SHOP_SIGN_Y + Places.SHOP_SIGN_HEIGHT * 0.5 < Places.shop_eave_height(),
		"and below the eave"
	)
	# Grass stays off the stone steps, which reach 3.35 m out from the wall.
	var field := HeightField.new(20260903)
	var camp := field.camp_centre()
	var shop := PlaceSpec.centre_of(&"shop", camp)
	var front_of_shop := shop.z + PlaceSpec.BUILDINGS[&"shop"][2] - Places.SHOP_DEPTH * 0.5
	_expect(
		PlaceSpec.on_floor(shop.x, front_of_shop - 3.3, camp),
		"the foot of the shop's steps counts as floor, so no grass grows through them"
	)
	# The panel, with a sell button showing, is no taller than the screen in any
	# language; and the buy button is greyed for a thing owned to its limit.
	for lang: StringName in [Text.EN, Text.FR, Text.RU]:
		Text.set_language(lang)
		var hud := Hud.new()
		get_root().add_child(hud)
		await process_frame
		hud.set_carried_for_sale(ItemKinds.WOOL, 5)
		hud.set_shop_open(true, 500, {ShopStock.QUAD: 1, ShopStock.BICYCLE: 1})
		hud._shop_tapped(ShopStock.QUAD)
		await process_frame
		_expect(
			hud._shop.get_combined_minimum_size().y <= 720.0,
			"%s: the shop panel with a sell button is %.0f px high, within 720" % [
				lang, hud._shop.get_combined_minimum_size().y
			]
		)
		_expect(hud._shop_buy_button.disabled, "%s: a quad already owned cannot be bought again (button greyed)" % lang)
		hud._shop_tapped(ShopStock.BICYCLE)
		_expect(not hud._shop_buy_button.disabled, "%s: a second bicycle can still be bought" % lang)
		hud._shop_tapped(ShopStock.MOTORCYCLE)
		_expect(not hud._shop_buy_button.disabled, "%s: a motorcycle with 500 coins can be bought" % lang)
		hud.set_shop_open(true, 50, {})
		hud._shop_tapped(ShopStock.BICYCLE)
		_expect(hud._shop_buy_button.disabled, "%s: a bicycle at 50 coins is greyed" % lang)
		hud.queue_free()
		await process_frame
	Text.set_language(Text.EN)
	# A sale refused for a full purse puts nobody off their machine, and a child's
	# own shop says the purse is full rather than that there is nothing to sell.
	var game := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var sell_back := game.substr(game.find("func _on_sell_back("), 2600)
	_expect(
		sell_back.find("sells_back(item) > wallet.room()") >= 0
		and sell_back.find("sells_back(item) > wallet.room()") < sell_back.find("_on_ride()"),
		"a sale into a full purse is refused before the child is put off their machine"
	)
	var at_home := game.substr(game.find("func _sell_at_home("), 900)
	_expect(at_home.contains("say_purse_full"), "a child's own shop says so when the purse is full")
	# And the purse itself: no coins are lost and nothing leaves on a refusal.
	var wallet := Wallet.new()
	wallet.coins = Wallet.MAX_COINS - 10
	wallet.take(ShopStock.MOTORCYCLE)
	_expect(
		wallet.sell_back(ShopStock.MOTORCYCLE, ShopStock.sells_back(ShopStock.MOTORCYCLE)) == 0
		and wallet.has(ShopStock.MOTORCYCLE) and wallet.coins == Wallet.MAX_COINS - 10,
		"a motorcycle is not sold into a purse with room for 10 coins"
	)

## A child who runs with the ball keeps it in front of them for as long as they
## run. The air drag takes a little pace off a rolling ball every tick and the
## push only brings it back to the child's own, so the ball used to creep in at
## about 7 cm a second until it sat inside the child and then behind them: at 4.4 m/s
## the gap was 0.51 m after a second and 0.00 m after nine, at 6.6 m/s it was
## 0.47 m after one and minus 0.29 m after nine.
func _check_a_ball_carried_at_a_run_stays_in_front_of_the_child() -> void:
	print("a ball carried at a run stays in front of the child")
	var made := _football_floor()
	var away: Vector3 = made[1]
	var ball := Ball.new(away)
	get_root().add_child(ball)
	await physics_frame
	for pace: float in [4.4, 6.6]:
		ball.reset_to(away + Vector3(-60.0, 0.0, 0.0))
		await physics_frame
		var child_x := ball.position.x - 3.0
		var closest := 99.0
		for i in 540:
			child_x += pace / 60.0
			await physics_frame
			ball.linear_velocity = Ball.touch_velocity(
				ball.position, ball.linear_velocity, Vector3(child_x, 0.0, away.z), Vector3(pace, 0.0, 0.0), 1.0 / 60.0
			)
			if i > 90:
				closest = minf(closest, ball.position.x - child_x)
		var gap := ball.position.x - child_x
		_expect(closest > 0.45, "at %.1f m/s the ball is never nearer the child than %.2f m (the body alone is 0.34)" % [pace, closest])
		_expect(gap > 0.45 and gap < 0.9, "and after nine seconds it is still %.2f m ahead, not on them" % gap)
	ball.queue_free()
	(made[0] as Node).queue_free()

## A shot at a post or the bar rings off it at any pace, whichever part of the
## stride it arrives at. The continuous collision pass stopped a fast ball at the
## surface and handed the engine a speed it had already cut, so that nine of
## forty head-on shots between 5 and 22 m/s came back at under a third of their
## pace, several at under 1 m/s, and dropped at the post's foot.
func _check_a_hard_shot_rings_off_the_woodwork_whatever_the_phase() -> void:
	print("a hard shot rings off the woodwork whatever the phase")
	var made := _football_floor()
	var away: Vector3 = made[1]
	var mouth := away + Vector3(60.0, 0.0, 0.0)
	var goal := Goal.new(1, mouth)
	get_root().add_child(goal)
	var ball := Ball.new(mouth + Vector3(-5.0, 1.2, 0.0))
	get_root().add_child(ball)
	ball.gravity_scale = 0.0
	var worst := 99.0
	var worst_at := 0.0
	for k: int in [13, 16, 21, 24, 28, 32, 33, 38, 39]:
		var speed := 5.0 + 0.43 * float(k)
		ball.reset_to(mouth)
		await physics_frame
		var start := mouth + Vector3(-3.0 - 0.013 * float(k), 0.0, Pitch.GOAL_WIDTH * 0.5 + 0.08)
		start.y = mouth.y + 1.2
		ball.position = start
		PhysicsServer3D.body_set_state(ball.get_rid(), PhysicsServer3D.BODY_STATE_TRANSFORM, Transform3D(Basis(), start))
		ball.linear_velocity = Vector3(speed, 0.0, 0.0)
		var back := 0.0
		for i in 60:
			await physics_frame
			back = minf(back, ball.linear_velocity.x)
		if -back / speed < worst:
			worst = -back / speed
			worst_at = speed
	_expect(worst > 0.3, "every shot off the post keeps over 0.3 of its pace (worst %.2f, at %.1f m/s)" % [worst, worst_at])
	ball.queue_free()
	goal.queue_free()
	(made[0] as Node).queue_free()

## A ball that comes to rest on top of a goalpost, the bar or the side of the net
## stays there for good, because the net's deadening holds it. It is rolled off
## after two seconds, out past the side of the net and not into it. Measured
## before: a ball dropped on the top of the net's side wall was at rest 10 s later,
## 2.64 m up, still there.
func _check_a_ball_perched_on_the_goal_comes_down() -> void:
	print("a ball perched on the goal comes down")
	var field := HeightField.new(20260903)
	var made := _football_floor(_pitch_spot(field))
	var ground := FootballGround.new(field)
	get_root().add_child(ground)
	var ball: Ball = ground._balls[1]
	var mouth := Pitch.goal_centre(1)
	mouth.y = field.height_at(mouth.x, mouth.z)
	for case: Array in [["the side of the net", Vector3(0.8, 4.0, 3.25)], ["the bar", Vector3(0.0, 4.0, 0.5)]]:
		ground._cooldown = 0.0
		ball.reset_to(mouth + Vector3(0.0, 2.0, 0.0))
		await physics_frame
		var spot: Vector3 = mouth + (case[1] as Vector3)
		ball.position = spot
		PhysicsServer3D.body_set_state(ball.get_rid(), PhysicsServer3D.BODY_STATE_TRANSFORM, Transform3D(Basis(), spot))
		ball.linear_velocity = Vector3.ZERO
		var rested := 0.0
		for i in 120:
			await physics_frame
			if ball.position.y - mouth.y > 2.4 and ball.linear_velocity.length() < 1.0:
				rested += 1.0 / 60.0
		var perched := rested > 0.5
		for i in 360:
			await physics_frame
		var up := ball.position.y - mouth.y
		_expect(perched, "a ball dropped on %s rests there (%.1f s) at first" % [case[0], rested])
		_expect(up < 1.0, "and comes down within seven seconds (%.2f m up)" % up)
		_expect(not Pitch.is_goal(1, ball.position, Ball.RADIUS, mouth.y) and not ground._in_the_net.has(ball), "without scoring")
	ground.queue_free()
	(made[0] as Node).queue_free()

## The line the child sees on the ground is the line the ball takes. The same
## launch velocity feeds the line and the kick, with the close-range blend to the
## way they face, the sprint and the strength all in it; the ring is where the
## ball first comes down, within half a metre, and a drive along the grass is
## drawn to about where it stops.
func _check_the_aim_line_is_where_the_kick_goes() -> void:
	print("the aim line is where the kick goes")
	var made := _football_floor()
	var away: Vector3 = made[1]
	var flat := func(_x: float, _z: float) -> float:
		return 0.0
	var ball := Ball.new(away)
	get_root().add_child(ball)
	await physics_frame
	var east := Vector3.RIGHT
	# name, distance from the foot, bearing of the ball from the foot's facing
	# (degrees), look off the facing (degrees), sprint, strength, loft
	var cases: Array[Array] = [
		["standing, ball a stride ahead", 0.6, 0.0, 0.0, false, 0.7, 0.6],
		["running at it", 0.9, 0.0, 10.0, true, 0.4, 0.5],
		["a step away, to the side, view turned", 0.3, 90.0, 30.0, false, 0.8, 0.5],
		["at the edge of reach, view turned the other way", 1.05, 20.0, -25.0, false, 1.0, 0.4],
		["a tap along the grass", 0.6, 0.0, 0.0, false, 0.0, 0.0],
		["half a swing along the grass", 0.6, 0.0, 0.0, false, 0.5, 0.0],
	]
	for c: Array in cases:
		var striker := away + Vector3(-30.0, 0.0, 0.0)
		var bearing := deg_to_rad(float(c[2]))
		var spot := striker + east.rotated(Vector3.UP, bearing) * float(c[1])
		ball.reset_to(spot)
		await physics_frame
		var look := east.rotated(Vector3.UP, deg_to_rad(float(c[3])))
		var strength := maxf(float(c[5]), Ball.TAP_STRENGTH)
		var launch := Ball.launch_velocity(ball.position, striker, east, bool(c[4]), strength, float(c[6]), look)
		var path := Ball.aim_path(ball.position, launch, ball.effective_linear_damp(), ball.gravity_strength(), flat)
		var end := path[path.size() - 1]
		var heading := Vector2(launch.x, launch.z).normalized()
		var worst_turn := 0.0
		for point in path:
			var off := Vector2(point.x - ball.position.x, point.z - ball.position.z)
			if off.length() > 0.2:
				worst_turn = maxf(worst_turn, rad_to_deg(off.angle_to(heading)))
		_expect(worst_turn < 2.0, "%s: the dots lie along the kick (%.1f degrees at worst)" % [c[0], worst_turn])
		var began := ball.position
		var speed := ball.kick(striker, east, bool(c[4]), strength, float(c[6]), look)
		_expect(speed > 0.0 and ball.linear_velocity.is_equal_approx(launch), "%s: the kick leaves with exactly the velocity the line was drawn from (%.1f m/s)" % [c[0], speed])
		var landed := Vector3.INF
		var high := 0.0
		var rolled := false
		for i in 900:
			await physics_frame
			high = maxf(high, ball.position.y)
			if landed == Vector3.INF and high > Ball.RADIUS + 0.4 and ball.position.y < Ball.RADIUS + 0.03 and ball.linear_velocity.y <= 0.5:
				landed = ball.position
			if i > 10 and ball.linear_velocity.length() < 0.05:
				break
		var away_from := Vector2(end.x - began.x, end.z - began.z).length()
		if landed != Vector3.INF and away_from >= Ball.DRIVE_LANDS_WITHIN:
			var gap := Vector2(landed.x - end.x, landed.z - end.z).length()
			_expect(gap < 0.5, "%s: the ring is %.2f m from where it first lands, %.1f m out" % [c[0], gap, away_from])
		else:
			var stopped := Vector2(ball.position.x - began.x, ball.position.z - began.z).length()
			_expect(absf(stopped - away_from) < maxf(1.0, 0.15 * stopped), "%s: the line runs %.1f m and the ball stops %.1f m out" % [c[0], away_from, stopped])
	ball.queue_free()
	# Nothing is drawn for a ball out of reach: the game asks the ground for the
	# ball at the child's feet, and shows the line only when there is one.
	var field := HeightField.new(20260903)
	var ground := FootballGround.new(field)
	get_root().add_child(ground)
	var near_ball: Ball = ground._balls[1]
	var feet := near_ball.position + Vector3(-0.8, -Ball.RADIUS, 0.0)
	_expect(ground.ball_near(feet) == near_ball, "a child a stride from the ball is offered it")
	_expect(ground.ball_near(feet + Vector3(-5.0, 0.0, 0.0)) == null, "and one five metres off is offered nothing, so nothing is drawn")
	var game := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var frame := game.substr(game.find("func _show_where_it_goes"))
	frame = frame.substr(0, frame.find("\nfunc ", 1))
	var loop := game.substr(game.find("if ball != null and not build_mode.active"), 260)
	_expect(
		loop.contains("not (world.football.has_ball(ball) and world.football.in_the_net(ball))") and loop.contains("_show_where_it_goes(ball)") and loop.contains("else:\n\t\t\tkick_preview.hide_path()"),
		"the line is shown for a ball at the feet, not while building or in the net, and hidden otherwise"
	)
	_expect(frame.contains("_kick_launch(ball, player.kick_charge)"), "and is drawn from the one launch function")
	ground.queue_free()
	(made[0] as Node).queue_free()

## Two children walk onto one stick in the same instant: the host's keeps it and
## the guest's bag is put right quietly. A guest who gives a machine up is set
## beside it, and a parking is told to the other guests only once corrected.
func _check_the_host_arbitrates_a_pickup_a_machine_and_a_parking_two_phones_reach_together() -> void:
	print("the host arbitrates what two phones reach together")
	var field := HeightField.new(20260903)
	var host := Session.new()
	var guest := Session.new()
	host.role = Session.Role.HOSTING
	guest.role = Session.Role.VISITING
	host._link = guest
	guest._link = host
	var host_pickups := Pickups.new(field, 20260903)
	var guest_pickups := Pickups.new(field, 20260903)
	get_root().add_child(host_pickups)
	get_root().add_child(guest_pickups)
	var tile := Vector2i.ZERO
	for step in 40:
		tile = Vector2i(step % 8, step / 8)
		host_pickups._build_tile(tile)
		if host_pickups.count_active() > 0:
			break
	guest_pickups._build_tile(tile)
	var record: Dictionary = host_pickups._active[0]
	var id: String = record["id"]
	var kind: StringName = record["kind"]
	var host_bag := Inventory.new()
	var guest_bag := Inventory.new()
	host_pickups.collected.connect(func(k: StringName, _at: Vector3) -> void: host_bag.add(k, 1))
	guest_pickups.collected.connect(func(k: StringName, _at: Vector3) -> void: guest_bag.add(k, 1))
	host_pickups.taken_here.connect(func(i: String) -> void: host.report_picked(i))
	guest_pickups.taken_here.connect(func(i: String) -> void: guest.report_picked(i))
	host.pickup_is_gone = func(i: String) -> bool: return host_pickups.taken.has(i)
	host.remote_picked.connect(func(i: String) -> void: host_pickups.taken_elsewhere(i))
	guest.remote_picked.connect(func(i: String) -> void: guest_pickups.taken_elsewhere(i))
	guest.pick_refused.connect(func(i: String) -> void:
		var back := guest_pickups.take_back(i)
		if back != &"":
			guest_bag.take_back(back))
	# Both reach it before either has heard of the other: the host's own phone
	# takes it first, then the guest's, whose word reaches the host after.
	host_pickups.check_reach(record["position"])
	guest_pickups.check_reach(record["position"])
	_expect(host_bag.count(kind) >= 1, "the host's child keeps what they reached")
	_expect(guest_bag.count(kind) == 0, "the guest's phone gave the second one back: %d" % guest_bag.count(kind))
	# The common case: only the guest reaches one, and keeps it with no wait.
	var other: Dictionary = {}
	for r: Dictionary in guest_pickups._active:
		other = r
		break
	if not other.is_empty():
		var other_kind: StringName = other["kind"]
		var before := guest_bag.count(other_kind)
		guest_pickups.check_reach(other["position"])
		_expect(guest_bag.count(other_kind) == before + 1, "a pickup nobody else wanted is the guest's at once")
		_expect(host_pickups.taken.has(other["id"]), "and is gone from the host's valley")
		guest_pickups._claims.clear()
		guest._take_pick_refused(Session.HOST_ID, other["id"])
		_expect(
			guest_pickups.take_back(other["id"]) == &"",
			"a refusal for something this phone never took takes nothing"
		)
	_expect(guest_pickups.take_back(id) == &"", "a thing is taken back once only")
	var bag := Inventory.new()
	bag.take_back(&"stick")
	_expect(bag.count(&"stick") == 0, "a bag never goes below nothing")
	var refusals: Array[String] = []
	var stranger := Session.new()
	stranger.role = Session.Role.VISITING
	stranger.pick_refused.connect(func(i: String) -> void: refusals.append(i))
	stranger._take_pick_refused(7, "1:2:3")
	stranger._take_pick_refused(Session.HOST_ID, "../x")
	_expect(refusals.is_empty(), "only the host can refuse, and only by a pickup's own name")
	stranger.queue_free()
	host_pickups.queue_free()
	guest_pickups.queue_free()
	host.queue_free()
	guest.queue_free()
	var net := _code_only(FileAccess.get_file_as_string("res://src/net/session.gd"))
	var relay := net.substr(net.find("func _send_parked"))
	relay = relay.substr(0, relay.find("\n@rpc", 1))
	_expect(
		not relay.contains("rpc_id") and not relay.contains(".rpc("),
		"the host does not pass a guest's raw parking on to the other guests"
	)
	_expect(
		net.contains("_send_parked.rpc_id(HOST_ID,") and net.contains("_send_picked.rpc_id(HOST_ID, id)"),
		"a guest tells the host alone of a parking and a pickup"
	)

	# A guest who yields a machine is set beside it, not on the host's rider.
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	var camp := field.camp_centre()
	# Dry, level ground all round (not the river bank the camp's own offsets are).
	var at := camp + Vector3(-60.0, 0.0, -20.0)
	at.y = field.height_at(at.x, at.z)
	mounts.place(&"horse:0", at)
	mounts.ride_remote(&"horse:0", at, 0.0)
	var beside := mounts.spot_beside(&"horse:0", at, 0.0)
	var apart := Vector2(beside.x - at.x, beside.z - at.z).length()
	_expect(apart >= 1.7, "the guest who gave way stands clear of the host's rider: %.2f m" % apart)
	_expect(mounts.spot_is_clear(&"horse:0", beside), "on clear ground")
	var right := at + Vector3(1.8, 0.0, 0.0)
	mounts.place(&"bicycle:0", right)
	var moved := mounts.spot_beside(&"horse:0", at, 0.0)
	_expect(
		Vector2(moved.x - right.x, moved.z - right.z).length() > 0.5,
		"and not on another machine standing where they would have been put"
	)
	mounts.queue_free()
	var game := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var yield_body := game.substr(game.find("func _follow_their_mount"))
	yield_body = yield_body.substr(0, yield_body.find("\nfunc ", 1))
	_expect(
		yield_body.contains("spot_beside(mount, at, facing)") and yield_body.contains("player.global_position = beside"),
		"the yielding guest is moved beside the machine"
	)
	var parked_body := game.substr(game.find("func _on_remote_parked"))
	parked_body = parked_body.substr(0, parked_body.find("\nfunc ", 1))
	_expect(
		not parked_body.contains("> 0.05") and parked_body.contains("session.report_parked(id, world.mounts.position_of(id)"),
		"the host always tells the corrected parking"
	)

	# Basketballs stay each phone's own: nothing of them crosses the wire.
	var places_src := _code_only(FileAccess.get_file_as_string("res://src/world/places.gd"))
	_expect(
		not places_src.contains("session") and not net.contains("basket"),
		"basketballs and baskets are each phone's own, nothing is sent"
	)
	# Ducks are decoration, and not sent either.
	_expect(not net.to_lower().contains("duck"), "the ducks are not sent between phones")

## The swings stood on bare earth the same brown as their posts, the slide's
## lip hung 0.22 m in the air with nothing under it, its platform's railings
## could be walked through (and the three metres fallen from), and there was
## no sandpit. Now there is soft matting, struts, solid rails and a sand bed.
##
## Everything drawn is asked of the physics world the way a child meets it:
## a ray down onto each surface must land at the height it is drawn, a ray
## across the platform must meet the rail, and a real Player carried down the
## slide must come out of the struts' gap at 30 and 60 frames a second.
func _check_the_playground_surfaces_rails_and_struts_are_solid() -> void:
	print("the playground's surfaces, rails and struts are solid")
	var field := HeightField.new(20260903)
	var places := Places.new(field)
	get_root().add_child(places)
	places.stand_up(field.camp_centre())
	await physics_frame
	var space := get_root().get_world_3d().direct_space_state
	var spot: Vector3 = places._spots[Places.PLAYGROUND]

	var down := func(local: Vector3) -> float:
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(
			spot + local + Vector3(0.0, 2.0, 0.0), spot + local - Vector3(0.0, 2.0, 0.0), TerrainSpec.LAYER_PROPS
		))
		return float(hit["position"].y) - spot.y if not hit.is_empty() else NAN
	for frame_x in Places.SWING_FRAMES:
		var under: float = down.call(Vector3(frame_x + 1.9, 0.0, 1.8))
		_expect(absf(under - Places.MAT_HEIGHT) < 0.01, "the mat under the swings at x=%.1f is stood on at %.3f m, as drawn" % [frame_x, under])
	var run_out: float = down.call(Vector3(Places.SLIDE_FOOT.x, 0.0, Places.SLIDE_FOOT.z + 1.6))
	_expect(absf(run_out - Places.MAT_HEIGHT) < 0.01, "so is the mat where the slide runs out (%.3f m)" % run_out)
	var round_tramp: float = down.call(Places.TRAMPOLINE + Vector3(Places.TRAMPOLINE_RADIUS + 0.4, 0.0, 0.0))
	_expect(absf(round_tramp - Places.MAT_HEIGHT) < 0.01, "and the ring round the trampoline (%.3f m)" % round_tramp)
	var sand: float = down.call(Places.SANDPIT + Vector3(0.9, 0.0, -0.9))
	_expect(absf(sand - Places.SANDPIT_SAND) < 0.01, "the sand is %.3f m deep, as drawn" % sand)
	var board: float = down.call(Places.SANDPIT + Vector3(0.0, 0.0, Places.SANDPIT_HALF + 0.06))
	_expect(absf(board - Places.SANDPIT_BOARD) < 0.01 and board < 0.12, "its boards are %.3f m, low enough to step over" % board)
	var bucket: float = down.call(Places.SANDPIT + Vector3(-0.7, 0.0, 0.5))
	_expect(bucket > Places.SANDPIT_SAND + 0.15, "the bucket is solid (%.3f m)" % bucket)

	# The soft ground is clear of the other equipment, so nothing stands half
	# inside it: the sandpit's square against each circle the pad keeps.
	var clear := true
	var keep: Array[Vector3] = []
	for bench_x in Places.BENCHES:
		keep.append(Vector3(bench_x, 1.2, Places.BENCH_Z))
	for bin_at in Places.BINS:
		keep.append(Vector3(bin_at.x, 0.5, bin_at.z))
	for lamp in Places.LAMPS:
		keep.append(Vector3(lamp.x, 0.45, lamp.z))
	keep.append(Vector3(Places.SLIDE_FOOT.x, 1.3, Places.SLIDE_FOOT.z + 0.9))
	keep.append(Vector3(Places.FOUNTAIN.x, 1.7, Places.FOUNTAIN.z))
	for circle in keep:
		var nearest := Vector2(
			clampf(circle.x, Places.SANDPIT.x - Places.SANDPIT_HALF, Places.SANDPIT.x + Places.SANDPIT_HALF),
			clampf(circle.z, Places.SANDPIT.z - Places.SANDPIT_HALF, Places.SANDPIT.z + Places.SANDPIT_HALF)
		)
		if nearest.distance_to(Vector2(circle.x, circle.z)) < circle.y + 0.3:
			clear = false
	_expect(clear, "the sandpit overlaps no bench, bin, lamp, fountain or the slide's run-out")
	var seat := places.seat_positions()[0]
	_expect(seat.y - spot.y - Places.MAT_HEIGHT > 0.6, "a swing at rest hangs %.2f m clear of the mat" % (seat.y - spot.y - Places.MAT_HEIGHT))

	# The platform's rails are met crossing it, and the struts stand on the ground.
	var platform_at := Vector3(Places.SLIDE_TOP.x, Places.SLIDE_TOP.y + 0.5, Places.SLIDE_TOP.z - 0.65)
	var rail := space.intersect_ray(PhysicsRayQueryParameters3D.create(
		spot + platform_at, spot + platform_at + Vector3(1.5, 0.0, 0.0), TerrainSpec.LAYER_PROPS
	))
	_expect(not rail.is_empty() and absf(float(rail["position"].x) - spot.x - (Places.SLIDE_TOP.x + 0.61)) < 0.03, "a child walking off the side of the platform meets a rail")
	var strut := space.intersect_ray(PhysicsRayQueryParameters3D.create(
		spot + Vector3(Places.SLIDE_FOOT.x + 1.0, 0.1, Places.SLIDE_FOOT.z + Places.SLIDE_STRUT_Z),
		spot + Vector3(Places.SLIDE_FOOT.x, 0.1, Places.SLIDE_FOOT.z + Places.SLIDE_STRUT_Z), TerrainSpec.LAYER_PROPS
	))
	_expect(not strut.is_empty(), "the slide's lip stands on a strut, drawn and solid")

	# And the ride still goes: a real child carried down the slide the way
	# main.gd carries one, with the rails and struts in place, at both rates.
	var ground := StaticBody3D.new()
	ground.collision_layer = TerrainSpec.LAYER_GROUND
	var ground_shape := CollisionShape3D.new()
	var slab := BoxShape3D.new()
	slab.size = Vector3(80.0, 1.0, 80.0)
	ground_shape.shape = slab
	ground_shape.position = spot - Vector3(0.0, 0.5, 0.0)
	ground.add_child(ground_shape)
	get_root().add_child(ground)
	for rate: int in [60, 30]:
		var dt := 1.0 / float(rate)
		var child := Player.new()
		get_root().add_child(child)
		child.global_position = places.slide_top() + Vector3(0.0, 0.05, 0.0)
		await physics_frame
		var top := places.slide_top()
		var foot := places.slide_foot()
		var journey := top.distance_to(foot)
		var along := Vector3(foot.x - top.x, 0.0, foot.z - top.z).normalized()
		var slid := 0.0
		var elapsed := 0.0
		var finished := false
		while elapsed < 12.0 and not finished:
			elapsed += dt
			var pace := minf(Places.SLIDE_SPEED, Places.SLIDE_ACCEL * elapsed)
			if slid > journey:
				pace = Places.SLIDE_SPEED * (1.0 - clampf((slid - journey) / Places.SLIDE_RUN_OUT, 0.0, 1.0))
			slid += pace * dt
			if slid <= journey:
				child.carried_to = top.lerp(foot, slid / journey) + Vector3.UP * 0.06
			else:
				var over := foot + along * minf(slid - journey, Places.SLIDE_RUN_OUT)
				over.y = field.height_at(over.x, over.z)
				child.carried_to = over
			child.is_carried = true
			child._physics_process(dt)
			await physics_frame
			finished = slid > journey and pace < 0.5
		var end := child.global_position - spot
		_expect(finished and absf(end.x - Places.SLIDE_FOOT.x) < 0.1 and end.z > Places.SLIDE_FOOT.z + 0.8,
			"at %d frames a second a child comes down the slide in %.1f s and out between the struts, at z=%.2f" % [rate, elapsed, end.z])
		child.queue_free()
	ground.queue_free()
	places.queue_free()

## The screenshot tool builds its own interface through Wiring.connect_hud, and
## when the snack, lantern and ticket buttons were added it was not told: every
## --player capture printed six red errors. A console that always has errors in
## it hides the one that matters, so the tool must name every handler the real
## wiring asks for.
func _check_the_screenshot_tool_wires_every_handler() -> void:
	print("the screenshot tool supplies every handler Wiring asks for")
	var source := FileAccess.get_file_as_string("res://src/dev/capture.gd")
	var missing := PackedStringArray()
	for handler: StringName in Wiring.HANDLERS:
		if not source.contains('&"%s":' % handler):
			missing.append(String(handler))
	_expect(missing.is_empty(), "capture.gd supplies every handler (missing: %s)" % ", ".join(missing))

## look_at with a view direction parallel to up is undefined and Godot warns
## about it. The rig is built before its spring arm has settled, so for one
## frame the tip can sit straight above or below the aim point; the camera
## must then keep its turn, and must still turn for an ordinary view.
func _check_the_camera_is_not_pointed_straight_up_or_down() -> void:
	print("the camera is not turned straight up or down")
	var player := Player.new()
	get_root().add_child(player)
	var rig := CameraRig.new(player)
	player.add_child(rig)
	await process_frame
	var before := rig.camera.global_transform.basis
	rig.camera.global_position = Vector3(0.0, 10.0, 0.0)
	rig._aim = Vector3.ZERO
	rig._point_camera_at_aim()
	_expect(rig.camera.global_transform.basis.is_equal_approx(before), "a view straight down leaves the camera as it was")
	rig.camera.global_position = Vector3(0.0, 10.0, 10.0)
	rig._point_camera_at_aim()
	_expect(not rig.camera.global_transform.basis.is_equal_approx(before), "an ordinary view still turns the camera")
	player.queue_free()

## The shipped launcher icons are read as the raw files a phone will receive,
## not as imported resources, so the check compares the pixels that really ship.
## Godot prints a warning when that is asked of a res:// path, because the
## raw file is not in an exported build; the real path on disk is not a
## resource path and says nothing, and this only ever runs from the source tree.
func _load_png_file(path: String) -> Image:
	return Image.load_from_file(ProjectSettings.globalize_path(path))

## An arrow in vertical flight is parallel to "up", and looking_at prints a
## warning (718 of them in one run) and chooses a roll at random. It must be
## pointed along its flight all the same, with a sound basis.
func _check_an_arrow_in_vertical_flight_still_points_along_it() -> void:
	print("an arrow in vertical flight points along it")
	var field := HeightField.new(20260903)
	var archery := Archery.new(field)
	get_root().add_child(archery)
	archery.stand_up(Vector3(0.0, 0.0, 0.0), Vector3.FORWARD)
	var arrow: Dictionary = {
		"at": Vector3(0.0, 50.0, 0.0), "velocity": Vector3.UP * 20.0, "age": 0.0,
		"landed": false, "rest": 0.0, "node": archery._build_arrow(),
	}
	archery._arrows.append(arrow)
	archery._physics_process(1.0 / 120.0)
	var node: Node3D = arrow["node"]
	var heading := -node.transform.basis.z
	_expect(heading.dot(Vector3.UP) > 0.999, "it points straight up while it climbs")
	_expect(node.transform.basis.orthonormalized().is_equal_approx(node.transform.basis), "with a sound, unskewed basis")
	archery.queue_free()

## How the wheeled machines are ridden: how they pick up speed, stop, turn and
## lean, measured by driving a real Player over a flat floor with the stick held,
## at 60 and at 30 physics ticks a second, because phones run at both and a
## machine whose braking depended on the tick rate would feel different on every
## one of them.
##
## The numbers it protects were measured before they were changed: the bicycle
## reached nine tenths of its speed in 0.83 s and stopped in 1.05 s from full
## speed (9 m/s squared), which for a three-year-old is a jerk rather than a
## ride; the quad leaned into corners exactly as far as the bicycle did, which
## on four wheels reads as a toy tipping; and the bicycle leaned only 6.5
## degrees at full lock, too little to be seen from the saddle.
func _check_the_wheeled_machines_pull_away_stop_turn_and_lean_as_they_should() -> void:
	print("the wheeled machines pull away, stop, turn and lean as they should")
	var floor_body := StaticBody3D.new()
	var floor_shape := CollisionShape3D.new()
	var slab := BoxShape3D.new()
	slab.size = Vector3(4000.0, 2.0, 4000.0)
	floor_shape.shape = slab
	floor_body.add_child(floor_shape)
	floor_body.position = Vector3(0.0, -1.0, 0.0)
	get_root().add_child(floor_body)
	await process_frame
	var fastest := 0.0
	var results: Dictionary = {}
	for hz: int in [60, 30]:
		Engine.physics_ticks_per_second = hz
		var dt := 1.0 / float(hz)
		for kind: StringName in [MountKinds.BICYCLE, MountKinds.QUAD, MountKinds.MOTORCYCLE]:
			var player := Player.new()
			get_root().add_child(player)
			player.global_position = Vector3(0.0, 0.1, 0.0)
			player.riding = kind
			player.held_at_height = Player.NOT_HELD
			var top := MountKinds.speed(kind)
			# Pulling away with the stick at the rim.
			Input.action_press(InputActions.MOVE_FORWARD)
			var elapsed := 0.0
			var reaches := -1.0
			var peak := 0.0
			for _tick in hz * 6:
				player._physics_process(dt)
				elapsed += dt
				var pace := Vector2(player.velocity.x, player.velocity.z).length()
				peak = maxf(peak, pace)
				if reaches < 0.0 and pace >= 0.9 * top:
					reaches = elapsed
			fastest = maxf(fastest, peak)
			# Braking: the stick pulled back at full speed.
			Input.action_release(InputActions.MOVE_FORWARD)
			Input.action_press(InputActions.MOVE_BACK)
			var heading := Vector3(-sin(player._ride_heading), 0.0, -cos(player._ride_heading))
			var last := Vector3(player.velocity.x, 0.0, player.velocity.z).dot(heading)
			var stopped_in := -1.0
			var stopped_over := 0.0
			var hardest := 0.0
			elapsed = 0.0
			for _tick in hz * 4:
				player._physics_process(dt)
				elapsed += dt
				var along := Vector3(player.velocity.x, 0.0, player.velocity.z).dot(heading)
				if stopped_in < 0.0:
					stopped_over += maxf(along, 0.0) * dt
					hardest = maxf(hardest, (last - along) / dt)
					if along <= 0.05:
						stopped_in = elapsed
				last = along
			Input.action_release(InputActions.MOVE_BACK)
			# Full lock at speed: the circle it sweeps.
			player.velocity = Vector3.ZERO
			Input.action_press(InputActions.MOVE_FORWARD)
			for _tick in hz * 6:
				player._physics_process(dt)
			var before := player._ride_heading
			Input.action_press(InputActions.MOVE_RIGHT)
			for _tick in hz * 3:
				player._physics_process(dt)
			var rate := absf(player._ride_heading - before) / 3.0
			var circling := Vector2(player.velocity.x, player.velocity.z).length()
			var radius := circling / maxf(rate, 0.001)
			var banked := absf(player.ride_bank())
			Input.action_release(InputActions.MOVE_FORWARD)
			Input.action_release(InputActions.MOVE_RIGHT)
			# And standing still with the bars hard over: it must not spin.
			player.velocity = Vector3.ZERO
			for _tick in hz:
				player._physics_process(dt)
			var rest_heading := player._ride_heading
			Input.action_press(InputActions.MOVE_RIGHT)
			for _tick in hz:
				player._physics_process(dt)
			Input.action_release(InputActions.MOVE_RIGHT)
			var spun := absf(player._ride_heading - rest_heading)
			results["%s%d" % [kind, hz]] = {
				"reaches": reaches, "stopped_in": stopped_in, "distance": stopped_over,
				"hardest": hardest, "radius": radius, "bank": banked, "spun": spun,
			}
			_expect(
				reaches > 1.2 and reaches < 3.0,
				"a %s at %d ticks reaches nine tenths of its speed in %.2f s: gentle, not sluggish" % [kind, hz, reaches]
			)
			_expect(
				peak <= top * 1.15 + 0.05,
				"and no faster than before: %.2f m/s against the %.2f it was" % [peak, top * 1.15]
			)
			_expect(
				stopped_in > 1.0 and stopped_in < 3.0 and hardest < 12.0,
				"braking from full speed takes %.2f s and %.1f m, at most %.1f m/s squared: no instant stop" % [
					stopped_in, stopped_over, hardest
				]
			)
			_expect(
				radius > 3.0 and radius < 12.0,
				"full lock at %.1f m/s sweeps a circle %.1f m across its radius" % [circling, radius]
			)
			_expect(spun < 0.3, "bars hard over standing still turn it %.2f rad in a second: it does not spin" % spun)
			player.queue_free()
	Engine.physics_ticks_per_second = 60
	# The quad is slower to pull away than it was, the bicycle slower again.
	_expect(
		results["bicycle60"]["reaches"] > 1.2 and results["motorcycle60"]["reaches"] > 1.2,
		"every machine takes over a second to reach speed"
	)
	_expect(fastest <= MountKinds.speed(MountKinds.MOTORCYCLE) * 1.15 + 0.05, "the fastest machine is not faster than it was: %.2f m/s" % fastest)
	# The same at both tick rates, within a tenth.
	for kind: StringName in [MountKinds.BICYCLE, MountKinds.QUAD, MountKinds.MOTORCYCLE]:
		var fast: Dictionary = results["%s60" % kind]
		var slow: Dictionary = results["%s30" % kind]
		_expect(
			absf(float(fast["reaches"]) - float(slow["reaches"])) < 0.15 * float(fast["reaches"])
			and absf(float(fast["radius"]) - float(slow["radius"])) < 0.15 * float(fast["radius"])
			and absf(float(fast["distance"]) - float(slow["distance"])) < 0.15 * float(fast["distance"]),
			"a %s pulls, stops and turns the same at 30 ticks as at 60" % kind
		)
	# Leaning: the bicycle plainly, the quad not at all, nothing past what reads as falling.
	var bicycle_bank := float(results["bicycle60"]["bank"])
	var quad_bank := float(results["quad60"]["bank"])
	_expect(
		bicycle_bank > deg_to_rad(8.0) and bicycle_bank < deg_to_rad(28.0),
		"the bicycle leans %.1f degrees into a full-lock corner" % rad_to_deg(bicycle_bank)
	)
	_expect(quad_bank < deg_to_rad(0.5), "and the quad leans %.1f degrees, which is none" % rad_to_deg(quad_bank))
	floor_body.queue_free()

## The parts of a ridden machine keep time with the ground: wheels turn at the
## rate that rolling without slipping demands, a bicycle's pedals turn by the
## gearing and stop when the child coasts, the bars and the quad's front wheels go
## over with the steering, a quad rides on springs over a bump and a bicycle does
## not, and the body leans only for the machines that lean.
func _check_the_parts_of_a_ridden_machine_keep_time_with_the_ground() -> void:
	print("the parts of a ridden machine keep time with the ground")
	await process_frame
	var field := HeightField.new(20260903)
	for hz: int in [60, 30]:
		var dt := 1.0 / float(hz)
		for kind: StringName in [MountKinds.BICYCLE, MountKinds.QUAD]:
			var mounts := Mounts.new(field)
			get_root().add_child(mounts)
			var camp := Vector3(-20.0, field.height_at(-20.0, 18.0), 18.0)
			mounts.place(kind, camp)
			mounts.mount(kind)
			var pace := 6.0
			var at := camp
			# Warm up so the smoothed pace has settled.
			for _frame in hz * 2:
				at.z -= pace * dt
				mounts.carry(at, 0.0)
				mounts._process(dt)
			var wheel_before := mounts.wheel_phase()
			var crank_before := mounts.crank_phase()
			var wheel_turned := 0.0
			var crank_turned := 0.0
			var last_wheel := wheel_before
			var last_crank := crank_before
			var ground_covered := 0.0
			for _frame in hz * 2:
				at.z -= pace * dt
				ground_covered += pace * dt
				mounts.carry(at, 0.0)
				mounts._process(dt)
				wheel_turned += fposmod(mounts.wheel_phase() - last_wheel, TAU)
				crank_turned += fposmod(mounts.crank_phase() - last_crank, TAU)
				last_wheel = mounts.wheel_phase()
				last_crank = mounts.crank_phase()
			var radius := MountKinds.wheel_radius(kind)
			_expect(
				absf(wheel_turned - ground_covered / radius) < 0.05 * ground_covered / radius,
				"a %s's wheels turn %.1f rad over %.1f m of ground at %d ticks: %.1f rad for a %.2f m wheel" % [
					kind, wheel_turned, ground_covered, hz, ground_covered / radius, radius
				]
			)
			if kind == MountKinds.BICYCLE:
				_expect(mounts.pedalling(), "a bicycle holding its speed is being pedalled")
				_expect(
					absf(crank_turned - wheel_turned * MountKinds.PEDAL_RATIO) < 0.05 * wheel_turned * MountKinds.PEDAL_RATIO,
					"its cranks turn %.2f of a wheel turn at %d ticks: %.1f rad against %.1f" % [
						MountKinds.PEDAL_RATIO, hz, crank_turned, wheel_turned * MountKinds.PEDAL_RATIO
					]
				)
				var cranks := mounts.node_of(kind).get_node_or_null("Cranks") as Node3D
				_expect(
					cranks != null and absf(angle_difference(cranks.rotation.x, mounts.crank_phase())) < 0.001,
					"the cranks drawn are at the phase the rider's feet are told"
				)
				# Coasting: slowing down by more than a freewheel's drag lets the pedals rest.
				var rest := mounts.crank_phase()
				var slowing := pace
				for _frame in hz * 2:
					slowing = maxf(slowing - 3.0 * dt, 1.0)
					at.z -= slowing * dt
					mounts.carry(at, 0.0)
					mounts._process(dt)
				_expect(
					not mounts.pedalling() and absf(mounts.crank_phase() - rest) < PI,
					"slowing down lets the pedals rest: not pedalling, cranks turned %.2f rad while the wheels rolled on" % absf(mounts.crank_phase() - rest)
				)
			mounts.queue_free()

	# Steering: the bars and the quad's front wheels.
	var steered := Mounts.new(field)
	get_root().add_child(steered)
	var spot := Vector3(-20.0, field.height_at(-20.0, 18.0), 18.0)
	steered.place(MountKinds.QUAD, spot)
	steered.place(MountKinds.BICYCLE, spot + Vector3(6.0, 0.0, 0.0))
	steered.mount(MountKinds.QUAD)
	steered.lean(0.0, 0.4)
	steered.carry(spot, 0.0)
	steered._process(1.0 / 60.0)
	var quad_node := steered.node_of(MountKinds.QUAD)
	_expect(
		absf((quad_node.get_node("Wheel0") as Node3D).rotation.y - 0.4) < 0.001
		and absf((quad_node.get_node("Wheel1") as Node3D).rotation.y - 0.4) < 0.001,
		"the quad's front wheels go over with the bars"
	)
	_expect(
		absf((quad_node.get_node("Wheel2") as Node3D).rotation.y) < 0.001
		and absf((quad_node.get_node("Wheel3") as Node3D).rotation.y) < 0.001,
		"and its back wheels stay straight"
	)
	steered.dismount(spot, 0.0)
	steered.mount(MountKinds.BICYCLE)
	steered.lean(0.0, -0.5)
	steered.carry(spot + Vector3(6.0, 0.0, 0.0), 0.0)
	steered._process(1.0 / 60.0)
	var bike_node := steered.node_of(MountKinds.BICYCLE)
	var steer := bike_node.get_node("Steer") as Node3D
	var front_wheel := bike_node.get_node("Wheel0") as Node3D
	var swung := front_wheel.position.x
	_expect(
		absf(steer.transform.basis.get_rotation_quaternion().get_angle() - 0.5) < 0.01,
		"the handlebars, forks and front wheel go over together by %.2f rad" % steer.transform.basis.get_rotation_quaternion().get_angle()
	)
	_expect(
		absf(swung) > 0.005 and absf(bike_node.get_node("Wheel1").position.x) < 0.0001,
		"the front wheel swings %.3f m round the head tube with the bars and the back wheel stays put" % swung
	)
	# Leaning: told to lean, a ridden machine lays over about its tyres, and the
	# ground's own up is what the rider is told.
	steered.lean(0.0, 0.0)
	steered.carry(spot + Vector3(6.0, 0.0, 0.0), 0.0)
	var upright := bike_node.transform.basis.y
	steered.lean(0.2, 0.0)
	steered.carry(spot + Vector3(6.0, 0.0, 0.0), 0.0)
	var laid := bike_node.transform.basis.y
	var lies_over := acos(clampf(laid.dot(upright), -1.0, 1.0))
	_expect(
		absf(lies_over - 0.2) < 0.02,
		"a bicycle told to lean 0.2 rad lies over by %.2f rad more than on the same ground upright" % lies_over
	)
	_expect(
		steered.up_of(MountKinds.BICYCLE).dot(Vector3.UP) > 0.98,
		"and the rider is handed the ground's up, not the lean, which they lean by themselves"
	)
	steered.dismount(spot, 0.0)
	_expect(
		absf((bike_node.get_node("Steer") as Node3D).transform.basis.get_rotation_quaternion().get_angle()) < 0.001
		and absf(bike_node.transform.basis.y.dot(Vector3.UP) - 1.0) < 0.05,
		"got off, the bicycle stands with its bars straight and upright"
	)
	steered.queue_free()

	# Suspension: a bump moves a quad's body on its springs and it settles; a
	# bicycle is rigid.
	for hz: int in [60, 30]:
		var dt := 1.0 / float(hz)
		var sprung := Mounts.new(field)
		get_root().add_child(sprung)
		sprung.place(MountKinds.QUAD, spot)
		sprung.place(MountKinds.BICYCLE, spot + Vector3(6.0, 0.0, 0.0))
		var deflection := 0.0
		var late := 0.0
		sprung.mount(MountKinds.QUAD)
		sprung._carried_to = spot
		for frame in hz * 3:
			# A kerb: the ground rises fifteen centimetres in a tenth of a second
			# a second in, and stays there.
			var rise := clampf((float(frame) * dt - 1.0) / 0.1, 0.0, 1.0) * 0.15
			sprung._carried_to = spot + Vector3(0.0, rise, 0.0)
			sprung._process(dt)
			deflection = maxf(deflection, absf(sprung.saddle_lift()))
			if frame >= hz * 3 - 1:
				late = absf(sprung.saddle_lift())
		_expect(
			deflection > 0.005 and deflection <= 0.05 + 0.0001,
			"over a kerb at %d ticks a quad's body moves %.3f m on its springs, within its travel" % [hz, deflection]
		)
		_expect(late < 0.004, "and has settled by the end: %.4f m" % late)
		sprung.dismount(spot, 0.0)
		sprung.mount(MountKinds.BICYCLE)
		var rigid := 0.0
		sprung._carried_to = spot + Vector3(6.0, 0.0, 0.0)
		for frame in hz:
			var rise := clampf((float(frame) * dt - 0.3) / 0.1, 0.0, 1.0) * 0.15
			sprung._carried_to = spot + Vector3(6.0, rise, 0.0)
			sprung._process(dt)
			rigid = maxf(rigid, absf(sprung.saddle_lift()))
		_expect(rigid == 0.0, "and a bicycle does not bob on a kerb")
		sprung.queue_free()

## A bicycle has no engine; it is heard as tyres and a freewheel, a bell when the
## child sets off, and a quad's engine note rises with its speed.
func _check_a_bicycle_is_heard_as_tyres_and_a_quad_as_an_engine() -> void:
	print("a bicycle is heard as tyres and a quad as an engine")
	_expect(
		MountKinds.engine_effort(MountKinds.BICYCLE, 8.0) < 0.0,
		"a bicycle has no engine to tell the sound about, at any speed"
	)
	_expect(MountKinds.engine_effort(MountKinds.HORSE, 8.0) < 0.0, "nor does a horse")
	var slow := MountKinds.engine_effort(MountKinds.QUAD, 3.0)
	var quick := MountKinds.engine_effort(MountKinds.QUAD, 10.0)
	_expect(
		slow >= 0.0 and quick > slow and quick <= 1.0,
		"a quad's revs rise with its speed: %.2f at 3 m/s, %.2f at 10 m/s" % [slow, quick]
	)
	var sound := Ambience.new()
	get_root().add_child(sound)
	for _frame in 20:
		sound.engine(MountKinds.engine_effort(MountKinds.BICYCLE, 6.0), 0.05)
		sound.cycling(0.7, false, 0.05)
	_expect(not sound.engine_is_running(), "a ridden bicycle starts no engine")
	_expect(sound.cycling_is_heard(), "and is heard rolling: tyres and the freewheel's tick")
	var pitch_slow := sound._ticks.pitch_scale
	for _frame in 20:
		sound.cycling(1.0, false, 0.05)
	_expect(sound._ticks.pitch_scale > pitch_slow * 1.2, "the tick comes faster as the wheel does")
	for _frame in 20:
		sound.cycling(1.0, true, 0.05)
	var chain_db := sound._ticks.volume_db
	for _frame in 20:
		sound.cycling(1.0, false, 0.05)
	_expect(sound._ticks.volume_db > chain_db + 6.0, "the freewheel ticks louder coasting than the chain does pedalling")
	for _frame in 30:
		sound.cycling(0.0, true, 0.05)
	_expect(not sound.cycling_is_heard(), "a bicycle standing still is silent")
	for _frame in 10:
		sound.cycling(0.8, true, 0.05)
	_expect(sound.cycling_is_heard(), "and rolling again is heard")
	for _frame in 30:
		sound.cycling(-1.0, false, 0.05)
	_expect(not sound.cycling_is_heard(), "got off, the sound fades away rather than lingering")
	var bell := sound._bell.stream as AudioStreamWAV
	_expect(
		bell.loop_mode == AudioStreamWAV.LOOP_DISABLED and bell.data.size() / 2 > Ambience.RATE / 2,
		"the bell is struck once, not looped, and rings for over half a second"
	)
	var loudest := 0
	for i in bell.data.size() / 2:
		loudest = maxi(loudest, absi(bell.data.decode_s16(i * 2)))
	_expect(loudest > 4000 and loudest < 32000, "and is audible without clipping (peak %d of 32767)" % loudest)
	sound.queue_free()

## The pedals the rider's feet are on are the ones drawn, and the bicycle stays
## a few meshes and warm colours.
func _check_the_riders_feet_are_on_the_bicycles_pedals_and_it_is_drawn_warm() -> void:
	print("the rider's feet are on the bicycle's pedals and it is drawn warm")
	_expect(
		is_equal_approx(float(SeatPose.POSES[&"bicycle"]["pedal_radius"]), MountKinds.PEDAL_REACH),
		"the circle the feet go round is the length of the cranks drawn"
	)
	var rig := Character.build(2, 1, 1, Visitors.SHIRTS[2])
	var motion := RigMotion.new(rig)
	motion.seat = MountKinds.BICYCLE
	motion.pedal_phase = 1.3
	motion.gait = 6.0
	for _i in 90:
		motion.step(1.0 / 60.0)
	_expect(absf(motion._pedal - 1.3) < 0.0001, "the rider's feet are put at the crank's phase, not a pace of their own")
	motion.pedal_phase = -1.0
	var before := motion._pedal
	for _i in 30:
		motion.step(1.0 / 60.0)
	_expect(motion._pedal > before, "and with no word from the bicycle they pedal as they did")
	rig.queue_free()
	for kind: StringName in [MountKinds.BICYCLE, MountKinds.QUAD]:
		var node := MountKinds.build_node(kind)
		var meshes := 0
		for child in node.find_children("*", "MeshInstance3D", true, false):
			meshes += 1
		_expect(meshes <= 7, "a %s is drawn in %d meshes, a few at most" % [kind, meshes])
		node.free()
	var frame := MountKinds.colour(MountKinds.BICYCLE)
	_expect(frame.r > frame.b + 0.3 and frame.g >= frame.b, "the bicycle's red reads red under the sky light")
	var tan := Color(0.62, 0.38, 0.20)
	_expect(tan.r > tan.b and tan.g >= tan.b, "and its saddle reads warm")

## The pool, with real ground and a real child.
##
## The fence was solid to 1.3 m and a running jump takes a child's feet 1.4 m
## up, so from any side the fence, and the turnstile in its gateway, were
## cleared without a ticket. The floor climbed back to the brim at 61 degrees
## on the short sides, past the 52 a child can walk, and a swimmer pushing at
## the -x side stayed in the water. The turnstile stayed open seven seconds
## whoever it had been opened for. None of it showed in the checks above,
## which look at the numbers and never put a child at the fence.
func _check_the_pool_holds_its_fence_and_lets_a_swimmer_out() -> void:
	print("the pool holds its fence and lets a swimmer out")
	var field := HeightField.new(20260903)
	var camp := field.camp_centre()

	# The shelf is walkable all round: the steepest the floor rises anywhere in
	# the pool, found on a quarter-metre grid, is under what a child climbs.
	var steepest := 0.0
	var origin := PlaceSpec.centre_of(&"pool", camp)
	var gx := -Places.POOL_HALF_X
	while gx <= Places.POOL_HALF_X:
		var gz := -Places.POOL_HALF_Z
		while gz <= Places.POOL_HALF_Z:
			var here := PlaceSpec.excavation(origin.x + gx, origin.z + gz, camp)
			var east := PlaceSpec.excavation(origin.x + gx + 0.25, origin.z + gz, camp)
			var south := PlaceSpec.excavation(origin.x + gx, origin.z + gz + 0.25, camp)
			steepest = maxf(steepest, maxf(absf(east - here), absf(south - here)) / 0.25)
			gz += 0.25
		gx += 0.25
	_expect(
		rad_to_deg(atan(steepest)) < 45.0,
		"the floor of the pool rises at most %.0f degrees, which a child walks (they manage %.0f)" % [
			rad_to_deg(atan(steepest)), rad_to_deg(Player.CLIMBS_TO)
		]
	)

	# The sound of the water is not asked again at the edge: wading begins at
	# the one depth and ends at a shallower one.
	var main_script: GDScript = load("res://src/main.gd")
	var wading := false
	var flips := 0
	for step in 40:
		# A shelf whose depth wavers a centimetre or two across the threshold.
		var depth := 0.15 + sin(float(step) * 1.7) * 0.02
		var now: bool = main_script.is_wading(wading, depth)
		if now != wading:
			flips += 1
		wading = now
	_expect(flips <= 1, "walking the water's edge splashes once, not on every wobble (%d changes)" % flips)
	_expect(main_script.is_wading(false, 0.3) and not main_script.is_wading(true, 0.05), "and still splashes going in and coming out")
	var eye := false
	var eye_flips := 0
	for step in 40:
		var under := 0.5 + sin(float(step) * 1.3) * 0.05
		var now_under: bool = main_script.eye_is_under(eye, under)
		if now_under != eye:
			eye_flips += 1
		eye = now_under
	_expect(eye_flips <= 1, "and the eye crossing the surface is heard once (%d changes)" % eye_flips)

	# No machine is ridden to the poolside, whatever it is.
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	var all_barred := true
	for kind: StringName in [MountKinds.HORSE, MountKinds.BICYCLE, MountKinds.MOTORCYCLE, MountKinds.QUAD]:
		for offset: Vector3 in [Vector3(0.0, 0.0, 0.0), Vector3(PlaceSpec.POOL_HALF_X + 1.5, 0.0, 0.0), Vector3(0.0, 0.0, PlaceSpec.POOL_HALF_Z + 1.5), Vector3(-Places.POOL_FENCE_X + 0.5, 0.0, 0.0)]:
			if mounts.can_ride_over(kind, origin + offset):
				all_barred = false
				printerr("  a %s can be ridden to %s" % [kind, str(offset)])
	_expect(all_barred, "no horse or machine can be ridden into the pool or onto its poolside")
	mounts.queue_free()

	# The real ground, so there is a floor and a fence to meet.
	var terrain := Terrain.new(field)
	get_root().add_child(terrain)
	var places := Places.new(field)
	get_root().add_child(places)
	places.stand_up(camp)
	var spot: Vector3 = places._spots[Places.POOL]
	terrain.follow(spot)
	var deadline := Time.get_ticks_msec() + 120000
	while not terrain.is_idle() and Time.get_ticks_msec() < deadline:
		terrain._process(1.0 / 60.0)
		OS.delay_usec(500)
	_expect(terrain.has_ground_at(spot), "the pool's ground is baked and solid")

	var ticks := Engine.physics_ticks_per_second
	for rate: int in [60, 30]:
		Engine.physics_ticks_per_second = rate
		# The fence, run at and jumped at from four sides, a sprint's length off,
		# the jump taken at several distances.
		var cleared := 0
		var tries := 0
		for side: String in ["west", "north", "south", "east"]:
			for lead: float in [0.0, 0.6, 1.2, 1.8]:
				tries += 1
				if await _pool_runner(places, field, spot, side, lead, rate):
					cleared += 1
		_expect(cleared == 0, "%d of %d sprinting jumps at the fence got over it, at %d frames a second" % [cleared, tries, rate])

		# The turnstile: shut, then good for one go in and no more.
		var shut_in := await _pool_gate_run(places, field, spot, rate, false, false)
		_expect(not shut_in, "a child cannot walk or jump through the shut turnstile, at %d frames a second" % rate)
		var paid_in := await _pool_gate_run(places, field, spot, rate, true, false)
		_expect(paid_in, "a child who has paid goes in, at %d frames a second" % rate)
		_expect(
			not places.turnstile_open() and places._turnstile.collision_layer == TerrainSpec.LAYER_PROPS,
			"and it shuts behind them rather than waiting out its seven seconds"
		)
		var follower_in := await _pool_gate_run(places, field, spot, rate, false, false)
		_expect(not follower_in, "so the next child in is stopped by it")
		var out := await _pool_gate_run(places, field, spot, rate, true, true)
		_expect(out, "a child inside is let out, at %d frames a second" % rate)
		_expect(not places.turnstile_open(), "and it shuts behind them going out as well")
		var back_in := await _pool_gate_run(places, field, spot, rate, false, false)
		_expect(not back_in, "and being let out is not a way back in")

		# Out of the water on every side, without jumping, from the middle.
		for side: String in ["east", "west", "south", "north"]:
			var frames := await _pool_swim_out(places, field, spot, side, rate)
			_expect(
				frames > 0 and frames < rate * 5,
				"a swimmer reaches the poolside on the %s in %d frames (%.1f s), at %d frames a second" % [
					side, frames, float(frames) / float(rate), rate
				]
			)

		# And the floor is a floor: dropped into the deep end and dived, a child
		# lands on it and is not let through.
		var diver := Player.new()
		get_root().add_child(diver)
		var floor_y := field.height_at(spot.x, spot.z)
		diver.global_position = Vector3(spot.x, spot.y + 3.0, spot.z)
		var lowest := 99.0
		for frame in rate * 6:
			diver.water_depth = places.submersion(diver.global_position)
			if frame == rate * 2:
				diver.diving = true
			await physics_frame
			lowest = minf(lowest, diver.global_position.y)
		_expect(lowest > floor_y - 0.05, "a diver reaches the floor and stops there: lowest %.2f m against a floor at %.2f m, at %d frames a second" % [lowest, floor_y, rate])
		_expect(diver.global_position.y > floor_y - 0.05, "and has not gone through it")
		diver.free()
	Engine.physics_ticks_per_second = ticks
	terrain.queue_free()
	places.queue_free()

## Run a child at the fence from `side`, jumping once `lead` metres nearer than
## a metre from it, and say whether they ended up inside.
func _pool_runner(places: Places, field: HeightField, spot: Vector3, side: String, lead: float, rate: int) -> bool:
	var start := spot
	var yaw := 0.0
	var gate_x := spot.x + Places.POOL_FENCE_X
	match side:
		"west":
			start = spot + Vector3(-Places.POOL_FENCE_X - 5.0, 0.0, 3.0)
			yaw = -PI * 0.5
		"north":
			start = spot + Vector3(2.0, 0.0, -Places.POOL_FENCE_Z - 5.0)
			yaw = PI
		"south":
			start = spot + Vector3(2.0, 0.0, Places.POOL_FENCE_Z + 5.0)
		_:
			start = Vector3(gate_x + 5.0, 0.0, spot.z + 6.0)
			yaw = PI * 0.5
	start.y = field.height_at(start.x, start.z) + 0.3
	var child := Player.new()
	get_root().add_child(child)
	child.global_position = start
	child.camera_yaw = yaw
	for frame in 20:
		await physics_frame
	Input.action_press(InputActions.MOVE_FORWARD)
	Input.action_press(InputActions.SPRINT)
	var jumped := false
	for frame in rate * 4:
		var to_fence := 0.0
		match side:
			"west": to_fence = (spot.x - Places.POOL_FENCE_X) - child.global_position.x
			"north": to_fence = (spot.z - Places.POOL_FENCE_Z) - child.global_position.z
			"south": to_fence = child.global_position.z - (spot.z + Places.POOL_FENCE_Z)
			_: to_fence = child.global_position.x - gate_x
		if not jumped and to_fence < 1.0 + lead:
			child.request_jump()
			jumped = true
		child.water_depth = places.submersion(child.global_position)
		await physics_frame
	Input.action_release(InputActions.MOVE_FORWARD)
	Input.action_release(InputActions.SPRINT)
	var inside := places.inside_pool_fence(child.global_position)
	child.free()
	return inside

## Walk (and jump once) at the turnstile from outside, or from inside when
## `leaving`. `paid` opens it the way a ticket does, or the way the turnstile
## does for a child at the bar on the inside. Says whether they got through.
## The turnstile is told where the child is every frame, as the game does.
func _pool_gate_run(places: Places, field: HeightField, spot: Vector3, rate: int, paid: bool, leaving: bool) -> bool:
	var gate := spot + Vector3(Places.POOL_FENCE_X, 0.0, 0.0)
	var child := Player.new()
	get_root().add_child(child)
	var from_x := gate.x - 4.0 if leaving else gate.x + 4.0
	child.global_position = Vector3(from_x, field.height_at(from_x, gate.z) + 0.3, gate.z)
	child.camera_yaw = -PI * 0.5 if leaving else PI * 0.5
	for frame in 20:
		await physics_frame
	if paid and not leaving:
		places.open_turnstile(true)
	Input.action_press(InputActions.MOVE_FORWARD)
	var jumped := false
	for frame in rate * 4:
		var at := child.global_position
		if leaving and places.inside_pool_fence(at) and places.at_turnstile(at, Places.TURNSTILE_EXIT_REACH) and not places.turnstile_open():
			places.open_turnstile(false)
		places.the_child_is_at(at)
		if not jumped and absf(at.x - gate.x) < 1.6 and not paid:
			child.request_jump()
			jumped = true
		places._tick(1.0 / float(rate))
		child.water_depth = places.submersion(at)
		await physics_frame
	Input.action_release(InputActions.MOVE_FORWARD)
	var now := child.global_position
	var got_through := (now.x > gate.x + 1.0) if leaving else places.inside_pool_fence(now)
	child.free()
	return got_through

## Swim from the middle of the pool towards `side` and count the frames until
## the child is standing on the poolside, or -1 if they never are.
func _pool_swim_out(places: Places, field: HeightField, spot: Vector3, side: String, rate: int) -> int:
	var yaw := 0.0
	var off := Vector3.ZERO
	match side:
		"east":
			yaw = -PI * 0.5
			off = Vector3(6.0, 0.0, 0.0)
		"west":
			yaw = PI * 0.5
			off = Vector3(-6.0, 0.0, 0.0)
		"south":
			yaw = PI
			off = Vector3(0.0, 0.0, 4.0)
		_:
			off = Vector3(0.0, 0.0, -4.0)
	var swimmer := Player.new()
	get_root().add_child(swimmer)
	swimmer.global_position = Vector3(spot.x + off.x, spot.y - 0.9, spot.z + off.z)
	swimmer.camera_yaw = yaw
	for frame in 30:
		swimmer.water_depth = places.submersion(swimmer.global_position)
		await physics_frame
	Input.action_press(InputActions.MOVE_FORWARD)
	var result := -1
	for frame in rate * 12:
		swimmer.water_depth = places.submersion(swimmer.global_position)
		await physics_frame
		if swimmer.global_position.y > spot.y - 0.15 and swimmer.is_on_floor():
			result = frame
			break
	Input.action_release(InputActions.MOVE_FORWARD)
	swimmer.free()
	return result

## A hollow in the range whose walls are all too steep to climb is a trap.
##
## The terraces cut into the mountains leave a few pockets high up the range,
## each a few strides across and ringed by ground steeper than a child climbs
## (Player.CLIMBS_TO). A child who dropped into one could push the stick for as
## long as they liked and there was no button to go home with. The flood fill
## over the height field that finds them lives in RespawnSpot; the game asks it
## after a few seconds of pushing without moving. The three pockets here were
## found by a flood fill over the whole valley out to 1.4 km, and are fixed
## numbers because the valley is a pure function of the seed.
func _check_a_child_shut_in_a_pocket_of_the_range_is_lifted_out() -> void:
	print("a child shut in a pocket of the range is lifted out")
	var field := HeightField.new(20260903)
	var spawn := field.find_spawn_point()
	var pockets: Array[Vector2] = [Vector2(-776.0, 406.0), Vector2(864.0, -382.0), Vector2(986.0, -258.0)]
	var outs: Array[Vector3] = []
	for pocket in pockets:
		var in_it := Vector3(pocket.x, field.height_at(pocket.x, pocket.y), pocket.y)
		var out := RespawnSpot.way_out_of_a_pocket(field, in_it, spawn)
		_expect(out.is_finite(), "the pocket at %s is found to be closed" % [pocket])
		if not out.is_finite():
			continue
		var distance := Vector2(out.x - in_it.x, out.z - in_it.z).length()
		_expect(distance < 36.0, "and the way out is %.0f m off, not a trip to the camp" % distance)
		_expect(
			not RespawnSpot.way_out_of_a_pocket(field, out, spawn).is_finite(),
			"the ground they are put on is open: a second look finds nothing to lift them from"
		)
		_expect(
			field.steepness_at(out.x, out.z) <= RespawnSpot.POCKET_STANDING
			and not RespawnSpot.is_wet(field, null, out),
			"and it is dry, gentle ground"
		)
		outs.append(out)

	# Open ground is never a pocket, so nobody walking the valley is moved.
	var moved := 0
	for step in 12:
		var angle := TAU * float(step) / 12.0
		for radius: float in [30.0, 150.0, 330.0]:
			var x := cos(angle) * radius
			var z := sin(angle) * radius
			var here := Vector3(x, field.height_at(x, z), z)
			if RespawnSpot.way_out_of_a_pocket(field, here, spawn).is_finite():
				moved += 1
	_expect(moved == 0, "no point on the valley floor is a pocket (%d found)" % moved)
	_expect(not RespawnSpot.way_out_of_a_pocket(field, spawn, spawn).is_finite(), "nor is the camp")
	var source := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	_expect(
		source.contains("RespawnSpot.way_out_of_a_pocket(") and source.contains("_lift_out_of_a_pocket(delta)"),
		"the game asks after a few seconds of pushing without getting anywhere"
	)
	_expect(
		source.contains("if not at.is_finite():"),
		"and a position that is not a number is caught as a fall is"
	)

	if outs.is_empty():
		return
	# Set down where the lift puts them, on real ground, at two physics rates:
	# they stand on it rather than sinking into the range or sliding off.
	var terrain := Terrain.new(field)
	get_root().add_child(terrain)
	var put := outs[0]
	terrain.follow(put)
	var deadline := Time.get_ticks_msec() + 60000
	while not terrain.is_idle() and Time.get_ticks_msec() < deadline:
		terrain._process(1.0 / 60.0)
		OS.delay_usec(500)
	terrain.ensure_ground_at(put)
	var was := Engine.physics_ticks_per_second
	for rate: int in [60, 30]:
		Engine.physics_ticks_per_second = rate
		var child := Player.new()
		child.position = put + Vector3.UP * 1.2
		get_root().add_child(child)
		for _tick in rate * 2:
			await physics_frame
		var ground := field.height_at(child.global_position.x, child.global_position.z)
		_expect(
			child.global_position.is_finite() and child.is_on_floor()
			and absf(child.global_position.y - ground) < 0.35,
			"at %d ticks a second the child lifted out stands on the ground (%.2f m over it)" % [
				rate, child.global_position.y - ground
			]
		)
		child.queue_free()
	Engine.physics_ticks_per_second = was
	terrain.queue_free()

## The camp is where a child falls back to, and a house the other child built
## over it leaves them in a wall all the same.
func _check_the_fallback_to_the_camp_is_open_ground() -> void:
	print("the fallback to the camp is open ground")
	var field := HeightField.new(20260903)
	var structures := Structures.new(field)
	get_root().add_child(structures)
	var park := _StubPark.new()
	var spawn := field.find_spawn_point()
	var c := HouseParts.snap_cell(spawn.x, spawn.z)
	var base := field.height_at(c.x, c.y)
	for edge: Vector2 in [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1)]:
		var wx := c.x + edge.x
		var wz := c.y + edge.y
		structures.place(HouseParts.WALL, Vector3(wx, field.height_at(wx, wz), wz), 0.0 if edge.x == 0.0 else PI * 0.5)
	var in_wall := Vector3(c.x + 1.0, base, c.y)
	_expect(RespawnSpot.built_over(structures, in_wall), "a camp stands inside a wall")
	for saved: Vector3 in [Vector3(NAN, 0.0, 0.0), Vector3(1e7, 0.0, 0.0), in_wall]:
		var put := RespawnSpot.choose(field, structures, null, park, null, saved, in_wall)
		_expect(
			put.is_finite() and not RespawnSpot.built_over(structures, put),
			"a child with nowhere else to go is not put in the wall of their camp (%s)" % [put]
		)
	structures.queue_free()

