			worst = maxf(worst, maxf(absf(box.position.x), absf(box.end.x)))
	_expect(
		worst <= FerrisWheel.HOOP_X + 0.25,
		"a gondola's drawing reaches %.2f m across, hoops stand at %.2f" % [worst, FerrisWheel.HOOP_X]
