func game_const(name: String) -> Variant:
	return (load("res://src/main.gd") as GDScript).get_script_constant_map().get(name)

## The placeholders a text takes, in order, as "d" and "s" letters: "%d%%" is
## one number, "%d{coin|coins}" is one number, "%%" is none.
func _text_slots(text: String) -> String:
	var slots := ""
	var at := 0
	while at < text.length():
		if text[at] != "%" or at + 1 >= text.length():
			at += 1
			continue
		if text[at + 1] != "%":
			slots += text[at + 1]
		at += 2
	return slots

## A text that takes a number takes the same numbers, of the same type, in every
## language and as many as the code passes; one that does not must not carry a
## stray "%". Text.format is `Text.of(key) % values`, so a mismatch is not a
## blank but a crash on a child's screen, in whichever language nobody tried.
## The plural groups ("%d{coin|coins}") are checked for shape, and the helper
## for what it gives for the numbers that go wrong in Russian.
func _check_text_placeholders_and_plurals_agree() -> void:
	print("text placeholders and plurals agree")
	var bad := PackedStringArray()
	for key: String in Text.STRINGS:
		var entry: Dictionary = Text.STRINGS[key]
		var expected := _text_slots(String(entry[Text.EN]))
		for code: StringName in Text.LANGUAGES:
			if not entry.has(code):
				continue
			var text := String(entry[code])
			if _text_slots(text) != expected:
				bad.append("%s/%s takes '%s', English takes '%s'" % [key, code, _text_slots(text), expected])
			for slot in _text_slots(text):
				if slot != "d" and slot != "s":
					bad.append("%s/%s has an unsupported placeholder %%%s" % [key, code, slot])
			# Every group sits straight after a %d and has two or three forms.
			var group := text.find("{")
			while group >= 0:
				var close := text.find("}", group)
				var forms := text.substr(group + 1, maxi(close - group - 1, 0)).split("|")
				if close < 0 or not text.substr(0, group).ends_with("%d") or forms.size() < 2 or forms.size() > 3:
					bad.append("%s/%s has a malformed plural group" % [key, code])
					break
				if code != Text.RU and forms.size() != 2:
					bad.append("%s/%s: only Russian has three forms" % [key, code])
				group = text.find("{", close)
	_expect(bad.is_empty(), "all %d texts take the same placeholders in every language" % Text.STRINGS.size())
	for line in bad:
		_fail(line)

	# What the code passes. Looks at each Text.format("literal", [ ... ]) and
	# counts the top-level items in the list; a key built at run time is passed
	# over, and Text.of() of a key that takes values would print "%d" raw.
	var called := RegEx.new()
	called.compile("Text\\.(of|format)\\(\\s*\"([a-z_0-9]+)\"\\s*([,)])")
	var checked := 0
	for path in _find_scripts("res://src"):
		if path.ends_with("i18n/text.gd") or path.ends_with("ci_check.gd"):
			continue
		var source := _code_only(FileAccess.get_file_as_string(path))
		for found in called.search_all(source):
			var key := found.get_string(2)
			if not Text.STRINGS.has(key):
				continue
			var slots := _text_slots(String(Text.STRINGS[key][Text.EN]))
			if found.get_string(1) == "of":
				_expect(found.get_string(3) == ")" and slots.is_empty(),
					"%s asked for with Text.of takes no values (%s)" % [key, path])
				continue
			var passed := 0
			var depth := 0
			var at := source.find("[", found.get_end() - 1)
			var started := at >= 0 and source.substr(found.get_end(), at - found.get_end()).strip_edges().is_empty()
			if not started:
				continue
			var items := 0
			var index := at + 1
			while index < source.length():
				var c := source[index]
				if c == "]" and depth == 0:
					break
				if not c.strip_edges().is_empty() and c != ",":
					passed = 1
				if c == "[" or c == "(" or c == "{":
					depth += 1
				elif c == "]" or c == ")" or c == "}":
					depth -= 1
				elif c == "\"":
					index = source.find("\"", index + 1)
					if index < 0:
						break
				elif c == "," and depth == 0:
					items += 1
				index += 1
			if passed > 0:
				items += 1
			checked += 1
			_expect(items == slots.length(),
				"%s is given %d values and takes %d (%s)" % [key, items, slots.length(), path])
	_ok("%d literal Text calls pass as many values as their text takes" % checked)

	# The plural helper, on the numbers that go wrong.
	var cases := [
		[Text.EN, "say_no_coins", 1, "you need 1 coin"],
		[Text.EN, "say_no_coins", 2, "you need 2 coins"],
		[Text.FR, "say_no_coins", 0, "il te faut 0 pièce"],
		[Text.FR, "say_no_coins", 1, "il te faut 1 pièce"],
		[Text.FR, "say_no_coins", 2, "il te faut 2 pièces"],
		[Text.RU, "ask_buy_ride", 1, "купить поездку за 1 монету?"],
		[Text.RU, "ask_buy_ride", 2, "купить поездку за 2 монеты?"],
		[Text.RU, "ask_buy_ride", 5, "купить поездку за 5 монет?"],
		[Text.RU, "ask_buy_ride", 11, "купить поездку за 11 монет?"],
		[Text.RU, "ask_buy_ride", 12, "купить поездку за 12 монет?"],
		[Text.RU, "ask_buy_ride", 21, "купить поездку за 21 монету?"],
		[Text.RU, "ask_buy_ride", 22, "купить поездку за 22 монеты?"],
		[Text.RU, "ask_buy_ride", 100, "купить поездку за 100 монет?"],
		[Text.RU, "ask_buy_ride", 101, "купить поездку за 101 монету?"],
		[Text.EN, "dish_gives", 25, "25% energy"],
	]
	for item: Array in cases:
		Text.set_language(item[0])
		var said := Text.format(item[1], [item[2]])
		_expect(said == item[3], "%s %d reads '%s' (wanted '%s')" % [item[1], item[2], said, item[3]])
	# Two numbers in one text each take their own form.
	Text.set_language(Text.RU)
	var sold := Text.format("say_sold", [1, 22])
	Text.set_language(Text.EN)
	_expect(sold == "продано 1 за 22 монеты", "two numbers in one text agree separately ('%s')" % sold)

## A child at the fastest machine's 16.5 m/s, at 30 and at 60 frames a second,
## must always have collision under them, however far the streamer has got. The
## streamer is only asked a few hundred frames of questions, with the workers
## doing real bakes, so the check is bounded; the net (ensure_ground_at) is
## what makes the assertion true when a bake has not landed yet. A chunk that a
## stale non-collision bake is still working on must also end up solid.
func _check_the_chunk_under_a_fast_child_always_has_collision() -> void:
	print("the chunk under a fast child always has collision")
	var field := HeightField.new(20260903)
	var start := field.find_spawn_point()
	for fps: int in [30, 60]:
		var terrain := Terrain.new(field)
		get_root().add_child(terrain)
		var delta := 1.0 / float(fps)
		var frames := fps * 4
		var solid := true
		var late := 0
		var deadline := Time.get_ticks_msec() + 20000
		for frame in frames:
			if Time.get_ticks_msec() > deadline:
				break
			var at := start + Vector3(16.5 * delta * float(frame), 0.0, 0.0)
			terrain.follow(at)
			terrain._process(delta)
			if not terrain.has_ground_at(at):
				late += 1
			terrain.ensure_ground_at(at)
			if not terrain.has_ground_at(at):
				solid = false
			OS.delay_usec(500)
		print("  %d fps: the stream was late under the child on %d of %d frames" % [fps, late, frames])
		_expect(solid, "at 16.5 m/s and %d fps the chunk under the child has collision on every frame" % fps)
		terrain.queue_free()

	# A far chunk with a hollow bake in flight: made solid, and still solid once
	# the stale bake would have landed.
	var terrain := Terrain.new(field)
	get_root().add_child(terrain)
	terrain.follow(start)
	var far := TerrainSpec.chunk_at(start) + Vector2i(5, 0)
	terrain._submit_chunk(far, 2)
	var spot := Vector3((float(far.x) + 0.5) * TerrainSpec.CHUNK_SIZE, 0.0, (float(far.y) + 0.5) * TerrainSpec.CHUNK_SIZE)
	_expect(not terrain.has_ground_at(spot), "a chunk five away has no collision to begin with")
	terrain.ensure_ground_at(spot)
	_expect(terrain.has_ground_at(spot), "and has some once the net has caught it")
	var deadline := Time.get_ticks_msec() + 5000
	for frame in 60:
		if Time.get_ticks_msec() > deadline:
			break
		terrain._process(1.0 / 60.0)
		OS.delay_usec(1000)
	_expect(terrain.has_ground_at(spot), "and a hollow bake that was in flight does not replace it")
	terrain.queue_free()

## A dry, level spot a good way from the camp's own furniture, for the mount
## checks that need ground nothing reserves.
func _open_meadow(mounts: Mounts, field: HeightField) -> Vector3:
	var camp := field.camp_centre()
	for step in 60:
		var at := camp + Vector3(70.0 + 9.0 * float(step), 0.0, 40.0)
		at.y = field.height_at(at.x, at.z)
		var clear := true
		for ring: Vector3 in [Vector3.ZERO, Vector3(8.0, 0.0, 0.0), Vector3(-8.0, 0.0, 0.0), Vector3(0.0, 0.0, 8.0), Vector3(0.0, 0.0, -8.0)]:
			if not mounts._is_dry_footing(at + ring) or not mounts.spot_is_clear(MountKinds.HORSE, at + ring):
				clear = false
		if clear:
			return at
	return camp + Vector3(70.0, 0.0, 40.0)

## Two phones getting on one machine at once, a machine left on another or in a
## wall, a damaged save, and a machine with nowhere clear asking every frame.
func _check_remote_mounts_are_decided_clear_and_bounded_the_same_on_both_phones() -> void:
	print("remote mounts are decided clear and bounded the same on both phones")
	var field := HeightField.new(20260903)
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	var here := _open_meadow(mounts, field)
	var horse := MountKinds.horse_id(0)
	var bike := &"bicycle:0"

	# 1. The host keeps a machine both children got on; a guest gives way.
	_expect(Session.gives_way_on_a_mount(true, Session.HOST_ID), "a guest gives way to the host on a machine both are on")
	_expect(not Session.gives_way_on_a_mount(false, 2), "the host never gives way to a guest")
	_expect(not Session.gives_way_on_a_mount(true, 3), "and a guest does not give way to another guest on the host's say-so")
	mounts.place(horse, here)
	_expect(mounts.mount(horse), "this child gets on the horse")
	_expect(not mounts.ride_remote(horse, here + Vector3(0.0, 0.0, 1.0), 0.0), "the other child's claim does not take it from under them")
	mounts.dismount(here, 0.0)
	_expect(mounts.ride_remote(horse, here, 0.0), "once off, the other child's claim is taken")
	mounts.release_remote(horse)
	var main_source := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	_expect(main_source.contains("Session.gives_way_on_a_mount(session.is_following(), id)"), "the game asks who gives way when the claims meet")
	_expect(main_source.contains("hud.announce(Text.of(\"say_mount_taken\")"), "and the child who gives way is told, gently")
	_expect(Text.of("say_mount_taken") != "say_mount_taken", "with words for it")

	# 2. A machine left or let go of on another, or in a built piece, is moved.
	mounts.place(bike, here)
	var wall_at := here + Vector3(40.0, 0.0, 0.0)
	mounts.in_the_way.append(func(at: Vector3, radius: float) -> bool: return Vector2(at.x - wall_at.x, at.z - wall_at.z).length() < 3.0 + radius)
	mounts.park_remote(horse, here + Vector3(0.2, 0.0, 0.0), 0.0)
	_expect(mounts.spot_is_clear(horse, mounts.position_of(horse)), "a machine left on another is set down clear of it")
	var told := here + Vector3(0.2, 0.0, 0.0)
	mounts.park_remote(horse, told, 0.0, true)
	_expect(Vector2(mounts.position_of(horse).x - told.x, mounts.position_of(horse).z - told.z).length() < 0.01, "the host's own spot is taken exactly, as it is on both phones")
	mounts.park_remote(horse, wall_at, 0.0)
	_expect(mounts.spot_is_clear(horse, mounts.position_of(horse)), "a machine left in a built piece comes out of it")
	mounts.ride_remote(horse, here, 0.0)
	mounts.release_remote(horse)
	_expect(mounts.spot_is_clear(horse, mounts.position_of(horse)), "and so is one let go of on another machine")
	var far := mounts.position_of(horse)
	mounts.park_remote(horse, Vector3(9.0e6, 0.0, 0.0), 0.0)
	_expect(mounts.position_of(horse) == far, "a spot outside the world is not believed")

	# 3. A save with places no valley has, or with a house on the spot.
	var saved := {
		"bicycle:1": [1.0e9, 0.0, -1.0e9, 0.0],
		"bicycle:2": [NAN, 0.0, 0.0, 0.0],
		"bicycle:3": [wall_at.x, 0.0, wall_at.z, 0.0],
	}
	var loaded := Mounts.new(field)
	get_root().add_child(loaded)
	loaded.in_the_way.append(func(at: Vector3, radius: float) -> bool: return Vector2(at.x - wall_at.x, at.z - wall_at.z).length() < 3.0 + radius)
	loaded.from_data(saved)
	var edge := loaded.position_of(&"bicycle:1")
	_expect(loaded.exists(&"bicycle:1") and absf(edge.x) <= RespawnSpot.WORLD_HALF and absf(edge.z) <= RespawnSpot.WORLD_HALF, "a mount saved at a million kilometres is brought back inside the world")
	_expect(not loaded.exists(&"bicycle:2"), "and one saved at no number at all is dropped")
	_expect(loaded.exists(&"bicycle:3") and loaded.spot_is_clear(&"bicycle:3", loaded.position_of(&"bicycle:3")), "a mount saved where a house now stands is moved to clear ground")
	loaded.queue_free()

	# 4. A machine with nowhere clear is not asked about every frame.
	var asked := [0]
	var jammed := Mounts.new(field)
	get_root().add_child(jammed)
	jammed.place(horse, here)
	jammed.mount(horse)
	jammed.in_the_way.append(func(_at: Vector3, _radius: float) -> bool:
		asked[0] += 1
		return true)
	jammed.dismount(here, 0.0)
	asked[0] = 0
	for frame in 120:
		jammed.watch(here + Vector3(0.0, 0.0, -20.0))
	_expect(asked[0] <= 2, "a machine with nowhere clear asks %d times in 120 frames (at most 2)" % asked[0])
	_expect(not jammed.is_solid(horse), "and stays unsolid while it is blocked")
	jammed.in_the_way.clear()
	jammed._found_blocked_at[horse] = Time.get_ticks_msec() - Mounts.RECHECK_MSEC - 1
	jammed.watch(here + Vector3(0.0, 0.0, -20.0))
	_expect(jammed.is_solid(horse), "and is solid soon after the ground clears")
	jammed.queue_free()
	mounts.queue_free()

## The per-frame costs that were found by measuring the busy places (see
## src/dev/perf_log.gd for the numbers the phone reports): the mounts' grazing,
## the pickups' reach, the crickets, the far ducks, the coaster standing at its
## platform and the animals' nearest-to-care. Each is work that used to be done
## every frame and is now done on change, and each must give the answer it
## always gave.
func _check_the_busy_frame_does_its_work_on_change() -> void:
	print("the busy frame does its work on change")
	# Once the tree is running: a node added during _initialize is not yet in it,
	# and a mount asked for its place there answers with nothing.
	await process_frame
	var field := HeightField.new(20260903)

	# Mounts: the parts of each are found once, at placing, and the loops walk
	# only the horses and the boats.
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	var camp := field.camp_centre()
	for index in 3:
		mounts.place(MountKinds.horse_id(index), camp + Vector3(6.0 * float(index), 0.0, 0.0))
	mounts.place(MountKinds.boat_id(0), camp + Vector3(0.0, 0.0, 30.0))
	mounts.place(MountKinds.BICYCLE, camp + Vector3(-8.0, 0.0, 0.0))
	_expect(
		mounts._horses.size() == 3 and mounts._boats.size() == 1 and mounts._rigs.size() == 5,
		"the mounts know their horses and boats from placing: %d, %d, %d rigs" % [
			mounts._horses.size(), mounts._boats.size(), mounts._rigs.size()
		]
	)
	mounts.place(MountKinds.horse_id(1), camp + Vector3(6.0, 0.0, 2.0))
	_expect(
		mounts._horses.size() == 3 and mounts._rigs.size() == 5,
		"placing a horse again does not list it twice"
	)
	# `blocks` agrees with the plain distance to every mount.
	var agree := true
	var probe_rng := RandomNumberGenerator.new()
	probe_rng.seed = 5
	for _i in 300:
		var x := camp.x + probe_rng.randf_range(-14.0, 20.0)
		var z := camp.z + probe_rng.randf_range(-6.0, 36.0)
		var plain := false
		for id: StringName in [MountKinds.horse_id(0), MountKinds.horse_id(1), MountKinds.horse_id(2), MountKinds.boat_id(0), MountKinds.BICYCLE]:
			var at := mounts.node_of(id).global_position
			if Vector2(x - at.x, z - at.z).length() < MountKinds.girth(id) + 0.55:
				plain = true
		if mounts.blocks(x, z, 0.55) != plain:
			agree = false
	_expect(agree, "blocks() gives the answer the plain distance gives")

	# Grazing far from the child is stepped in longer, rarer steps; near, as ever.
	mounts.watch(camp)
	var far_id := MountKinds.horse_id(2)
	mounts.place(far_id, camp + Vector3(200.0, 0.0, 0.0))
	mounts.watch(camp)
	# Horse 1, not 0: the first looks up for its first two and a half seconds,
	# and a head held level does not move.
	var near_head := mounts.node_of(MountKinds.horse_id(1)).get_node("Body/Head") as Node3D
	var far_head := mounts.node_of(far_id).get_node("Body/Head") as Node3D
	var near_moves := 0
	var far_moves := 0
	var last_near := near_head.rotation.x
	var last_far := far_head.rotation.x
	for _frame in 40:
		mounts._process(1.0 / 60.0)
		if near_head.rotation.x != last_near:
			near_moves += 1
		if far_head.rotation.x != last_far:
			far_moves += 1
		last_near = near_head.rotation.x
		last_far = far_head.rotation.x
	_expect(near_moves >= 38, "a horse beside the child grazes every frame (%d of 40)" % near_moves)
	_expect(far_moves <= 11 and far_moves >= 1, "a horse 200 m off grazes about every fourth frame (%d of 40)" % far_moves)
	# And it ends up where the every-frame horse would: the same head angle to
	# within a hair after a few seconds.
	var reference := Mounts.new(field)
	get_root().add_child(reference)
	reference.place(far_id, camp + Vector3(200.0, 0.0, 0.0))
	var reference_head := reference.node_of(far_id).get_node("Body/Head") as Node3D
	for _frame in 400:
		mounts._process(1.0 / 60.0)
		reference._process(1.0 / 60.0)
	# 400 more frames each, on top of the 40: the reference ran 400, so give it
	# the 40 that the far horse had already had.
	for _frame in 40:
		reference._process(1.0 / 60.0)
	_expect(
		absf(far_head.rotation.x - reference_head.rotation.x) < 0.2,
		"the far horse's head is where an every-frame horse's is, to %.3f rad" % absf(far_head.rotation.x - reference_head.rotation.x)
	)
	mounts._forget(far_id)
	_expect(not mounts._rigs.has(far_id) and not mounts._horses.has(far_id), "a mount sold is forgotten by the rigs too")
	mounts.queue_free()
	reference.queue_free()

	# Pickups: the child standing or walking far from every pickup is measured
	# against none of them, and still takes what they walk onto.
	var pickups := Pickups.new(field, 20260903)
	get_root().add_child(pickups)
	var spawn := field.find_spawn_point()
	pickups.follow(spawn)
	for _i in 200:
		pickups._process(0.016)
		if pickups.is_idle():
			break
	var reference_left: Array[Vector3] = []
	var ids_left := {}
	for record in pickups._active:
		reference_left.append(record["position"])
		ids_left[record["id"]] = record["position"]
	var taken_log: Array = []
	pickups.taken_here.connect(func(id: String) -> void: taken_log.append(id))
	var scans_before := pickups.reach_scans()
	var walker := spawn
	var expected_ids := {}
	var weighted_reach := Pickups.REACH
	for step in 600:
		walker += Vector3(0.12, 0.0, 0.07)
		for id: String in ids_left.keys():
			var offset: Vector3 = ids_left[id] - walker
			offset.y *= 0.5
			if offset.length() <= weighted_reach and not expected_ids.has(id):
				expected_ids[id] = true
		pickups.check_reach(walker)
	_expect(
		taken_log.size() == expected_ids.size() and taken_log.all(func(id: String) -> bool: return expected_ids.has(id)),
		"walking 600 steps takes exactly the %d pickups that come within reach (took %d)" % [expected_ids.size(), taken_log.size()]
	)
	var scans := pickups.reach_scans() - scans_before
	_expect(scans < 150, "and measured them in %d full looks, not 600" % scans)
	var still := pickups.reach_scans()
	var far_off := Vector3(9000.0, 0.0, 9000.0)
	for _i in 120:
		pickups.check_reach(far_off)
	_expect(pickups.reach_scans() - still <= 1, "a child far from every pickup is looked at once, not every frame (%d looks)" % (pickups.reach_scans() - still))
	pickups.queue_free()

	# Ambience: no crickets are looked for by day, and by night the nine squares
	# are looked up once per square the child stands in.
	var ambience := Ambience.new()
	get_root().add_child(ambience)
	for _i in 30:
		ambience.follow(spawn, field, null, 0.0, 1.0 / 60.0)
	_expect(ambience.cricket_refreshes() == 0, "by day the crickets are not looked for")
	for _i in 30:
		ambience.follow(spawn, field, null, 0.9, 1.0 / 60.0)
	_expect(ambience.cricket_refreshes() == 1, "by night they are looked up once for the square the child is in (%d)" % ambience.cricket_refreshes())
	_expect(
		is_equal_approx(ambience._cricket_near_cached(spawn, field), Ambience.cricket_near(spawn, field)),
		"and the answer is the one the plain search gives"
	)
	ambience.follow(spawn + Vector3(Ambience.CRICKET_CELL * 2.0, 0.0, 0.0), field, null, 0.9, 1.0 / 60.0)
	_expect(ambience.cricket_refreshes() == 2, "and looked up again on crossing into another square")
	ambience.queue_free()

	# Ducks: a camera far off steps them every fourth frame; one beside them,
	# every frame.
	var ducks := Ducks.new()
	get_root().add_child(ducks)
	ducks.settle(20260903, field)
	var camera := Camera3D.new()
	get_root().add_child(camera)
	camera.global_position = ducks.duck_position(0) + Vector3(300.0, 20.0, 0.0)
	camera.make_current()
	var far_steps := 0
	var last := ducks.duck_position(0)
	for _frame in 40:
		ducks._process(1.0 / 60.0)
		var now := ducks.duck_position(0)
		if now != last:
			far_steps += 1
		last = now
	_expect(far_steps <= 11 and far_steps >= 1, "ducks far from the eye are paddled every fourth frame (%d of 40)" % far_steps)
	camera.global_position = ducks.duck_position(0) + Vector3(5.0, 3.0, 0.0)
	var near_steps := 0
	for _frame in 40:
		ducks._process(1.0 / 60.0)
		var now := ducks.duck_position(0)
		if now != last:
			near_steps += 1
		last = now
	_expect(near_steps >= 39, "and ducks beside it every frame (%d of 40)" % near_steps)
	camera.queue_free()
	ducks.queue_free()

	# The coaster standing at its platform puts its cars down once, not every tick.
	var coaster := RollerCoaster.new(Vector3.ZERO)
	get_root().add_child(coaster)
	var placed := coaster.placements()
	coaster._waiting = 5.0
	var cars_at := coaster.car_at(0).global_transform
	for _i in 60:
		coaster._physics_process(1.0 / 60.0)
	_expect(coaster.placements() == placed, "a train waiting at the platform is not re-placed (%d placements)" % (coaster.placements() - placed))
	_expect(coaster.car_at(0).global_transform.is_equal_approx(cars_at), "and has not moved")
	coaster._waiting = 0.0
	coaster._speed = 5.0
	for _i in 10:
		coaster._physics_process(1.0 / 60.0)
	_expect(coaster.placements() - placed == 10, "but a moving one is placed on every tick (%d of 10)" % (coaster.placements() - placed))
	coaster.queue_free()

	# The animals: the nearest that can be cared for is still the nearest.
	var animals := Animals.new(field, 20260903)
	get_root().add_child(animals)
	var inventory := Inventory.new()
	inventory.add(ItemKinds.CHOCOLATE, 1)
	var holder := Node3D.new()
	animals.add_child(holder)
	var kinds: Array[StringName] = [AnimalKinds.SQUIRREL, AnimalKinds.CAT, AnimalKinds.DOG]
	for index in 12:
		var node := Node3D.new()
		holder.add_child(node)
		node.position = Vector3(float(index) * 0.7, 0.0, 4.0 + float(index % 3) * 0.6)
		animals._living.append({
			"kind": kinds[index % 3], "node": node, "cooldown": 0.0 if index != 5 else 9.0,
			"home": node.position, "target": node.position, "tile": Vector2i.ZERO,
			"rest": 1.0, "bob": 0.0, "heading": 0.0, "velocity": 0.0,
		})
	var from := Vector3(3.5, 0.0, 4.5)
	var best := -1
	var best_gap := Animals.REACH
	for index in animals._living.size():
		var candidate: Dictionary = animals._living[index]
		if float(candidate["cooldown"]) > 0.0:
			continue
		var wanted := AnimalKinds.want(candidate["kind"])
		if wanted != &"" and inventory.count(wanted) <= 0 and not animals.is_thirsty(candidate):
			continue
		var gap := (candidate["node"] as Node3D).position.distance_to(from)
		if gap <= best_gap:
			best_gap = gap
			best = index
	var found := animals.nearest_caring(from, inventory)
	_expect(
		(best < 0 and found.is_empty()) or (best >= 0 and found == animals._living[best]),
		"the animal nearest to care for is the one a plain scan finds (index %d)" % best
	)
	_expect(best >= 0, "and there was one in reach to find")
	animals.queue_free()

## One child per name, a rename that takes every file with it, and a handover
## that cannot write one child's afternoon into another's save.
##
## "Amir  Ali" (two spaces) and "Amir Ali" were two children with two files that
## looked the same on screen; a child could not change the capitals of their own
## name, because their own old name counted as taken; a rename left the
## `.previous` copy behind when the save itself was absent, and skipped the
## whole move when anything sat at the new name, so the child came back to an
## empty valley. The game also moved the saving path to the new child in
## _become() and then let the autosave run in the gap before the reload.
func _check_profile_names_renames_and_handovers_keep_every_childs_files() -> void:
	print("profile names, renames and handovers keep every child's files")
	var had_index := FileAccess.file_exists(Profiles.INDEX)
	var index_was := FileAccess.get_file_as_string(Profiles.INDEX) if had_index else ""

	var family := Profiles.new()
	family.maps = {Profiles.HOME_MAP: Profiles.HOME_SEED}
	_expect(family.add_player("Zed Quill"), "a name with a space is added")
	_expect(not family.add_player("Zed  Quill"), "and the same with two spaces is the same child")
	_expect(not family.add_player("zed-quill"), "and so is one with a hyphen and other capitals")
	_expect(Profiles.tidy("  A   b ") == "A b", "tidying trims the ends and joins runs of spaces")

	var world_id := family.create_world(Profiles.HOME_MAP, "Zed Quill")
	var old_path := ProjectSettings.globalize_path(family.save_path_for("Zed Quill", world_id))
	var new_path := ProjectSettings.globalize_path(family.save_path_for("Zed Quillen", world_id))
	for leftover: String in [old_path, old_path + ".previous", new_path, new_path + ".previous"]:
		DirAccess.remove_absolute(leftover)
	# A crash between the two renames in SaveGame.write: only the copy is left.
	var only_previous := FileAccess.open(old_path + ".previous", FileAccess.WRITE)
	only_previous.store_string("{}")
	only_previous.close()
	# And something already sitting at the new name.
	var stray := FileAccess.open(new_path, FileAccess.WRITE)
	stray.store_string("{}")
	stray.close()
	var mine := FileAccess.open(old_path, FileAccess.WRITE)
	mine.store_string("{\"mine\": 1}")
	mine.close()

	_expect(family.rename_player("Zed Quill", "Zed Quillen"), "a child can be renamed")
	_expect(
		FileAccess.file_exists(new_path) and FileAccess.get_file_as_string(new_path).contains("mine"),
		"their own save is the one at the new name, not the stray that was there"
	)
	_expect(FileAccess.file_exists(new_path + ".previous"), "the copy beside it moved even though it travelled alone")
	_expect(not FileAccess.file_exists(old_path) and not FileAccess.file_exists(old_path + ".previous"), "nothing is left under the old name")

	_expect(family.rename_player("Zed Quillen", "zed quillen"), "a child may change the capitals of their own name")
	_expect(family.players.has("zed quillen"), "and it is stored as typed")
	_expect(family.add_player("Other Kid"), "a second child exists")
	_expect(not family.rename_player("zed quillen", "other kid"), "but nobody can take a sibling's name")

	# Removing the child the game is in hands it to someone who may enter it.
	family.choose_player("zed quillen")
	family.choose_world(world_id)
	var sibling_world := family.create_world(Profiles.HOME_MAP, "Other Kid")
	_expect(family.remove_player("zed quillen"), "a child can be removed")
	_expect(family.current_player == "Other Kid", "the game is handed to the child that is left")
	_expect(family.current_world_is_enterable(), "and to a valley that child may be in")
	_expect(family.current_world == sibling_world, "their own")

	# An index edited by hand cannot point a world at a path outside the folder.
	var hostile := FileAccess.open(Profiles.INDEX, FileAccess.WRITE)
	hostile.store_string(JSON.stringify({
		"version": Profiles.VERSION, "players": ["Ok"], "maps": {"../x": 5},
		"worlds": {"../../evil": {"map": "home", "owner": "Ok", "guests": []}},
	}))
	hostile.close()
	var reloaded := Profiles.new()
	reloaded.load_index()
	_expect(not reloaded.worlds.has("../../evil") and not reloaded.maps.has("../x"), "a world id or map name that climbs out of the folder is dropped")

	# The handover: after choosing the other child, nothing may write.
	var game := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var handover := game.substr(game.find("func _become"))
	handover = handover.substr(0, handover.find("\nfunc ", 1))
	_expect(
		handover.find("_may_save = false") > handover.find("_write_save()")
		and handover.find("_may_save = false") < handover.find("profiles.choose_player"),
		"the old child is saved first, then saving is switched off before the save path moves to the next child"
	)

	for leftover: String in [new_path, new_path + ".previous", old_path, old_path + ".previous", new_path + ".unreadable"]:
		DirAccess.remove_absolute(leftover)
	for each: String in family.worlds.keys():
		for who: String in ["Zed Quill", "Zed Quillen", "zed quillen", "Other Kid"]:
			DirAccess.remove_absolute(ProjectSettings.globalize_path(family.save_path_for(who, each)))
	if had_index:
		var restore := FileAccess.open(Profiles.INDEX, FileAccess.WRITE)
		if restore != null:
			restore.store_string(index_was)
			restore.close()
	else:
		DirAccess.remove_absolute(ProjectSettings.globalize_path(Profiles.INDEX))

## A phone put down for an hour hands the first frame back an hour long, which
## every animal, timer and the sky would take at its word; and its saplings
## should grow as they would have had the game been closed. A save is written
## when the game is put away, but never while the valley is still a blank one.
func _check_coming_back_from_the_background_holds_the_clock_and_grows_the_saplings() -> void:
	print("coming back from the background holds the clock and grows the saplings")
	var game: Node = (load("res://src/main.gd") as GDScript).new()
	var before := Engine.time_scale
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	_expect(Engine.time_scale == 0.0, "the first frames after a resume run on a stopped clock")
	game._process(0.0)
	_expect(Engine.time_scale == 0.0, "which is held for more than one frame")
	game._process(0.0)
	_expect(is_equal_approx(Engine.time_scale, before), "and given back at the speed it had")
	_expect(game._resume_hush_frames == 0, "with nothing left to count down")
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	game._process(0.0)
	game._process(0.0)
	_expect(is_equal_approx(Engine.time_scale, before), "a second resume before the first has ended does not keep the stopped clock")
	Engine.time_scale = before

	var field := HeightField.new(20260903)
	var structures := Structures.new(field)
	get_root().add_child(structures)
	var at := field.camp_centre() + Vector3(3.0, 0.0, 3.0)
	at.y = field.height_at(at.x, at.z)
	structures.place(BuildKinds.SAPLING, at, 0.0)
	var age_of := func() -> float:
		var found := 0.0
		for record in structures._records:
			found = maxf(found, float(record["age"]))
		return found
	game.structures = structures
	game.journal = Journal.new()
	var now := Time.get_unix_time_from_system()

	# Not ready: nothing is aged, and nothing is written.
	game._paused_at = now - 600.0
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	_expect(float(age_of.call()) == 0.0, "a resume before the valley is ready ages nothing")
	game._process(0.0)
	game._process(0.0)

	game._world_ready = true
	# A glance away.
	game._paused_at = now - 5.0
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	_expect(float(age_of.call()) == 0.0, "a few seconds in the background ages nothing")
	game._process(0.0)
	game._process(0.0)

	# An hour: as much as the start-up path grants, and no more.
	game._paused_at = now - 3600.0
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	game._process(0.0)
	game._process(0.0)
	_expect(
		is_equal_approx(float(age_of.call()), Structures.MAX_OFFLINE_GROWTH),
		"an hour in the background ages a sapling by the same capped amount as an hour with the game closed (%.0f s)" % float(age_of.call())
	)
	_expect(game.journal.last_seen >= int(now), "and the journal is told, so a restart does not count that time again")
	var aged := float(age_of.call())
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	game._process(0.0)
	game._process(0.0)
	_expect(float(age_of.call()) == aged, "a resume with no pause before it ages nothing twice")
	structures.queue_free()

	var source := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var at_write := source.find("func _write_save()")
	var writing := source.substr(at_write, source.find("\nfunc ", at_write + 1) - at_write)
	_expect(writing.contains("not _world_ready"), "no save is written before the valley is ready")
	game._notification(Node.NOTIFICATION_APPLICATION_PAUSED)
	_expect(game._paused_at > 0.0, "the moment of putting the phone down is kept")
	_expect(
		source.contains("what == NOTIFICATION_APPLICATION_PAUSED\n\t):\n\t\t_write_save()"),
		"and being put away writes the save"
	)
	game.free()

## Nothing solid goes up on the child, an animal or a parked machine, for one
## piece or a whole plan; what is walked over still can.
func _check_nothing_solid_is_built_on_anyone() -> void:
	print("nothing solid is built on the child, an animal or a parked machine")
	const TestHouse := preload("res://src/dev/test_house.gd")
	var yard := _a_yard(300)
	var origin: Vector3 = yard["origin"]
	var build: BuildMode = yard["build"]
	var structures: Structures = yard["structures"]
	var field: HeightField = yard["field"]
	if not origin.is_finite():
		_fail("no ground near the spawn to build on")
		_free_the_yard(yard)
		return
	var stand := Vector3(origin.x, field.height_at(origin.x, origin.z + BuildMode.REACH), origin.z + BuildMode.REACH)
	var here := [Vector3.ZERO]
	var radius := [Player.RADIUS]
	for kind: StringName in [HouseParts.WALL, HouseParts.TABLE, BuildKinds.FENCE]:
		build.select(kind)
		build.set_body_finder(func(_at: Vector3, _reach: float) -> Array[Vector4]:
			return [])
		build.aim(stand, 0.0)
		var aimed := build.target()
		here[0] = aimed
		build.set_body_finder(func(_at: Vector3, _reach: float) -> Array[Vector4]:
			return [Vector4(here[0].x, here[0].y, here[0].z, radius[0])])
		build.aim(stand, 0.0)
		_expect(
			not build._valid and build._reason == Text.of("why_someone"),
			"%s is refused on a body standing on it: %s" % [kind, build._reason]
		)
		_expect(not build.place() and structures.positions().is_empty(), "and the tap builds nothing")
		# A body well clear of it does not matter.
		here[0] = aimed + Vector3(6.0, 0.0, 0.0)
		build.set_body_finder(build.body_finder)  # forget the answer given a moment ago
		build.aim(stand, 0.0)
		_expect(build._reason != Text.of("why_someone"), "%s is not refused for a body six metres off" % kind)
	# What is walked over is allowed, even on top of somebody.
	here[0] = origin
	for kind: StringName in [HouseParts.FLOOR, HouseParts.RUG, BuildKinds.PATH]:
		build.select(kind)
		build.aim(stand, 0.0)
		here[0] = build.target()
		build.aim(stand, 0.0)
		_expect(build._reason != Text.of("why_someone"), "%s may be laid under a body: %s" % [kind, build._reason])
	# A machine, asked by the game's own question (Mounts.blocks).
	build.select(HouseParts.WALL)
	build.set_body_finder(Callable())
	build.set_mount_finder(func(_at: Vector3, _margin: float) -> bool:
		return true)
	build.aim(stand, 0.0)
	_expect(not build._valid and build._reason == Text.of("why_someone"), "a wall is refused on a parked machine: %s" % build._reason)
	build.select(HouseParts.FLOOR)
	build.aim(stand, 0.0)
	_expect(build._reason != Text.of("why_someone"), "but a floor may go under one")
	build.set_mount_finder(Callable())
	# A whole plan, with the child at its front wall.
	build.select(Plans.SHOP)
	build.aim(stand, 0.0)
	var in_wall := Vector3.INF
	for piece: Dictionary in build._plan_pieces:
		if Structures.holds_a_body_out(piece["kind"]):
			in_wall = piece["position"]
			break
	_expect(in_wall.is_finite(), "the shop has a solid piece to stand in")
	here[0] = in_wall
	build.set_body_finder(func(_at: Vector3, _reach: float) -> Array[Vector4]:
		return [Vector4(here[0].x, here[0].y, here[0].z, radius[0])])
	build.aim(stand, 0.0)
	_expect(not build._valid and build._reason == Text.of("why_someone"), "a shop is refused with the child in its wall: %s" % build._reason)
	_expect(not build.place() and structures.positions().is_empty(), "and none of it goes up")
	# Moves away: the same plan goes up, and the finder is asked afresh for the tap.
	here[0] = in_wall + Vector3(40.0, 0.0, 0.0)
	build.set_body_finder(build.body_finder)
	_expect(TestHouse.build_plan(build, field, origin, Plans.SHOP), "with the child out of the way the shop goes up")
	_expect(Text.of("why_someone") != "why_someone", "and the refusal has words")
	_free_the_yard(yard)

## A solid piece from the other phone is never refused (the two would stop
## agreeing), so it is the child who is set beside it.
func _check_a_remote_piece_on_the_child_sets_them_beside_it() -> void:
	print("a piece from the other phone that lands on the child sets them beside it")
	var space := get_root().world_3d.direct_space_state
	var at := Vector3(10.0, 3.0, 10.0)
	var body := Vector3(10.05, 3.0, 10.02)
	_expect(Structures.body_overlaps(HouseParts.WALL, at, 0.0, body, Player.RADIUS), "a child on the line of a wall is in it")
	_expect(not Structures.body_overlaps(HouseParts.FLOOR, at, 0.0, body, Player.RADIUS), "a floor is walked over")
	_expect(not Structures.body_overlaps(HouseParts.WALL, at, 0.0, Vector3(10.0, 3.0, 12.0), Player.RADIUS), "a child two metres off is not")
	for kind: StringName in [HouseParts.WALL, HouseParts.TABLE, BuildKinds.FENCE, HouseParts.POST]:
		for spin: float in [0.0, 0.7, PI * 0.5]:
			var spot := Structures.exit_beside(kind, at, spin, body, space, TerrainSpec.LAYER_GROUND | TerrainSpec.LAYER_PROPS, [])
			_expect(
				not Structures.body_overlaps(kind, at, spin, spot, Player.RADIUS) and spot.distance_to(body) < 2.5,
				"%s turned %.1f sets the child beside it, close by (%.2f m)" % [kind, spin, spot.distance_to(body)]
			)
	var source := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var built := source.substr(source.find("func _on_remote_built"))
	built = built.substr(0, built.find("\nfunc ", 1))
	_expect(
		built.contains("_step_out_of_a_remote_piece(") and built.find("_step_out_of_a_remote_piece(") > built.find("structures.place("),
		"the other child's piece is placed, then the child is moved clear of it"
	)

## An animal is not born inside a wall the child has built, and leaving it out
## does not change who else is born where (both phones must agree).
func _check_an_animal_is_not_born_in_a_built_piece() -> void:
	print("an animal is not born in a built piece, and the rest of the tile is unchanged")
	var field := HeightField.new(20260903)
	var free := Animals.new(field, 20260903)
	get_root().add_child(free)
	var coord := Vector2i.ZERO
	var found := false
	for x in range(-6, 7):
		for y in range(-6, 7):
			free._build_tile(Vector2i(x, y))
			if free._living.size() >= 3 and not found:
				coord = Vector2i(x, y)
				found = true
	if not found:
		_fail("no tile with three animals to test")
		free.free()
		return
	var all: Array[Vector3] = []
	var headings: Dictionary = {}
	for animal: Dictionary in free._living:
		if animal["tile"] == coord:
			all.append(animal["born"])
			headings[animal["born"]] = animal["heading"]
	var victim := all[0]
	free.free()
	var walled := Animals.new(field, 20260903)
	walled.built_blocks = func(at: Vector3, _radius: float) -> bool:
		return Vector2(at.x - victim.x, at.z - victim.z).length() < 0.05
	get_root().add_child(walled)
	walled._build_tile(coord)
	var born: Array[Vector3] = []
	for animal: Dictionary in walled._living:
		born.append(animal["born"])
	_expect(not born.has(victim), "the animal that would have been born in the wall is not")
	_expect(born.size() == all.size() - 1, "and only that one: %d of %d" % [born.size(), all.size()])
	for spot in born:
		_expect(headings.get(spot, -1.0) == (walled._living[born.find(spot)]["heading"]), "the others are born where and as they were")
	walled.free()

## A three-year-old tapping at random must never destroy anything.
##
## The whole game, booted on a fixed seed with saving off, is given a child with
## a lot to lose, and short taps (a tenth to a third of a second) are delivered
## at random to every visible button, to the stick and to anywhere on the screen,
## near home, with the build palette open and shut, at a campfire, at the
## fairground kiosk with its question showing, and with the settings open. Coins,
## things owned, items in the bag, built pieces, planted trees, felled trees and
## standing machines must all be as they were, the child must not end up under the
## ground or unable to walk, and a hold that is made on purpose must still work.
## This is the short run, kept near home so it fits the suite; the stand-alone
## `src/dev/toddler_fuzz_run.gd` takes thousands of frames and also goes to the
## cafe and the shop. Every loss it finds is printed with the tap that caused it.
func _check_a_toddler_tapping_at_random_loses_nothing() -> void:
	print("a toddler tapping at random loses nothing")
	var fuzz = preload("res://src/dev/toddler_fuzz.gd").new()
	await fuzz.run(self, 420, false, [&"home", &"home_building", &"campfire", &"fairground", &"settings", &"pitch", &"ride"])
	_expect(int(fuzz.report.get("taps", 0)) >= 40, "the fuzz really tapped (%d taps)" % int(fuzz.report.get("taps", 0)))
	_expect(int(fuzz.report.get("holds_completed", 0)) >= 1, "and a hold made on purpose still went through")
	_expect(int(fuzz.report.get("house_pieces", 0)) > 10, "the child had a house to lose (%d pieces)" % int(fuzz.report.get("house_pieces", 0)))
	for line: String in fuzz.failures:
		_fail(line)
	_expect(fuzz.failures.is_empty(), "the child lost nothing and was never stuck")
## However the child stands, faces and looks, and however long or short the hold,
## the kick and the dotted aim line it is drawn from are finite and never empty:
## a NaN there once would put dots, ring and ball at nowhere.
func _check_the_kick_aim_is_finite_for_any_stance() -> void:
	print("the kick aim is finite and drawn for any stance")
	var ground := func(_x: float, _z: float) -> float: return 0.0
	var bad := 0
	var spots: Array[Vector3] = [Vector3(0.0, 0.24, 0.0), Vector3(3.0, 0.24, 1.0)]
	var dirs: Array[Vector3] = [Vector3.ZERO, Vector3(0.0, 0.0, -1.0), Vector3(0.0, 1.0, 0.0)]
	var strengths: Array[float] = [0.0, 0.12, 1.0, 5.0, -1.0]
	var lofts: Array[float] = [-1.0, 0.0, 1.0, 9.0]
	for at: Vector3 in spots:
		for facing: Vector3 in dirs:
			for look: Vector3 in dirs:
				for strength: float in strengths:
					for loft: float in lofts:
						var v := Ball.launch_velocity(at, Vector3.ZERO, facing, true, strength, loft, look)
						var path := Ball.aim_path(at, v, 0.3, 9.8, ground)
						if not v.is_finite() or path.is_empty():
							bad += 1
						for point: Vector3 in path:
							if not point.is_finite():
								bad += 1
	_expect(bad == 0, "no stance gives a NaN or an empty aim line (%d bad)" % bad)

## The three buttons the fuzz found that a tap could spend something through:
## a log on the fire, a stick to the dam, and the axe on a wild tree while there
## are coins in the purse to be charged for it.
func _check_a_stray_tap_does_not_burn_wood_or_give_sticks_or_fell_for_coins() -> void:
	print("a stray tap does not burn wood, give a stick to the dam, or fell a tree that costs coins")
	var hud := Hud.new()
	get_root().add_child(hud)
	await process_frame
	var emitted := {"fire": 0, "dam": 0, "chop": 0}
	hud.fire_fed.connect(func() -> void: emitted["fire"] += 1)
	hud.dam_stick.connect(func() -> void: emitted["dam"] += 1)
	hud.chop_pressed.connect(func() -> void: emitted["chop"] += 1)
	hud.set_coins(10)
	hud.set_tree_in_reach(true, false)
	# Shown, because a ring lets go of a button that is hidden under a finger.
	hud.set_fire_offer(true)
	hud.set_dam_offer(true)
	for pair: Array in [["fire", hud._fire_button], ["dam", hud._dam_button], ["chop", hud._chop_button]]:
		var button: Button = pair[1]
		button.pressed.emit()
		_expect(int(emitted[pair[0]]) == 0, "a tap on the %s button does nothing" % pair[0])
		var ring: HoldRing = null
		for child in button.get_children():
			if child is HoldRing:
				ring = child
		_expect(ring != null, "the %s button has a hold ring" % pair[0])
		if ring == null:
			continue
		button.button_down.emit()
		ring._process(HoldRing.SECONDS + 0.1)
		button.button_up.emit()
		_expect(int(emitted[pair[0]]) == 1, "and holding it does the thing")
	# With nothing in the purse to be charged, a wild tree is still a tap.
	hud.set_coins(0)
	emitted["chop"] = 0
	hud._chop_button.pressed.emit()
	_expect(int(emitted["chop"]) == 1, "a wild tree costs nothing with no coins, so a tap still fells it")
	hud.queue_free()

## Every hold lets go when the touch does, however the touch ends: a finger
## that lifts early, slides off, is taken by the system, or loses the button
## under it; a second finger leaves it alone; and a hold that has fired does
## not fire again.
func _check_every_hold_lets_go_when_the_touch_does() -> void:
	print("every hold lets go when the touch does")
	var hud := Hud.new()
	get_root().add_child(hud)
	await process_frame
	var fired: Array = []
	hud.place_used.connect(func() -> void: fired.append(&"visit"))
	hud.snack_pressed.connect(func() -> void: fired.append(&"snack"))
	hud.set_place_offer(Places.CAFE)
	var visit: Button = hud._visit_button
	var snack: Button = hud._snack_button
	var ring: HoldRing = hud._visit_ring
	var snack_ring: HoldRing = null
	for child in snack.get_children():
		if child is HoldRing:
			snack_ring = child
	_expect(snack_ring != null, "the snack button has a ring")
	if snack_ring == null:
		hud.queue_free()
		return
	var inside := InputEventMouseMotion.new()
	inside.position = visit.size * 0.5
	var outside := InputEventMouseMotion.new()
	outside.position = visit.size + Vector2(200.0, 200.0)

	# Sliding off the button while holding it.
	visit.button_down.emit()
	ring._process(0.5)
	visit.gui_input.emit(inside)
	_expect(ring.is_holding(), "moving about on the button keeps the hold")
	visit.gui_input.emit(outside)
	_expect(not ring.is_holding() and ring.progress == 0.0, "sliding off empties the ring")
	ring._process(2.0)
	visit.button_up.emit()
	_expect(fired.is_empty(), "and nothing fires, however long the finger stays down")
	var drag := InputEventScreenDrag.new()
	drag.position = outside.position
	visit.button_down.emit()
	visit.gui_input.emit(drag)
	_expect(not ring.is_holding(), "a touch drag off the button does the same")
	visit.button_up.emit()

	# The system takes the touch away.
	for what: int in [
		Node.NOTIFICATION_APPLICATION_PAUSED,
		Node.NOTIFICATION_APPLICATION_FOCUS_OUT,
		Node.NOTIFICATION_WM_WINDOW_FOCUS_OUT,
	]:
		visit.button_down.emit()
		ring._process(0.5)
		ring.propagate_notification(what)
		_expect(not ring.is_holding() and ring.progress == 0.0, "notification %d empties the ring" % what)
		ring._process(2.0)
		visit.button_up.emit()
	visit.button_down.emit()
	var cancelled := InputEventScreenTouch.new()
	cancelled.canceled = true
	visit.gui_input.emit(cancelled)
	_expect(not ring.is_holding(), "a cancelled touch empties the ring")
	visit.button_up.emit()
	_expect(fired.is_empty(), "nothing has fired from any of them")

	# Hidden, greyed or freed while held.
	visit.button_down.emit()
	ring._process(0.5)
	visit.visible = false
	_expect(not ring.is_holding(), "hiding the button empties the ring at once")
	visit.visible = true
	ring._process(2.0)
	visit.button_up.emit()
	visit.button_down.emit()
	visit.disabled = true
	ring._process(0.1)
	_expect(not ring.is_holding(), "greying the button empties the ring")
	visit.disabled = false
	visit.button_up.emit()
	visit.button_down.emit()
	ring._process(0.5)
	var parent := visit.get_parent()
	parent.visible = false
	_expect(not ring.is_holding(), "hiding what the button is in empties the ring")
	parent.visible = true
	visit.button_up.emit()
	_expect(fired.is_empty(), "and none of that fired anything")

	# A second finger elsewhere is another button's business.
	visit.button_down.emit()
	ring._process(0.5)
	snack.button_down.emit()
	snack.button_up.emit()
	_expect(ring.is_holding() and absf(ring.progress - 0.5) < 0.01, "a second finger on another button leaves this hold at %.2f" % ring.progress)
	snack_ring.cancel()
	ring.propagate_notification(CanvasItem.NOTIFICATION_VISIBILITY_CHANGED)
	_expect(ring.is_holding(), "and another ring being cancelled leaves it alone")
	ring._process(0.6)
	_expect(fired == [&"visit"], "it completes by itself, once")
	visit.button_up.emit()

	# Once fired, holding on does nothing more; a full release rearms it.
	fired.clear()
	visit.button_down.emit()
	for _step in 8:
		ring._process(0.5)
	_expect(fired == [&"visit"], "holding for four seconds fires once, not %d times" % fired.size())
	visit.button_up.emit()
	visit.button_down.emit()
	ring._process(1.1)
	visit.button_up.emit()
	_expect(fired.size() == 2, "a fresh hold after a full release fires again")

	# One long touch cannot finish two buttons. The engine keeps a drag with
	# the button it began on, so the second never sees a button_down; and the
	# first has already been emptied by sliding off.
	fired.clear()
	visit.button_down.emit()
	ring._process(0.9)
	visit.gui_input.emit(outside)
	snack_ring._process(0.5)
	ring._process(0.5)
	snack_ring._process(0.6)
	visit.button_up.emit()
	snack.button_up.emit()
	_expect(fired.is_empty(), "sliding from one held button across another completes neither")

	# The interface is rebuilt under a finger, as a change of language does.
	var old_ring := ring
	visit.button_down.emit()
	ring._process(0.9)
	hud.queue_free()
	old_ring._process(0.5)
	_expect(not old_ring.is_holding() and fired.is_empty(), "a HUD waiting to be freed completes nothing")
	await process_frame

	# The reset in the settings is a ring like the others, five seconds long.
	var settings := Hud.new()
	get_root().add_child(settings)
	await process_frame
	var resets: Array = []
	settings.reset_requested.connect(func() -> void: resets.append(1))
	var reset: Button = settings._reset_button
	var reset_ring: HoldRing = settings._reset_ring
	_expect(reset_ring != null and is_equal_approx(reset_ring.seconds, Hud.RESET_HOLD), "the reset holds on a ring for RESET_HOLD seconds")
	if reset_ring != null:
		settings._danger.visible = true
		reset.button_down.emit()
		reset_ring._process(2.0)
		settings._process(0.0)
		_expect(reset.text != Text.of("ui_reset_hold"), "the count shows while it is held")
		reset.gui_input.emit(_motion_away(reset))
		reset_ring._process(10.0)
		settings._process(0.0)
		reset.button_up.emit()
		_expect(resets.is_empty() and reset.text == Text.of("ui_reset_hold"), "sliding off stops the reset and clears its count")
		reset.button_down.emit()
		reset_ring._process(2.0)
		reset_ring.propagate_notification(Node.NOTIFICATION_APPLICATION_PAUSED)
		reset_ring._process(10.0)
		reset.button_up.emit()
		_expect(resets.is_empty(), "a paused game stops the reset")
		reset.button_down.emit()
		reset_ring._process(2.0)
		settings._danger.visible = false
		_expect(not reset_ring.is_holding(), "closing the room stops the reset")
		reset.button_up.emit()
		settings._danger.visible = true
		reset.button_down.emit()
		for _step in 20:
			reset_ring._process(0.5)
		_expect(resets.size() == 1, "five seconds held asks for the reset once, not %d times" % resets.size())
		reset.button_up.emit()
		_expect(resets.size() == 1, "and letting go asks for nothing more")
	settings.queue_free()

func _motion_away(button: Control) -> InputEventMouseMotion:
	var event := InputEventMouseMotion.new()
	event.position = button.size + Vector2(300.0, 300.0)
	return event

## The café's doormat lies outside its walls, so the rule that kept grass off
## a floor (indoors) stopped at the wall and tufts came up on the mat and
## between the porch boards. Every tuft round the café and the shop is tested
## against the floor rule, and the mat and deck are tested directly.
func _check_no_grass_stands_on_a_doormat_or_porch() -> void:
	print("no grass stands on a doormat or porch")
	var field := HeightField.new(20260903)
	var camp := field.camp_centre()
	var cafe := PlaceSpec.centre_of(&"cafe", camp)
	var front_of_cafe := cafe.z + Places.CAFE_FRONT_Z
	_expect(
		PlaceSpec.on_floor(cafe.x, front_of_cafe - 0.5, camp)
		and PlaceSpec.on_floor(cafe.x + 0.85, front_of_cafe - 0.9, camp),
		"the café's doormat, all of it, counts as floor"
	)
	var shop := PlaceSpec.centre_of(&"shop", camp)
	var front_of_shop := shop.z + PlaceSpec.BUILDINGS[&"shop"][2] - Places.SHOP_DEPTH * 0.5
	_expect(
		PlaceSpec.on_floor(shop.x + Places.SHOP_WIDTH * 0.5 + 0.2, front_of_shop - 2.5, camp),
		"and so is the shop's porch deck, to its far corner"
	)
	_expect(
		not PlaceSpec.on_floor(cafe.x, front_of_cafe - 3.0, camp),
		"but the ground a few strides out from the door is not"
	)
	var counted := 0
	var on_floor := 0
	for place: StringName in [&"cafe", &"shop"]:
		var centre := PlaceSpec.centre_of(place, camp)
		var tile_x := int(floorf(centre.x / 32.0))
		var tile_z := int(floorf(centre.z / 32.0))
		for dx in range(-1, 2):
			for dz in range(-1, 2):
				var baked := VegetationTile.bake(field, Vector2i(tile_x + dx, tile_z + dz), 32, 20260903, null, true)
				for tuft: Transform3D in baked["grass"]:
					counted += 1
					var at := tuft.origin + Vector3((tile_x + dx) * 32, 0.0, (tile_z + dz) * 32)
					if PlaceSpec.on_floor(at.x, at.z, camp):
						on_floor += 1
	_expect(counted > 100, "there are %d tufts round the café and the shop to look at" % counted)
	_expect(on_floor == 0, "%d tufts stand on a floor, doormat or porch" % on_floor)

## The shared "keep clear" registry, on its own: rectangles (turned or not) and
## circles keep a margin, an owner forgets only its own claims, and a tile far
## from everything asks for nothing. Then the real thing: a tile whose whole
## area is claimed grows no grass, and grows it again once released.
func _check_clear_ground_keeps_grass_off_anything_registered() -> void:
	print("clear ground keeps grass off anything registered")
	ClearGround.forget_all()
	ClearGround.rect(&"test_a", Vector3(100.0, 0.0, 100.0), 2.0, 1.0)
	ClearGround.rect(&"test_a", Vector3(200.0, 0.0, 100.0), 4.0, 0.5, PI * 0.5)
	ClearGround.circle(&"test_b", Vector3(300.0, 0.0, 100.0), 3.0)
	_expect(ClearGround.count() == 3, "three claims are held (%d)" % ClearGround.count())
	_expect(
		ClearGround.kept_at(101.9, 100.9),
		"a corner inside a rectangle is kept clear"
	)
	_expect(
		ClearGround.kept_at(102.0 + ClearGround.MARGIN - 0.01, 100.0)
		and not ClearGround.kept_at(102.0 + ClearGround.MARGIN + 0.05, 100.0), "the margin reaches a tuft's width past the edge and no further"
	)
	# A rectangle turned a quarter turn is long in z, not in x.
	_expect(
		ClearGround.kept_at(200.0, 103.5) and not ClearGround.kept_at(203.5, 100.0),
		"a turned rectangle is turned"
	)
	_expect(ClearGround.kept_at(301.0, 102.0) and not ClearGround.kept_at(304.0, 100.0), "a circle is a circle")
	_expect(ClearGround.near(0.0, 0.0, 32.0, 32.0).is_empty(), "a tile far from every claim asks for nothing")
	ClearGround.forget(&"test_a")
	_expect(
		ClearGround.count() == 1 and not ClearGround.kept_at(100.0, 100.0),
		"an owner forgets its own claims and only those"
	)
	ClearGround.forget_all()

	var field := HeightField.new(20260903)
	var camp := field.camp_centre()
	var cafe := PlaceSpec.centre_of(&"cafe", camp)
	var best := Vector2i.ZERO
	var most := -1
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			var coord := Vector2i(int(floorf(cafe.x / 32.0)) + dx, int(floorf(cafe.z / 32.0)) + dz)
			var found: int = (VegetationTile.bake(field, coord, 32, 20260903, null, true)["grass"] as Array).size()
			if found > most:
				most = found
				best = coord
	_expect(most > 50, "the tile chosen has grass to remove (%d tufts)" % most)
	var centre := Vector3(float(best.x * 32 + 16), 0.0, float(best.y * 32 + 16))
	ClearGround.rect(&"test_c", centre, 16.0, 16.0)
	var covered: int = (VegetationTile.bake(field, best, 32, 20260903, null, true)["grass"] as Array).size()
	_expect(covered == 0, "a tile claimed whole grows %d tufts" % covered)
	ClearGround.forget(&"test_c")
	var released: int = (VegetationTile.bake(field, best, 32, 20260903, null, true)["grass"] as Array).size()
	_expect(released == most, "and grows its %d again once released (%d)" % [most, released])
	ClearGround.forget_all()

