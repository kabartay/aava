	_expect(Rect2(Vector2.ZERO, view).encloses(menu_box), "the settings panel with its new rows still fits the screen (%s in %s)" % [menu_box, view])
	hud.queue_free()

## How far the right thigh swings over a whole stride, with the rig driven at a
## steady speed.
func _thigh_swing(motion: RigMotion, rig: Node3D, pace: float) -> float:
	motion.speed = pace
	for _frame in 120:
		motion.step(1.0 / 60.0)
	var thigh := rig.find_child("ThighR", true, false) as Node3D
	var widest := 0.0
	for _frame in 90:
		motion.step(1.0 / 60.0)
		widest = maxf(widest, absf(thigh.rotation.x))
	return widest

func _check_the_characters_move_and_swim_the_right_way_up() -> void:
	print("the characters walk, kick and swim, and the other child moves by what is sent")
	# Every character: the foot swing grows with speed and stops when still.
	for which in Character.KEYS.size():
		var rig := Character.build(which, 1, 1, Visitors.SHIRTS[2])
		var motion := RigMotion.new(rig)
		var still := _thigh_swing(motion, rig, 0.0)
		var stroll := _thigh_swing(motion, rig, 1.0)
		var walk := _thigh_swing(motion, rig, Player.WALK_SPEED)
		var run := _thigh_swing(motion, rig, Player.RUN_SPEED)
		_expect(still < 0.01, "%s: standing still the legs do not swing (%.3f rad)" % [Character.KEYS[which], still])
		_expect(stroll > 0.1 and walk > stroll + 0.1 and run > walk + 0.1, "%s: the swing grows with speed: %.2f, %.2f, %.2f rad" % [Character.KEYS[which], stroll, walk, run])
		var stopped := _thigh_swing(motion, rig, 0.0)
		_expect(stopped < 0.01, "%s: and stops again when the child does (%.3f rad)" % [Character.KEYS[which], stopped])
		rig.free()

	# The kick: wound back while held, and at its peak in the frame the ball leaves.
	var kicker := Character.build(0, 0, 0, Visitors.SHIRTS[2])
	var kick := RigMotion.new(kicker)
	var leg := kicker.find_child("ThighR", true, false) as Node3D
	kick.winding = true
	kick.charge = 1.0
	for _frame in 40:
		kick.step(1.0 / 60.0)
	_expect(leg.rotation.x < -0.5, "holding the kick draws the leg back (%.2f rad)" % leg.rotation.x)
	kick.winding = false
	kick.kick()
	_expect(is_equal_approx(kick.kick_swing(), 1.0), "the swing is at its peak the moment the ball leaves")
	var swings: Array[float] = []
	for _frame in 40:
		kick.step(1.0 / 60.0)
		swings.append(leg.rotation.x)
	var highest: float = swings.max()
	_expect(is_equal_approx(swings[0], highest) and swings[0] > 1.0, "and the first frame drawn after it is the foot at its furthest (%.2f rad)" % swings[0])
	_expect(swings[10] < swings[0] - 0.3 and absf(swings[39]) < 0.1, "from where it follows through and comes back")
	for second in 8:
		_expect(RigMotion.kick_swing_at(float(second) * 0.05) >= RigMotion.kick_swing_at(float(second + 1) * 0.05), "the swing never rises after the release (%d)" % second)
	var game := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	var release := game.substr(game.find("func _on_kick_release()"))
	release = release.substr(0, release.find("\nfunc ", 10))
	_expect(release.contains("player.swing_kick()"), "the game swings the foot where it releases the ball")

	# Nothing is allocated drawing a frame, in any of the motions.
	var before := int(Performance.get_monitor(Performance.OBJECT_COUNT))
	var nodes := int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))
	for frame in 900:
		kick.speed = float(frame % 7)
		kick.swimming = frame % 300 > 200
		kick.diving = frame % 300 > 250
		kick.airborne = frame % 200 > 150
		kick.winding = frame % 90 > 70
		if frame % 100 == 0:
			kick.kick()
			kick.cheer()
			kick.land(8.0)
		kick.step(1.0 / 60.0)
	_expect(int(Performance.get_monitor(Performance.OBJECT_COUNT)) == before and int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)) == nodes, "driving the joints creates no objects, in a walk, a swim, a jump, a kick or a cheer")
	kicker.free()

	# Jump, landing and cheer reach the joints.
	var hopper := Character.build(2, 0, 0, Visitors.SHIRTS[2])
	var jump := RigMotion.new(hopper)
	jump.airborne = true
	for _frame in 30:
		jump.step(1.0 / 60.0)
	_expect((hopper.find_child("ShinL", true, false) as Node3D).rotation.x < -1.0 and (hopper.find_child("ThighL", true, false) as Node3D).rotation.x > 0.5, "in the air the knees are up")
	jump.airborne = false
	jump.land(10.0)
	jump.step(1.0 / 60.0)
	_expect(hopper.scale.y < 0.9 and hopper.scale.x > 1.0, "landing squashes the child, and")
	for _frame in 60:
		jump.step(1.0 / 60.0)
	_expect(is_equal_approx(hopper.scale.y, 1.0), "they spring back")
	jump.cheer()
	for _frame in 20:
		jump.step(1.0 / 60.0)
	_expect((hopper.find_child("UpperArmL", true, false) as Node3D).rotation.x > 2.0 and (hopper.find_child("UpperArmR", true, false) as Node3D).rotation.x > 2.0, "a cheer throws both arms up")
	hopper.free()

	# Swimming leans the way the child is going, and the strokes are made in it.
	var swimmer := Player.new()
	get_root().add_child(swimmer)
	swimmer.is_swimming = true
	for _frame in 90:
		swimmer._settle_in_water(1.0 / 60.0)
	var heading := swimmer.facing()
	var head_over := swimmer._visual.global_transform.basis.y.dot(heading)
	_expect(head_over > sin(Player.SWIM_LEAN) * 0.8, "a swimmer's head is tipped forward, the way they face (%.2f)" % head_over)
	swimmer.diving = true
	for _frame in 120:
		swimmer._settle_in_water(1.0 / 60.0)
	head_over = swimmer._visual.global_transform.basis.y.dot(heading)
	_expect(head_over > sin(Player.DIVE_LEAN) * 0.8, "and a diver goes in head first, not head up (%.2f)" % head_over)
	swimmer.diving = false
	swimmer.is_swimming = false
	swimmer._ride_lean = 0.3
	swimmer._settle_in_water(1.0 / 60.0)
	_expect(is_equal_approx(swimmer._visual.rotation.x, 0.3 - swimmer._swim_lean), "the ride lean and the swim lean add as they did, in their own directions")
	swimmer.queue_free()

	# The other child moves by what the phone sends.
	_expect(Session.motion_code(0.0, false, false) == 0, "standing still is zero, which an old phone also says by saying nothing")
	_expect(absf(Session.motion_speed(Session.motion_code(Player.RUN_SPEED, false, false)) - Player.RUN_SPEED) <= 0.25, "a speed comes back within a quarter of a metre a second")
	var code := Session.motion_code(2.0, true, true)
	_expect(code < 128 and Session.motion_speed(code) == 2.0 and code & 32 != 0 and code & 64 != 0, "swimming and diving are two more bits, in one small number")
	_expect(Session.motion_code(500.0, false, false) == 31 and Session.motion_code(-3.0, false, false) == 0, "and a speed off either end of the range is clamped")
	var session := Session.new()
	get_root().add_child(session)
	var heard: Array = []
	var moved: Array = []
	session.guest_moving.connect(func(_id: int, got: int) -> void: heard.append(got))
	session.guest_moved.connect(func(_id: int, _at: Vector3, _facing: float, mount: StringName) -> void: moved.append(mount))
	session._send_position(Vector3(1.0, 0.0, 2.0), 0.5)
	session._send_position(Vector3(1.0, 0.0, 2.0), 0.5, "horse:2")
	session._send_position(Vector3(1.0, 0.0, 2.0), 0.5, "", 13)
	session._send_position(Vector3(1.0, 0.0, 2.0), 0.5, "", 9999)
	_expect(heard == [0, 0, 13, 9999 & 127] and moved == [&"", &"horse:2", &"", &""], "old two- and three-value messages are still read, as standing still; a pace is read and cannot be more than seven bits")
	session.queue_free()

	var visitors := Visitors.new()
	get_root().add_child(visitors)
	visitors.add(41, "Amir", 2, [1, 0, 0])
	visitors.move(41, Vector3(4.0, 0.0, 4.0), 0.0)
	var guest_leg := visitors._visitors[41]["node"].find_child("ThighR", true, false) as Node3D
	visitors.moving(41, Session.motion_code(Player.RUN_SPEED, false, false))
	var swung := 0.0
	for frame in 150:
		visitors.moving(41, Session.motion_code(Player.RUN_SPEED, false, false))
		visitors._process(1.0 / 60.0)
		if frame > 60:
			swung = maxf(swung, absf(guest_leg.rotation.x))
	_expect(swung > 0.6, "a guest who is told they are running is drawn running (%.2f rad)" % swung)
	# No more is sent: a lost "now stop" must not leave them running for ever.
	for _frame in 240:
		visitors._process(1.0 / 60.0)
	_expect(absf(guest_leg.rotation.x) < 0.05, "and one who has not been heard from for a second stands still")
	visitors.moving(41, Session.motion_code(2.0, true, false))
	for _frame in 120:
		visitors.moving(41, Session.motion_code(2.0, true, false))
		visitors._process(1.0 / 60.0)
	var guest_rig := visitors._visitors[41]["node"].get_node("Rig") as Node3D
	_expect(guest_rig.position.y < -0.3 and guest_rig.rotation.x < -0.2, "a swimming guest sits low in the water and leans forward, as the child's own body does")
	visitors.relook(41, 2, [3, 0, 0])
	_expect(visitors.motion_of(41) != null and visitors._visitors[41]["node"].get_node("Rig").find_child("ThighL", true, false) != null, "a guest redrawn keeps being animated")
	visitors.queue_free()

## The choice screen is for a three-year-old tapping at random as much as for a
## twelve-year-old choosing: big targets, the chosen one unmistakable, and any
## tap undone by one tap.
func _check_the_choice_screen_is_for_small_fingers() -> void:
	print("the choice screen has big targets and a plain mark on the chosen one")
	var picker := LookPicker.new(Hud.BUTTON * 0.8)
	get_root().add_child(picker)
	var changes: Array = []
	picker.look_chosen.connect(func(look: Array) -> void:
		changes.append(look)
		picker.set_look(look))
	var smallest := 1e9
	for group: Array in [picker._face_buttons, picker._skin_buttons, picker._hair_buttons, picker._shirt_buttons]:
		for button: Button in group:
			smallest = minf(smallest, minf(button.custom_minimum_size.x, button.custom_minimum_size.y))
	_expect(smallest >= 44.0, "every target is at least 44 pixels across, in the smallest panel (%.0f)" % smallest)
	for button in picker._face_buttons:
		_expect(button.custom_minimum_size.x >= 64.0, "and a face is bigger still")
	picker.set_look([1, 2, 3])
	var halo := picker._face_buttons[1].get_theme_stylebox("normal") as StyleBoxFlat
	var plain := picker._face_buttons[2].get_theme_stylebox("normal") as StyleBoxFlat
	_expect(halo.border_width_left >= 4 and halo.shadow_size > 0 and plain.border_width_left == 0 and plain.shadow_size == 0, "the chosen face is ringed and haloed, and no other")
	# A stray tap on another face, then a tap on the old one, is back where it was.
	picker._face_buttons[4].pressed.emit()
	picker._face_buttons[1].pressed.emit()
	_expect(changes == [[4, 2, 3], [1, 2, 3]] and picker.look() == [1, 2, 3], "one tap undoes a stray one, and skin and hair were kept through it")
	picker._face_buttons[1].pressed.emit()
	_expect(picker.look() == [1, 2, 3], "tapping what is chosen already changes nothing")
	picker.queue_free()

## A child who has picked no shirt wears one from the palette, worked out from
## their network id. The settings faces drew them in a blue-grey that is in no
## palette, so the face meant to look like them did not.
func _check_the_faces_wear_the_shirt_the_child_is_really_in() -> void:
	print("the choice faces wear the fallback shirt when none is picked")
	var picker := LookPicker.new(Hud.BUTTON * 0.8)
	get_root().add_child(picker)
	var fallback := Visitors.SHIRTS[7]
	picker.set_worn(fallback)
	_expect(picker._faces[0].cloth == fallback, "with no shirt picked the faces wear the colour the body has")
	picker.set_shirt(2)
	_expect(picker._faces[0].cloth == Visitors.SHIRTS[2], "a picked shirt wins over the fallback")
	picker.set_shirt(-1)
	_expect(picker._faces[3].cloth == fallback, "and unpicked, it is the fallback again")
	picker.queue_free()

## Where a joint is in the rig's own frame, however far down the rig it hangs.
## Walks up the parents instead of asking the tree, so it needs none.
func _in_rig(joint: Node3D, rig: Node3D) -> Vector3:
	var at := joint.position
	var up := joint.get_parent() as Node3D
	while up != rig:
		at = up.transform * at
		up = up.get_parent() as Node3D
	return at

## A rig driven in a seat for long enough to have settled into it.
func _seated(which: int, pose: StringName, gait := 0.0) -> Array:
	var parent := Node3D.new()
	get_root().add_child(parent)
	var rig := Character.build(which, 1, 1, Visitors.SHIRTS[2])
	parent.add_child(rig)
	var motion := RigMotion.new(rig)
	motion.seat = pose
	motion.gait = gait
	for _frame in 80:
		motion.step(1.0 / 60.0)
	return [rig, motion, parent]

## Every way a child is carried has a pose, written about the thing it is for:
## the hips on the seat as it is drawn, the hands where the grips are, and the
## body eased in and out in a fraction of a second rather than jumped.
func _check_a_child_sits_in_every_seat_they_are_carried_in() -> void:
	print("a child sits in every seat, hands on the grips, and settles into it rather than jumping")
	var poses: Array[StringName] = []
	poses.append_array(MountKinds.ALL)
	poses.append_array([&"carousel", &"wheel", &"coaster", &"drop_tower", &"pirate_ship", &"swing"])
	# And the café's seats: a chair at a table, and a stool or the sofa.
	poses.append_array([&"chair", &"lap"])
	for pose in poses:
		_expect(SeatPose.POSES.has(pose), "there is a pose for %s" % pose)
	_expect(SeatPose.POSES.size() == poses.size(), "and none for anything that is not a way of being carried")

	# The top of each seat as it is drawn, in the frame its pose is written in.
	# Worked from the constants and the drawing of each, not from the pose.
	var tops := {
		&"horse": _top_of_the_ponys_seat() - MountKinds.eye_lift(MountKinds.HORSE),
		&"motorcycle": 1.06 + 0.12 * 0.5 - MountKinds.eye_lift(MountKinds.MOTORCYCLE),
		&"quad": (0.76 + 0.2 * 0.5) * MountKinds.QUAD_SCALE - MountKinds.eye_lift(MountKinds.QUAD),
		&"boat": 0.5 - MountKinds.BOAT_DRAFT - 0.12 + 0.03 - MountKinds.eye_lift(MountKinds.BOAT),
		&"carousel": 0.0, &"drop_tower": 0.0, &"pirate_ship": 0.0, &"swing": 0.0,
		&"wheel": (0.52 + 0.08 - 0.08) * FerrisWheel.CAR_SCALE,
		&"coaster": 0.52 + 0.08 - RollerCoaster.SEAT_SPOT.y,
	}
	for pose: StringName in tops:
		var seat: Vector3 = SeatPose.POSES[pose]["seat"]
		_expect(absf(seat.y - float(tops[pose])) < 0.03, "%s: the pose sits on the seat as it is drawn (%.3f against %.3f)" % [pose, seat.y, float(tops[pose])])
	# A bicycle is drawn for a grown rider, a metre from pedal to saddle: a child
	# stands on the pedals, whose crank centre is where the pose puts the feet.
	var crank: Vector3 = SeatPose.POSES[MountKinds.BICYCLE]["foot"]
	_expect(absf(crank.y - (0.34 - MountKinds.eye_lift(MountKinds.BICYCLE) + 0.09 - 0.015)) < 0.03, "on a bicycle the feet are at the pedals' crank, where it is drawn")

	for pose: StringName in SeatPose.POSES:
		var spec: Dictionary = SeatPose.POSES[pose]
		var seat: Vector3 = spec["seat"]
		var grip: Vector3 = spec["hand"]
		var worst_hand := 0.0
		var worst_hips := 0.0
		for which in Character.KEYS.size():
			var made := _seated(which, pose)
			var rig: Node3D = made[0]
			var hips := rig.find_child("Hips", true, false) as Node3D
			# The bottom of the pelvis, as the mesh is: it is on the seat.
			var bottom := hips.position.y + (hips.get_node("Mesh") as MeshInstance3D).mesh.get_aabb().position.y
			worst_hips = maxf(worst_hips, absf(bottom - seat.y))
			for side in 2:
				var hand := rig.find_child("Hand" + ("L" if side == 0 else "R"), true, false) as Node3D
				var goal := Vector3(grip.x if side == 0 else -grip.x, grip.y, grip.z)
				worst_hand = maxf(worst_hand, (_in_rig(hand, rig) - goal).length())
			(made[2] as Node3D).queue_free()
		_expect(worst_hips < 0.05, "%s: every character's hips are on the seat (%.3f m off at worst)" % [pose, worst_hips])
		# The wrist stops a hand's breadth short of the grip, so the hand is
		# round it; a place out of reach is as near as the arm gets.
		_expect(worst_hand < 0.11, "%s: every character's hands are on the grips (%.3f m off at worst)" % [pose, worst_hand])

	# Settling in and climbing out takes a fraction of a second, with no jump in
	# between: nothing moves more than a few centimetres in a frame, and it is
	# done in a quarter of a second.
	for pose: StringName in [&"horse", &"drop_tower", &"swing"]:
		var parent := Node3D.new()
		get_root().add_child(parent)
		var rig := Character.build(1, 0, 0, Visitors.SHIRTS[4])
		parent.add_child(rig)
		var motion := RigMotion.new(rig)
		var hips := rig.find_child("Hips", true, false) as Node3D
		var thigh := rig.find_child("ThighL", true, false) as Node3D
		for _frame in 20:
			motion.step(1.0 / 60.0)
		var rest := hips.position.y
		motion.seat = pose
		var before := hips.position.y
		var jump := 0.0
		var turn := 0.0
		var before_turn := thigh.quaternion
		for _frame in 15:
			motion.step(1.0 / 60.0)
			jump = maxf(jump, absf(hips.position.y - before))
			turn = maxf(turn, thigh.quaternion.angle_to(before_turn))
			before = hips.position.y
			before_turn = thigh.quaternion
		_expect(jump < 0.06 and turn < 0.35, "%s: settling in moves the hips %.3f m and a thigh %.2f rad in a frame at most" % [pose, jump, turn])
		_expect(motion._sit >= 1.0, "%s: and has settled in a quarter of a second" % pose)
		var seat_y: float = (SeatPose.POSES[pose]["seat"] as Vector3).y
		_expect(absf(hips.position.y - (seat_y + motion._pelvis)) < 0.01, "%s: where the pose puts the hips" % pose)
		motion.seat = &""
		jump = 0.0
		before = hips.position.y
		for _frame in 15:
			motion.step(1.0 / 60.0)
			jump = maxf(jump, absf(hips.position.y - before))
			before = hips.position.y
		_expect(jump < 0.06, "%s: climbing out moves the hips %.3f m in a frame at most" % [pose, jump])
		_expect(absf(hips.position.y - rest) < 0.02 and hips.position.x == 0.0 and hips.position.z == 0.0, "%s: and they are back where they stood" % pose)
		_expect((rig.find_child("UpperArmL", true, false) as Node3D).get_node("Mesh").scale.y == 1.0 and rig.position == Vector3.ZERO and rig.quaternion.is_equal_approx(Quaternion()), "%s: arms the length they were, and the rig where and as it was" % pose)
		parent.queue_free()

	# The pace of the carrier is the pace of the legs on a bicycle, and of nothing
	# on a swing.
	var pedals := _seated(1, MountKinds.BICYCLE, 0.0)
	var pedalling: RigMotion = pedals[1]
	var shin := (pedals[0] as Node3D).find_child("ShinL", true, false) as Node3D
	var still_low := 1e9
	var still_high := -1e9
	for _frame in 120:
		pedalling.step(1.0 / 60.0)
		still_low = minf(still_low, shin.rotation.x)
		still_high = maxf(still_high, shin.rotation.x)
	_expect(still_high - still_low < 0.01, "a bicycle standing still has still pedals")
	pedalling.gait = 5.0
	var turning_low := 1e9
	var turning_high := -1e9
	for _frame in 120:
		pedalling.step(1.0 / 60.0)
		turning_low = minf(turning_low, shin.quaternion.get_euler().x)
		turning_high = maxf(turning_high, shin.quaternion.get_euler().x)
	_expect(turning_high - turning_low > 0.5, "and a moving one has the knees going up and down with the wheel (%.2f rad)" % (turning_high - turning_low))
	(pedals[2] as Node3D).queue_free()

	# Nothing is allocated drawing a seated frame either.
	var made := _seated(2, MountKinds.HORSE, 4.0)
	var count := int(Performance.get_monitor(Performance.OBJECT_COUNT))
	for frame in 300:
		(made[1] as RigMotion).gait = float(frame % 9)
		if frame == 100:
			(made[1] as RigMotion).seat = &"swing"
		if frame == 200:
			(made[1] as RigMotion).seat = &""
		(made[1] as RigMotion).step(1.0 / 60.0)
	_expect(int(Performance.get_monitor(Performance.OBJECT_COUNT)) == count, "driving a child through a mount, a ride and off again creates no objects")
	(made[2] as Node3D).queue_free()

	# The seats are where the rides draw them, and the floor is not one.
	var tower := DropTower.new(Vector3.ZERO)
	get_root().add_child(tower)
	var seats := tower.seats()
	_expect(seats.size() == DropTower.SEATS, "the tower has a seat for every place on it")
	var on_cushion := tower._ring.global_transform.affine_inverse() * seats[0].origin
	_expect(absf(on_cushion.y + DropTower.SEAT_BELOW_RING) < 0.01, "a tower seat is at the cushion's height, %.2f below the ring" % DropTower.SEAT_BELOW_RING)
	_expect(not is_nan(tower.seat_near(seats[0].origin + Vector3(0.05, 0.02, 0.0)).origin.x), "a child standing on a tower seat is in one")
	_expect(is_nan(tower.seat_near(seats[0].origin + Vector3(0.0, -1.6, 0.0)).origin.x) and is_nan(tower.seat_near(Vector3(0.0, 0.0, 0.0)).origin.x), "and one on the platform or at the shaft is not")
	var facing := tower.seat_near(seats[0].origin).basis * Vector3.FORWARD
	var outward := (seats[0].origin - tower._ring.global_position)
	outward.y = 0.0
	_expect(facing.dot(outward.normalized()) > 0.99, "and they face out from the tower, as the seat does")
	tower.queue_free()
	var ship := PirateShip.new(Vector3.ZERO)
	get_root().add_child(ship)
	var rows := ship.seats()
	_expect(rows.size() == 8, "the ship has eight seats")
	var hull_local := ship._hull.global_transform.affine_inverse() * rows[0].origin
	_expect(absf(hull_local.y - PirateShip.SEAT_TOP) < 0.01, "a ship seat is the cushion's height")
	var toward_middle := -(ship._hull.global_transform.affine_inverse() * rows[0].origin).x
	var ahead := ship._hull.global_transform.basis.inverse() * (rows[0].basis * Vector3.FORWARD)
	_expect(ahead.x * toward_middle > 0.0, "and they face the middle of the ship")
	_expect(is_nan(ship.seat_near(Vector3(0.0, 0.2, 0.0)).origin.x), "the deck between the seats is not one")
	ship.queue_free()
	var carousel := Carousel.new(Vector3.ZERO)
	get_root().add_child(carousel)
	var saddle := carousel.saddles()[2]
	_expect(absf(saddle.origin.y - (Carousel.FLOOR_HEIGHT + 1.5)) < 0.01, "a carousel seat is the saddle's top")
	_expect(not is_nan(carousel.seat_near(saddle.origin + Vector3(0.0, 0.03, 0.0)).origin.x), "a child on the saddle is on a horse")
	_expect(is_nan(carousel.seat_near(Vector3(Carousel.RADIUS * 0.3, Carousel.FLOOR_HEIGHT, 0.0)).origin.x), "and on the floor of the carousel is not")
	carousel.queue_free()
	var wheel := FerrisWheel.new(Vector3.ZERO)
	get_root().add_child(wheel)
	var here := wheel.gondola(0).global_position + Vector3(0.0, 0.2, 0.0)
	wheel.set_rider(0)
	_expect(is_nan(wheel.seat_near(here).origin.x) == (wheel.bar_open(0) >= 0.5), "a gondola seats a child only once its bar is down")
	var coaster := RollerCoaster.new(Vector3.ZERO)
	get_root().add_child(coaster)
	var in_car := coaster.seat_of(0)
	_expect(not is_nan(coaster.seat_under(in_car.origin).origin.x), "a child in a coaster car is in its seat")
	coaster.queue_free()
	wheel.queue_free()

	# The other child is posed the same way, from where they are and what they
	# ride: astride on a horse, sat on a ride's seat, nothing sent but what was.
	var visitors := Visitors.new()
	get_root().add_child(visitors)
	visitors.add(61, "Mimi", 1, [1, 0, 0])
	visitors.move(61, Vector3(3.0, 0.0, 3.0), 0.0)
	var guest := visitors._visitors[61]["node"] as Node3D
	var guest_rig := guest.get_node("Rig") as Node3D
	var guest_hips := guest_rig.find_child("Hips", true, false) as Node3D
	for _frame in 20:
		visitors._process(1.0 / 60.0)
	var standing := guest_hips.position.y
	visitors.move(61, Vector3(3.0, 0.0, 3.0), 0.0, MountKinds.HORSE)
	for _frame in 60:
		visitors._process(1.0 / 60.0)
	_expect(visitors.motion_of(61).seat == MountKinds.HORSE, "somebody on a horse is posed as on a horse")
	_expect(guest_hips.position.y < standing - 0.2, "sitting in the saddle, not standing in it (%.2f against %.2f)" % [guest_hips.position.y, standing])
	var foot_out := absf(_in_rig(guest_rig.find_child("FootL", true, false), guest_rig).x)
	_expect(foot_out > _the_barrels_half_width() + 0.02 and _in_rig(guest_rig.find_child("FootL", true, false), guest_rig).x * _in_rig(guest_rig.find_child("FootR", true, false), guest_rig).x < 0.0, "with a leg down each side of the barrel, astride (%.2f m out)" % foot_out)
	var grip_at: Vector3 = SeatPose.POSES[MountKinds.HORSE]["hand"]
	var guest_hand := _in_rig(guest_rig.find_child("HandL", true, false), guest_rig)
	_expect((guest_hand - grip_at).length() < 0.11, "and a hand at the pommel where the reins are")
	visitors.move(61, Vector3(3.0, 0.0, 3.0), 0.0)
	for _frame in 60:
		visitors._process(1.0 / 60.0)
	_expect(visitors.motion_of(61).seat == &"" and absf(guest_hips.position.y - standing) < 0.02, "and standing again when they get off")
	# On a ride, from where they stand: the game's own question of the park.
	var place := Transform3D(Basis(Vector3.UP, 0.7), Vector3(5.0, 1.0, 5.0))
	visitors.seat_finder = func(_at: Vector3) -> Dictionary: return {"pose": &"drop_tower", "place": place}
	for _frame in 60:
		visitors._process(1.0 / 60.0)
	_expect(visitors.motion_of(61).seat == &"drop_tower", "a visitor on a tower seat is seated on it, with nothing more sent than where they are")
	_expect((guest.global_transform * guest_rig.position).distance_to(place.origin) < 0.05, "and drawn on the seat, not where they were standing")
	visitors.seat_finder = Callable()
	for _frame in 60:
		visitors._process(1.0 / 60.0)
	_expect(guest_rig.position.length() < 0.01 and guest_rig.quaternion.is_equal_approx(Quaternion()), "and put back when they leave it")
	visitors.queue_free()

	# The child's own body: a mount's pose from what it rides, a ride's from what
	# the game says it sits in.
	var kid := Player.new()
	get_root().add_child(kid)
	kid.riding = MountKinds.QUAD
	for _frame in 30:
		kid._animate(1.0 / 60.0)
	_expect(kid.motion().seat == MountKinds.QUAD, "on a quad the child's body sits as on a quad")
	kid.riding = &""
	kid.seat_pose = &"swing"
	kid.seat_place = Transform3D(Basis(), Vector3(0.0, 1.0, 0.0))
	for _frame in 30:
		kid._animate(1.0 / 60.0)
	_expect(kid.motion().seat == &"swing" and kid.motion()._air == 0.0, "and on a swing, which is not a jump")
	# The horse's stride lifts its saddle by up to sixteen centimetres; a rider
	# who stayed where they were would have the saddle rise into them.
	kid.seat_pose = &""
	kid.riding = MountKinds.HORSE
	kid.global_position = Vector3(0.0, 80.0, 0.0)
	for _frame in 90:
		kid._physics_process(1.0 / 60.0)
	var level := kid._visual.position.y
	kid.saddle_lift = 0.12
	kid._physics_process(1.0 / 60.0)
	_expect(absf(kid._visual.position.y - level - 0.12) < 0.01, "a rider goes up with the saddle when the horse's stride lifts it (%.3f m)" % (kid._visual.position.y - level))
	kid.queue_free()
	# And the game hands each body what it needs: the saddle's lift to the child,
	# the question "is that a seat?" to the other child.
	var main_source := _code_only(FileAccess.get_file_as_string("res://src/main.gd"))
	_expect(main_source.contains("player.saddle_lift = world.mounts.saddle_lift()"), "the game gives the child the saddle's lift")
	_expect(main_source.contains("visitors.seat_finder = _seat_at") and main_source.contains("player.seat_pose = seated.get("), "and asks the same question of where each child stands")

## Points over the surface of a drawn mesh, in the world: every triangle on a
## grid, because a beam drawn as a box has only its corners for vertices and a
## face can sit between them.
func _surface_points(drawn: MeshInstance3D) -> PackedVector3Array:
	var out := PackedVector3Array()
	if drawn == null or drawn.mesh == null:
		return out
	var arrays := drawn.mesh.surface_get_arrays(0)
	var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
	var count := indices.size() if not indices.is_empty() else vertices.size()
	var steps := 4
	for corner in range(0, count - 2, 3):
		var a := vertices[indices[corner] if not indices.is_empty() else corner]
		var b := vertices[indices[corner + 1] if not indices.is_empty() else corner + 1]
		var c := vertices[indices[corner + 2] if not indices.is_empty() else corner + 2]
		for i in steps + 1:
			for j in steps + 1 - i:
				out.append(drawn.global_transform * (a + (b - a) * (float(i) / steps) + (c - a) * (float(j) / steps)))
	return out

func _nearest_to(points: PackedVector3Array, at: Vector3) -> float:
	var best := 1e9
	for point in points:
		best = minf(best, point.distance_to(at))
	return best

## Fit the seats to children: the restraints, the machines, the gondola, the
## swing and the rest were drawn for grown-ups, and a child of six to twelve is
## a head and a half shorter than the first thing they sat in.
func _check_the_seats_fit_children() -> void:
	print("the seats fit children: restraints clear of the face, hands and feet within reach")
	_check_the_restraints_keep_clear_of_the_face()
	_check_no_arm_is_stretched_and_no_foot_floats()
	_check_the_bicycle_frame_is_clear_of_the_body()
	_check_a_seated_child_is_seen_in_a_gondola_and_sits_where_they_stand()
	_check_a_swing_is_pumped_with_the_legs()
	_check_the_smaller_seats()

## The head's middle and its skull's radius, in the world, for a rig that has
## been put in a seat.
func _skull(rig: Node3D) -> Vector3:
	var head := rig.find_child("Head", true, false) as Node3D
	var lo := Vector3(1e9, 1e9, 1e9)
	var hi := -lo
	for child in head.get_children():
		var shape := child as MeshInstance3D
		if shape == null or shape.mesh == null:
			continue
		var box := shape.mesh.get_aabb()
		for corner in 8:
			var at: Vector3 = shape.global_transform * box.get_endpoint(corner)
			lo = lo.min(at)
			hi = hi.max(at)
	return (lo + hi) * 0.5

func _check_the_restraints_keep_clear_of_the_face() -> void:
	for ride_name: StringName in [&"drop_tower", &"pirate_ship"]:
		var ride: Node3D = DropTower.new(Vector3.ZERO) if ride_name == &"drop_tower" else PirateShip.new(Vector3.ZERO)
		get_root().add_child(ride)
		ride.set_physics_process(false)
		var hinges: Array[Node3D] = []
		if ride is DropTower:
			(ride as DropTower)._harness_closed = 1.0
			hinges = (ride as DropTower)._harnesses
			for hinge in hinges:
				hinge.rotation.z = -DropTower.HARNESS_CLOSE
		else:
			var ship := ride as PirateShip
			ship._harness_closed = 1.0
			hinges = ship._harnesses
			for index in hinges.size():
				hinges[index].rotation.z = ship._harness_ends[index] * PirateShip.BAR_CLOSE
		var seat: Transform3D = (ride as DropTower).seats()[0] if ride is DropTower else (ride as PirateShip).seats()[0]
		var restraint := PackedVector3Array()
		for part in hinges[0].get_children():
			restraint.append_array(_surface_points(part as MeshInstance3D))
		_expect(restraint.size() > 100, "%s: the closed restraint is drawn" % ride_name)
		for which in Character.KEYS.size():
			var anchor := Node3D.new()
			get_root().add_child(anchor)
			anchor.global_transform = seat
			var rig := Character.build(which, 1, 1, Visitors.SHIRTS[2])
			anchor.add_child(rig)
			var motion := RigMotion.new(rig)
			motion.seat = ride_name
			for _frame in 80:
				motion.step(1.0 / 60.0)
			var skull := _skull(rig)
			# The skull is a quarter of a metre in radius, the biggest head
			# the five have; the face is at the front of it.
			var clear := _nearest_to(restraint, skull)
			_expect(clear > 0.27, "%s, %s: the harness is %.2f m from the middle of the head, clear of a skull's 0.26" % [ride_name, Character.KEYS[which], clear])
			var held := 0.0
			for tag: String in ["L", "R"]:
				var hand := rig.find_child("Hand" + tag, true, false) as Node3D
				held = maxf(held, _nearest_to(restraint, hand.global_position))
			_expect(held < 0.1, "%s, %s: both hands are on the restraint (%.2f m off at worst)" % [ride_name, Character.KEYS[which], held])
			anchor.queue_free()
		# What holds a child is where it is drawn: the solid of the closed
		# restraint is not further from its lowest drawn part than a hand.
		var solids: Array[CollisionShape3D] = (ride as DropTower)._harness_shapes if ride is DropTower else (ride as PirateShip)._bar_shapes
		var box := (solids[0].shape as BoxShape3D).size
		var solid_at := solids[0].global_position
		var drawn_count := 0
		for point in restraint:
			if point.distance_to(solid_at) < box.length() * 0.5:
				drawn_count += 1
		_expect(drawn_count > 20, "%s: the solid that holds a child has the closed restraint's drawing in it (%d points)" % [ride_name, drawn_count])
		ride.queue_free()

func _check_no_arm_is_stretched_and_no_foot_floats() -> void:
	for pose: StringName in SeatPose.POSES:
		var spec: Dictionary = SeatPose.POSES[pose]
		var machine := MountKinds.ALL.has(pose) and pose != MountKinds.BOAT
		# A child's arm is as long as it is: the machines were drawn for
		# grown riders, and their bars and boards now come to a child's size
		# rather than the arms going to a third as long again.
		_expect(float(spec["reach"]) <= (1.1 if machine else 1.2), "%s: the arms are drawn %.2f times as long when seated, at most %.2f" % [pose, float(spec["reach"]), 1.1 if machine else 1.2])
		var ankle: Vector3 = spec["foot"]
		var worst := 0.0
		for which in Character.KEYS.size():
			var made := _seated(which, pose)
			var rig: Node3D = made[0]
			var goal := Vector3(ankle.x, ankle.y, ankle.z)
			worst = maxf(worst, (_in_rig(rig.find_child("FootL", true, false), rig) - goal).length())
			(made[2] as Node3D).queue_free()
		# The crank of a bicycle takes a foot round a circle of its own.
		var allowed := 0.25 if pose == MountKinds.BICYCLE else 0.2
		_expect(worst < allowed, "%s: every character's feet are at the place for them (%.2f m off at worst)" % [pose, worst])

func _check_the_bicycle_frame_is_clear_of_the_body() -> void:
	var frame := MeshInstance3D.new()
	frame.mesh = MountKinds.build_mesh(MountKinds.BICYCLE)
	get_root().add_child(frame)
	var points := _surface_points(frame)
	# The rig stands where the child's own origin is, lifted on the machine.
	var lift := MountKinds.eye_lift(MountKinds.BICYCLE)
	for which in Character.KEYS.size():
		var made := _seated(which, MountKinds.BICYCLE)
		var rig: Node3D = made[0]
		var torso := _in_rig(rig.find_child("Torso", true, false), rig)
		var neck := _in_rig(rig.find_child("Head", true, false), rig)
		# The chest is the segment from the waist to the neck, as deep from front
		# to back as the rig says (the chest radius is its width, and it is
		# 0.68 as deep as it is wide, the clay toy's round one included). The
		# frame is in the middle plane, so it is the depth that meets it.
		var radius: float = float(rig.get_meta("chest_radius", 0.2)) * 0.68
		var worst := 1e9
		var at := ""
		for point in points:
			var mine := point - Vector3(0.0, lift, 0.0)
			# From the stem up are the bars, which the child holds: it is the
			# top tube, the head tube and the seat that must be clear.
			if mine.y + lift > 0.81:
				continue
			var along := clampf((mine - torso).dot(neck - torso) / (neck - torso).length_squared(), 0.0, 1.0)
			var gap := mine.distance_to(torso + (neck - torso) * along)
			if gap < worst:
				worst = gap
				at = str(mine)
		_expect(worst > radius * 0.9, "bicycle, %s: the frame is %.2f m from the body's axis, %.2f thick, at %s" % [Character.KEYS[which], worst, radius, at])
		(made[2] as Node3D).queue_free()
	frame.queue_free()

func _check_a_seated_child_is_seen_in_a_gondola_and_sits_where_they_stand() -> void:
	var wheel := FerrisWheel.new(Vector3.ZERO)
	get_root().add_child(wheel)
	var car := wheel.gondola(0)
	# The sides are steel as high as the bench and glass above it: nothing opaque
	# stands between a camera and a seated child but the bench's own height.
	var high_wall := 0
	var drawn_sides := 0
	for part in car.get_children():
		if not (part is MeshInstance3D) or part.name == &"Glass":
			continue
		for point in _surface_points(part as MeshInstance3D):
			var local := car.global_transform.affine_inverse() * point
			# The doorway's own jambs, at x -1.8, stand the height of the wall.
			if absf(local.z) > 1.3 and local.x > -1.6 and local.y > FerrisWheel.SIDE_SOLID + 0.1 and local.y < 1.55:
				high_wall += 1
			drawn_sides += 1
	_expect(drawn_sides > 0 and high_wall == 0, "a gondola's side walls are not opaque above the bench (%d points of %d)" % [high_wall, drawn_sides])
	var glass := car.get_node_or_null("Glass") as MeshInstance3D
	_expect(glass != null and glass.mesh != null and (glass.mesh as ArrayMesh).surface_get_material(0).transparency != BaseMaterial3D.TRANSPARENCY_DISABLED, "and the upper part is glass")
	# A child is seated where they stand along the bench, not slid to the
	# middle of it.
	for along: float in [-0.7, 0.0, 0.7]:
		var at: Vector3 = car.global_transform * Vector3(0.3, 0.2, along)
		var seat := wheel.seat_near(at)
		_expect(not is_nan(seat.origin.x), "a child in a gondola at %.1f along is seated" % along)
		var local := car.global_transform.affine_inverse() * seat.origin
		_expect(absf(local.z - along) < 0.05, "and sits at %.2f along the bench, where they stood (%.1f)" % [local.z, along])
	wheel.queue_free()

func _check_a_swing_is_pumped_with_the_legs() -> void:
	var parent := Node3D.new()
	get_root().add_child(parent)
	var rig := Character.build(1, 1, 1, Visitors.SHIRTS[2])
	parent.add_child(rig)
	var motion := RigMotion.new(rig)
	motion.seat = &"swing"
	motion.seat_placed = true
	var foot := rig.find_child("FootL", true, false) as Node3D
	var going_forward := 0.0
	var going_back := 0.0
	var forward_frames := 0
	var back_frames := 0
	var before := 0.0
	for frame in 360:
		# A swing about two seconds to a swing, a quarter of a radian either way.
		var tilt := 0.25 * sin(float(frame) / 60.0 * PI)
		var rate := 0.25 * PI * cos(float(frame) / 60.0 * PI)
		motion.seat_place = Transform3D(Basis(Vector3.RIGHT, tilt), Vector3(0.0, 1.0, 0.0))
		motion.step(1.0 / 60.0)
		if frame > 120:
			var at := _in_rig(foot, rig).z
			if rate > 0.4:
				going_forward += at
				forward_frames += 1
			elif rate < -0.4:
				going_back += at
				back_frames += 1
		before = tilt
	_expect(forward_frames > 20 and back_frames > 20, "the swing was driven both ways (%d, %d frames)" % [forward_frames, back_frames])
	var ahead := going_forward / maxf(forward_frames, 1)
	var behind := going_back / maxf(back_frames, 1)
	_expect(behind - ahead > 0.15, "swinging forward the feet are out in front (%.2f) and on the way back tucked under (%.2f)" % [ahead, behind])
	parent.queue_free()

func _check_the_smaller_seats() -> void:
	# The skirt is above the seat, not in it: nothing of the pelvis's drawing,
	# the girl's skort included, is below the seat's top.
	for pose: StringName in SeatPose.POSES:
		var seat: Vector3 = SeatPose.POSES[pose]["seat"]
		for which in Character.KEYS.size():
			var made := _seated(which, pose)
			var hips := (made[0] as Node3D).find_child("Hips", true, false) as Node3D
			var bottom := hips.position.y + (hips.get_node("Mesh") as MeshInstance3D).mesh.get_aabb().position.y
			_expect(bottom > seat.y - 0.012, "%s, %s: the pelvis and any skirt are above the seat (%.3f below its top)" % [pose, Character.KEYS[which], seat.y - bottom])
			(made[2] as Node3D).queue_free()
	# The boat: the child rows from the thwart they stand at, which is the one
	# at the oars, with their hands on them.
	var boat: Dictionary = SeatPose.POSES[MountKinds.BOAT]
	var sits_at: float = (boat["seat"] as Vector3).z
	var nearest := 1e9
	for thwart in MountKinds.BOAT_THWARTS:
		nearest = minf(nearest, absf(thwart - sits_at))
	_expect(nearest < 0.05, "the rower sits on a thwart (%.2f m from the nearest)" % nearest)
	_expect(absf(sits_at - MountKinds.BOAT_OARS_Z) < 0.1 and absf((boat["hand"] as Vector3).z - MountKinds.BOAT_OARS_Z) < 0.05, "at the oars, with hands on them")
	# The carousel horse: the child sits behind the brass pole, which is at the
	# middle of the saddle, with the mane (0.38 ahead, 0.1 across) clear of them.
	var carousel: Dictionary = SeatPose.POSES[&"carousel"]
	_expect((carousel["seat"] as Vector3).z - 0.12 > 0.06, "the carousel rider's hips are behind the pole (%.2f)" % (carousel["seat"] as Vector3).z)
	for which in Character.KEYS.size():
		var made := _seated(which, &"carousel")
		var rig: Node3D = made[0]
		var torso := _in_rig(rig.find_child("Torso", true, false), rig)
		var neck := _in_rig(rig.find_child("Head", true, false), rig)
		var worst := 1e9
		for step in 11:
			var along := torso.lerp(neck, float(step) / 10.0)
			worst = minf(worst, absf(along.z + 0.38) if along.y < 0.48 else 1e9)
		_expect(worst > 0.18, "carousel, %s: the body is %.2f m behind the mane" % [Character.KEYS[which], worst])
		(made[2] as Node3D).queue_free()

## A tree the child planted and then felled left no stump, and felling the same
## tree from two phones recorded it twice.
##
## The record of felled trees is positions; only the forest's own generated
## trees were ever offered to the tile as stumps, so a planted one (not in the
## forest) was felled on paper and bare grass on screen, against what the axe's
## comment promises.
func _check_a_felled_planted_tree_leaves_its_stump() -> void:
	print("a felled planted tree leaves its stump")
	var seed_value := 20260903
	var field := HeightField.new(seed_value)
	var coord := Vector2i(1, 1)
	var size := 32
	# A spot in the tile that is no forest tree's: well clear of every one.
	var wild := VegetationTile.generate_trees(field, coord, size, seed_value, null)
	var spot := Vector3.ZERO
	var found := false
	for tx in range(2, 30, 3):
		for tz in range(2, 30, 3):
			var here := Vector3(float(size + tx) + 0.5, 0.0, float(size + tz) + 0.5)
			var clear := true
			for tree: Dictionary in wild:
				var p: Vector3 = tree["position"]
				if Vector2(p.x - here.x, p.z - here.z).length() < 3.0:
					clear = false
			if clear and not found:
				spot = here
				found = true
	_expect(found, "there is a free spot in the tile")
	var record := Felled.new()
	record.fell(spot)
	record.fell(spot + Vector3(0.01, 0.0, 0.0))
	_expect(record.count() == 1, "felling one spot twice is one stump, not %d" % record.count())
	var baked := VegetationTile.bake(field, coord, size, seed_value, record, false)
	_expect((baked["stumps"] as Array).size() == 1, "a stump is drawn where the planted tree stood: %d" % (baked["stumps"] as Array).size())
	record.clear_stumps_near(spot, 1.0)
	baked = VegetationTile.bake(field, coord, size, seed_value, record, false)
	_expect((baked["stumps"] as Array).size() == 0, "and it goes when ground is tidied")
## The horse is a pony a child rides: narrow through the barrel where the legs
## hang, the stirrups at the side of it and a child's leg's length below the
## saddle, and every character astride, feet in the irons, hands on the reins.
func _check_the_horse_is_a_childs_pony_with_the_rider_astride() -> void:
	print("the horse is a child's pony and the rider sits astride it")
	var s := HorseNatural.S
	var body := MountKinds.horse_part("body") as ArrayMesh
	var hide := MountKinds.colour(MountKinds.HORSE)
	var barrel := 0.0
	var flank := 0.0
	var depth_low := 1e9
	var depth_high := -1e9
	# The barrel alone, as it is drawn: the points of the body skin between the
	# withers and the croup, above the stirrups' line and below the saddle.
	var natural := SurfaceTool.new()
	natural.begin(Mesh.PRIMITIVE_TRIANGLES)
	HorseNatural.body(natural, hide)
	for point: Vector3 in natural.commit().surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
		if absf(point.z) < 0.3 * s:
			barrel = maxf(barrel, absf(point.x))
			depth_low = minf(depth_low, point.y)
			depth_high = maxf(depth_high, point.y)
		flank = maxf(flank, absf(point.x))
	_expect(barrel * 2.0 < 0.70, "the barrel is %.2f m across at the saddle, a pony's and not a cask's" % (barrel * 2.0))
	_expect(flank * 2.0 < 0.76, "and nowhere more than %.2f m" % (flank * 2.0))
	_expect(depth_high - depth_low > barrel * 2.0 * 1.4, "deeper than it is wide: %.2f m deep" % (depth_high - depth_low))
	_expect(body.get_aabb().size.x < 0.95, "the saddle and irons add no width beyond the legs' reach")

	# The stirrup is beside the barrel, a hand's breadth out and no more, and
	# the foot of the pose is in it.
	# The iron as it is drawn: the lowest and the outermost points of the body
	# mesh below the skirts on the left, which are the tread of the stirrup.
	var foot: Vector3 = SeatPose.POSES[MountKinds.HORSE]["foot"]
	var tread_y := 1e9
	var tread_x := 0.0
	var tread_count := 0
	for point: Vector3 in body.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
		# (Outside the barrel, which is 0.225 out at its widest.)
		if point.x < -0.235 and point.y < MountKinds.HORSE_SADDLE_Y - 0.23:
			tread_y = minf(tread_y, point.y)
			tread_x += point.x
			tread_count += 1
	_expect(tread_count > 0, "there is an iron drawn on the left")
	tread_x /= float(maxi(tread_count, 1))
	var iron := Vector3(tread_x, tread_y + 0.067 - MountKinds.HORSE_SADDLE_Y, foot.z)
	_expect(absf(foot.x - tread_x) < 0.05 and absf(foot.y - iron.y) < 0.03, "the foot of the pose is in the stirrup as drawn (%.2f, %.2f against %.2f, %.2f)" % [foot.x, foot.y, tread_x, iron.y])
	_expect(absf(tread_x) - barrel < 0.12 and absf(tread_x) > barrel, "the stirrup hangs %.2f m outside the barrel's widest" % (absf(tread_x) - barrel))

	for which in Character.KEYS.size():
		if not Character.is_rigged(which):
			continue
		var made := _seated(which, MountKinds.HORSE)
		var rig: Node3D = made[0]
		for side in 2:
			var mirror := -1.0 if side == 0 else 1.0
			var ankle := _in_rig(rig.find_child("Foot" + ("L" if side == 0 else "R"), true, false), rig)
			var stirrup := Vector3(iron.x * -mirror, iron.y, iron.z)
			_expect((ankle - stirrup).length() < 0.08, "horse, %s: foot %d is in the stirrup (%.2f m off)" % [Character.KEYS[which], side, (ankle - stirrup).length()])
			# Astride: the knee is not over the barrel's top but down its side.
			var knee := _in_rig(rig.find_child("Shin" + ("L" if side == 0 else "R"), true, false), rig)
			_expect(absf(knee.x) > 0.10 and knee.y < 0.12, "horse, %s: knee %d hangs at the horse's side (%.2f out, %.2f up)" % [Character.KEYS[which], side, absf(knee.x), knee.y])
			var hand := _in_rig(rig.find_child("Hand" + ("L" if side == 0 else "R"), true, false), rig)
			var rein := MountKinds.horse_rein_hand(mirror) - Vector3(0.0, MountKinds.HORSE_SADDLE_Y, 0.0)
			_expect((hand - rein).length() < 0.11, "horse, %s: hand %d holds its rein (%.2f m off)" % [Character.KEYS[which], side, (hand - rein).length()])
		(made[2] as Node3D).queue_free()

	_expect(_triangle_count(MountKinds.build_mesh(MountKinds.HORSE)) <= 2000, "the horse is %d triangles" % _triangle_count(MountKinds.build_mesh(MountKinds.HORSE)))

## A rider rises and falls with the trot, sits deep at the canter, in time with
## the stride, and the reins go with the hands.
func _check_the_rider_keeps_time_with_the_stride_and_the_reins_go_with_the_hands() -> void:
	print("the rider keeps time with the horse's stride, and the reins go with the hands")
	var trot := 4.5
	var canter := 9.0
	_expect(Mounts.rider_heave(PI * 0.5, 0.0) == 0.0 and Mounts.rider_heave(PI * 0.5, 1.0) == 0.0, "at a walk the rider does not move on the saddle")
	_expect(Mounts.rider_heave(PI * 0.5, trot) > 0.07 and absf(Mounts.rider_heave(PI * 1.5, trot)) < 0.001, "at a trot they rise on one beat (%.2f m) and sit on the next" % Mounts.rider_heave(PI * 0.5, trot))
	_expect(Mounts.rider_heave(PI * 0.5, canter) < -0.025 and absf(Mounts.rider_heave(0.0, canter)) < 0.001, "at a canter they sit deep as the saddle rises (%.3f m)" % Mounts.rider_heave(PI * 0.5, canter))
	var hips_at: Array[float] = []
	for phase: float in [PI * 0.5, PI * 1.5]:
		var made := _seated(1, MountKinds.HORSE, trot)
		var rig: Node3D = made[0]
		var motion: RigMotion = made[1]
		motion.stride = phase
		for _frame in 10:
			motion.step(1.0 / 60.0)
		hips_at.append((rig.find_child("Hips", true, false) as Node3D).position.y)
		(made[2] as Node3D).queue_free()
	_expect(hips_at[0] - hips_at[1] > 0.07, "the body in the rig is %.2f m higher on the rising beat than on the sitting one" % (hips_at[0] - hips_at[1]))
	# A visitor's horse is not moving here, so they keep a stride of their own.
	var kept := _seated(1, MountKinds.HORSE, trot)
	var own: RigMotion = kept[1]
	var before := own.stride_phase()
	own.step(0.1)
	_expect(own.stride_phase() != before, "a rider whose horse is not told keeps a stride from the pace")
	(kept[2] as Node3D).queue_free()

	# The reins end in the hands, and go with them.
	for side: float in [-1.0, 1.0]:
		var hand := MountKinds.horse_rein_hand(side)
		var grip: Vector3 = SeatPose.POSES[MountKinds.HORSE]["hand"]
		_expect(is_equal_approx(hand.y, MountKinds.HORSE_SADDLE_Y + grip.y) and is_equal_approx(absf(hand.x), absf(grip.x)), "the rein's end is where the hand is")
	var sway := Mounts.hand_sway(PI * 0.5 - 0.6, canter)
	_expect(sway.z > 0.02, "the hands give and take with the head (%.3f m)" % sway.z)
	var near := 1e9
	var wanted := MountKinds.horse_rein_hand(1.0) + sway
	for point: Vector3 in (MountKinds.horse_reins_mesh(0.0, sway) as ArrayMesh).surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
		near = minf(near, point.distance_to(wanted))
	_expect(near < 0.03, "the drawn rein follows the swaying hand (%.3f m)" % near)
	var still := 1e9
	for point: Vector3 in (MountKinds.horse_reins_mesh(0.0, Vector3.ZERO) as ArrayMesh).surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
		still = minf(still, point.distance_to(wanted))
	_expect(still > near + 0.01, "and not the hand at rest")

## Getting on and off a horse is a climb up beside it and a slide down its
## side, not a jump to the saddle.
func _check_getting_on_and_off_a_horse_is_a_climb_and_a_slide() -> void:
	print("getting on and off a horse is a climb and a slide")
	_expect(Mounts.boarding_lift(0.0, true) == 0.0 and is_equal_approx(Mounts.boarding_lift(1.0, true), 1.0), "the climb begins on the ground and ends in the saddle")
	_expect(is_equal_approx(Mounts.boarding_lift(1.0, false), 1.0) and absf(Mounts.boarding_lift(0.0, false)) < 0.001, "the slide begins in the saddle and ends on the ground")
	_expect(Mounts.boarding_out(0.0, true) == 0.0 and Mounts.boarding_out(0.3, true) > 0.8 * Mounts.BOARD_OUT and Mounts.boarding_out(1.0, true) == 0.0, "the child climbs from beside the horse and ends over it, with no step at either end")
	_expect(Mounts.boarding_out(1.0, false) == 0.0 and Mounts.boarding_out(0.5, false) > 0.8 * Mounts.BOARD_OUT and Mounts.boarding_out(0.0, false) == 0.0, "and slides down beside it and steps back to their own spot")
	var worst := 0.0
	var last := 0.0
	for step in 60:
		var lift := Mounts.boarding_lift(float(step + 1) / 60.0, true)
		worst = maxf(worst, absf(lift - last))
		last = lift
	_expect(worst < 0.12, "no frame of the climb lifts more than a tenth of the way (%.3f)" % worst)

	# The other child: begun on arrival, and finished.
	var visitors := Visitors.new()
	get_root().add_child(visitors)
	visitors.add(71, "Ada")
	var guest := visitors._visitors[71]["node"] as Node3D
	var rig := guest.get_node("Rig") as Node3D
	var full := MountKinds.eye_lift(MountKinds.HORSE)
	visitors.move(71, Vector3(3.0, 0.0, 3.0), 0.0, &"horse:1")
	_expect(rig.position.y < 0.3 * full, "somebody getting on a horse starts on the ground, not in the saddle (%.2f m)" % rig.position.y)
	visitors._process(0.45)
	_expect(rig.position.y > 0.2 * full and rig.position.y < 0.95 * full and absf(rig.position.x) > 0.01, "half way up the side of the horse (%.2f m up, %.2f out)" % [rig.position.y, rig.position.x])
	visitors._process(0.6)
	_expect(is_equal_approx(rig.position.y, full) and is_zero_approx(rig.position.x), "and in the saddle at the end")
	visitors.move(71, Vector3(3.0, 0.0, 3.0), 0.0)
	_expect(is_equal_approx(rig.position.y, full), "getting off begins in the saddle")
	visitors._process(0.45)
	_expect(rig.position.y > 0.05 and rig.position.y < 0.95 * full and absf(rig.position.x) > 0.01, "and slides down the side (%.2f m up, %.2f out)" % [rig.position.y, rig.position.x])
	visitors._process(0.6)
	_expect(is_zero_approx(rig.position.y) and is_zero_approx(rig.position.x), "to the ground")
	visitors.queue_free()

	# The horse comes to them and is put down by them, rather than appearing.
	var field := HeightField.new(20260903)
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	var camp := field.camp_centre()
	mounts.place(&"horse:0", camp + Vector3(3.0, 0.0, 0.0))
	mounts.mount(&"horse:0")
	mounts.carry(camp, 0.0)
	mounts._process(0.02)
	var horse_body := mounts.node_of(&"horse:0").get_node("Body") as Node3D
	var gap := Vector2(horse_body.position.x, horse_body.position.z).length()
	_expect(gap > 1.0, "the horse is drawn where it stood and comes to the child (%.2f m)" % gap)
	mounts._process(0.5)
	_expect(Vector2(horse_body.position.x, horse_body.position.z).length() < 0.01, "and has arrived")
	mounts.dismount(camp, 0.0)
	mounts._process(0.02)
	gap = Vector2(horse_body.position.x, horse_body.position.z).length()
	_expect(gap > 0.5, "got off, it is still under the child as they slide, and then steps aside (%.2f m)" % gap)
	mounts._process(0.5)
	_expect(Vector2(horse_body.position.x, horse_body.position.z).length() < 0.01, "to where it is left")
	mounts.queue_free()

## Two horses coming to rest at once both settle. A child's horse got off at a
## gallop is eased back to standing, and a guest getting off another horse in
## the same moment used to take over the one slot for that, leaving the child's
## horse with its legs cocked out behind it for good.
func _check_two_horses_coming_to_rest_both_settle() -> void:
	print("two horses coming to rest both settle")
	var field := HeightField.new(20260903)
	var mounts := Mounts.new(field)
	get_root().add_child(mounts)
	var camp := field.camp_centre()
	mounts.place(&"horse:0", camp + Vector3(3.0, 0.0, 0.0))
	mounts.place(&"horse:1", camp + Vector3(-12.0, 0.0, 0.0))
	mounts.ride_remote(&"horse:1", camp + Vector3(-20.0, 0.0, 0.0), 0.0)
	mounts.mount(&"horse:0")
	var leg := mounts.node_of(&"horse:0").get_node("Body/Leg2") as Node3D
	leg.rotation.x = 0.8
	mounts.dismount(camp, 0.0)
	mounts.release_remote(&"horse:1")
	for _i in 120:
		mounts._process(0.05)
	_expect(
		absf(leg.rotation.x) < 0.02,
		"the horse the child got off settles even when a guest's horse is put down too (%.2f rad)" % leg.rotation.x
	)
	mounts.queue_free()
## A guest's valley is the host's, adopted: those trees paid their rewards into
## the host's purse, so taking one down, by hand or with the axe, must not ask
## the guest's coins back for coins they were never given.
func _check_a_guest_is_not_charged_for_the_hosts_trees() -> void:
	print("a guest is not charged for the host's trees")
